#!/usr/bin/env bash
# specclaw-bf-clarify — deterministic engine for /specclaw:bf-clarify
#
# Turns the extraction signals scattered through .specclaw/analysis/*.md
# into a numbered, human-answerable question set (clarifications.md), then
# promotes answered questions into a clean, pinnable decision record
# (decisions.md).
#
# Three question families share one clarifications.md, one summary, one
# --resolve pipeline:
#   CQ-NNN — extracted from analysis docs, allocated per-repo in extraction
#            order (unchanged from before this families upgrade).
#   SQ-NNN — the standard bank (references/clarify-standard-questions.md):
#            IDs are FIXED by the bank file itself, not allocated per-repo —
#            SQ-001 always means "target platform," everywhere. Type/
#            Blocking/Options/Proposed default are bash-owned, spliced in
#            directly from the bank file; the agent only ever judges
#            Applicability, drafts a contextualized Finding, and checks for
#            a pre-existing answer (an *accepted* ADR or a decisions.md
#            entry).
#   UQ-NNN — per-repo custom questions (.specclaw/analysis/custom-
#            questions.md): allocated per-repo in file order, same
#            permanence rules as CQ. Ingestion is pure bash (tolerant
#            defaulting of sloppy authoring) — no agent involved.
#
# Unlike the plugin's other analysis bin scripts (which only gather facts
# for an agent to interpret and write), this script also owns rendering and
# archiving both output files. That's deliberate: the one hard invariant
# this command must never violate — stable, permanent IDs in all three
# families, never renumbered; existing Answer/Decided-by/Date fields never
# touched by a re-run; SQ Type/Blocking/Options/Proposed-default identical
# across every project — is safer enforced deterministically in bash than
# trusted to an LLM's judgment across repeated runs. The agent's job is
# narrower here: it only ever drafts NEW question content (extract mode),
# judges Applicability/pre-answered/contextualizes wording for NEW bank
# questions only (bank mode), or judges ADR-worthiness of already-answered
# questions (resolve mode) — it never edits, reorders, or retouches
# anything this script has already committed to disk.
#
# Bash + coreutils only (jq optional, used for output validation with a
# best-effort fallback — same tolerant pattern as every sibling script).
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# ─── Help ─────────────────────────────────────────────────────────────────────

usage() {
  cat <<'EOF'
Usage: specclaw-bf-clarify <subcommand> [options]

Subcommands:
  collect          <specclaw_dir> [--bank-only]
                   Extract-mode pre-agent step. Reports which of the five
                   known .specclaw/analysis/*.md documents are present
                   (exits non-zero if none are, UNLESS --bank-only — the
                   bank/custom layer needs no analysis docs at all). If
                   clarifications.md already exists, parses it for existing
                   CQ-NNN/SQ-NNN/UQ-NNN IDs (so new ones never collide or
                   renumber) and emits de-dup hint lists. Also reports the
                   bank file's path, which of its SQ-NNN ids are already
                   known to this project (rendered or marked Not
                   applicable — never re-evaluated) vs genuinely new, and
                   whether custom-questions.md/.specclaw/adr//decisions.md
                   are present. Also reports every OPEN entry in
                   pending-questions.md (if present) and
                   next_id_after_ingestion — the CQ-NNN the extraction
                   agent must start numbering from, since ingestion always
                   claims ids from next_id first (the two agents share the
                   CQ-NNN namespace). Outputs one JSON object to stdout.

  render           <specclaw_dir> <cq_draft|-> <bank_draft|-> [<ingest_draft|->]
                   Extract-mode post-agent step. <cq_draft> is a markdown
                   file of newly-drafted ### CQ-NNN blocks (pass "-" on a
                   --bank-only run — extraction did not run). <bank_draft>
                   is a markdown file of NOT-APPLICABLE: directives and
                   narrow ### SQ-NNN blocks (Finding/Why it
                   matters/Source/Answer only — Type/Blocking/Options/
                   Proposed default are spliced in from the bank file by
                   this step, never agent-authored) for the SQ-NNN ids
                   collect reported as new (pass "-" if the bank agent
                   found nothing new). <ingest_draft>, if passed, is a
                   markdown file of PROMOTED: PQ-NNN | CQ-NNN directive
                   lines followed by the promoted ### CQ-NNN blocks
                   themselves (merged through the identical path as
                   <cq_draft>'s own blocks) — after clarifications.md is
                   written, each PROMOTED: line surgically rewrites that
                   one pending-questions.md entry's Status line in place,
                   never a full rewrite of that file. Also ingests
                   custom-questions.md in-line (no agent involved) into
                   UQ-NNN blocks, tolerant
                   of missing Type/Blocking/Options, de-duplicated by each
                   question's original heading text. Archives the prior
                   clarifications.md (if any), merges everything, re-sorts
                   each family (blocking first, then by type), recomputes
                   the summary header, and writes
                   .specclaw/analysis/clarifications.md in section order
                   Standard (SQ) -> Custom (UQ) -> Extracted (CQ) -> Not
                   applicable. Deletes whichever draft file(s) were passed.

  resolve-collect  <specclaw_dir>
                   Resolve-mode pre-agent step. Requires clarifications.md
                   to exist. Splits questions from ALL THREE families into
                   answered/unanswered by whether **Answer:** is filled in.
                   Outputs one JSON object to stdout (IDs only — the agent
                   reads clarifications.md itself for content).

  resolve-render   <specclaw_dir> <adr_file>
                   Resolve-mode post-agent step. <adr_file> is a
                   pipe-delimited file (one line per answered question:
                   id|promote(yes/no)|suggested_adr_title|one_line_rationale)
                   produced by the agent's ADR-worthiness judgment, for
                   answered questions across ALL THREE families. Archives
                   the prior decisions.md (if any), mechanically
                   transcribes every answered question into a decision
                   entry tagged with its origin family (Extracted/Standard
                   bank/Custom (per-repo)), splices in the ADR-candidate
                   annotations, lists unanswered questions, and writes
                   .specclaw/analysis/decisions.md. Deletes <adr_file> on
                   success.

  options-pack-collect  <specclaw_dir>
                   Options-pack pre-agent step. Requires clarifications.md
                   to exist. Computes, from clarifications.md +
                   decisions.md, whether every question across all three
                   families is DECIDED / UNDECIDED / NOT-APPLICABLE, and
                   emits that verdict as structured JSON together with each
                   question's title/type/blocking flag and - when decided -
                   its answer, decider and date. THE AGENT NEVER RE-DERIVES
                   DECISION STATUS; this is the only place it is computed.
                   Zero undecided blocking questions is a clean state, not
                   an error. Outputs one JSON object to stdout.

  options-pack-render   <specclaw_dir> <draft|->
                   Options-pack post-agent step. <draft> is a markdown file
                   of one `### <ID>` block per UNDECIDED BLOCKING question
                   (pass "-" when the collector reported none - the agent
                   never ran). Recomputes status from scratch, refuses a
                   draft that misses an undecided blocking id or carries a
                   block for anything else, archives the prior
                   options-pack.md, and writes
                   .specclaw/analysis/options-pack.md: the client decision
                   paper. Bash owns the header counts, the Already Decided
                   and Not Applicable sections, and every "Client decision"
                   line; the agent owns only the options, trade-offs and
                   recommendation. Fully regenerated every run - there is no
                   hand-preserved zone. Deletes the draft on success.

Options:
  -h, --help    Show this help message
EOF
}

[[ "${1:-}" == "-h" || "${1:-}" == "--help" ]] && { usage; exit 0; }

die() { echo "ERROR: $*" >&2; exit 1; }
warn() { echo "WARN: $*" >&2; }

# ─── Generic JSON helpers (copied verbatim from specclaw-bf-analyze-codebase —
# no shared lib, per repo convention) ─────────────────────────────────────────

json_escape() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\r'/\\r}"
  s="${s//$'\t'/\\t}"
  printf '%s' "$s"
}

json_array_from_lines() {
  local item first=true out=""
  while IFS= read -r item; do
    [ -z "$item" ] && continue
    if $first; then first=false; else out="${out}, "; fi
    out="${out}\"$(json_escape "$item")\""
  done
  printf '%s' "$out"
}

# Validate (best-effort) and emit a JSON object to stdout — same tolerant
# pattern every collect-style script in this plugin already uses.
emit_json() {
  local output="$1"
  if command -v jq &>/dev/null; then
    if printf '%s' "$output" | jq . >/dev/null 2>&1; then
      printf '%s\n' "$output"
    else
      warn "JSON validation failed, outputting best-effort"
      printf '%s\n' "$output"
    fi
  else
    printf '%s\n' "$output"
  fi
}

# ─── Config reading (copied verbatim from specclaw-validate-change — no
# shared lib, per repo convention) ────────────────────────────────────────────

# Read a simple yaml value: yaml_val <file> <dotted.key>
# Handles top-level and one-level nested keys.
yaml_val() {
  local file="$1" key="$2"
  local section field
  if [[ "$key" == *.* ]]; then
    section="${key%%.*}"
    field="${key#*.}"
  else
    section=""
    field="$key"
  fi

  local in_section=false value=""
  while IFS= read -r line; do
    [[ "$line" =~ ^[[:space:]]*# ]] && continue
    [[ -z "${line// /}" ]] && continue

    if [[ -z "$section" ]]; then
      if [[ "$line" =~ ^${field}:[[:space:]]*(.*) ]]; then
        value="${BASH_REMATCH[1]}"
        break
      fi
    else
      if [[ "$line" =~ ^[a-zA-Z_] ]]; then
        if [[ "$line" =~ ^${section}: ]]; then
          in_section=true
        else
          in_section=false
        fi
        continue
      fi
      if $in_section; then
        if [[ "$line" =~ ^[[:space:]]+${field}:[[:space:]]*(.*) ]]; then
          value="${BASH_REMATCH[1]}"
          break
        fi
      fi
    fi
  done < "$file"

  # Strip inline `#` comments (must come BEFORE quote-stripping because
  # values like `name: "foo"   # comment` would otherwise carry the comment
  # into the result), then strip surrounding quotes.
  if [[ "$value" =~ ([[:space:]]+#) ]]; then
    value="${value%%"${BASH_REMATCH[1]}"*}"
  fi
  if [[ "$value" =~ [[:space:]]+$ ]]; then
    value="${value%"${BASH_REMATCH[0]}"}"
  fi
  value="${value#\"}"
  value="${value%\"}"
  value="${value#\'}"
  value="${value%\'}"
  echo "$value"
}

# Project title for doc headers: config.yaml's project.name, falling back
# to the project directory's basename (mirrors specclaw-ensure-init's own
# fallback) if config.yaml or the key is absent/empty.
project_title() {
  local project_root="$1"
  local config_file="$project_root/.specclaw/config.yaml"
  local name=""
  if [ -f "$config_file" ]; then
    name="$(yaml_val "$config_file" "project.name")"
  fi
  if [ -z "$name" ]; then
    name="$(basename "$project_root")"
  fi
  printf '%s' "$name"
}

# ─── Template substitution ────────────────────────────────────────────────────

# NOT "${content//"$token"/$value}" — bash's pattern-substitution
# replacement string treats a literal & as "insert the whole match" (a
# sed-style backreference, undocumented but real). Any drafted or preserved
# prose containing a bare & — real content does, e.g. "Meetings & Notes" —
# would silently get that & replaced with the token's own literal text.
# Split-and-concat via %%/# never treats $value as a replacement string, at
# the cost of only replacing the first occurrence (fine here — every
# template token appears exactly once).
substitute() {
  local content="$1" token="$2" value="$3"
  local prefix="${content%%"$token"*}"
  local suffix="${content#*"$token"}"
  printf '%s' "${prefix}${value}${suffix}"
}

# ─── Question-block parsing (clarifications.md / draft files) ───────────────
# A "block" is one `### <PFX>-NNN ...` section, split into its own file
# named "<outdir>/<PFX>-NNN.md" (full header line included) so every reader
# keys by filename/ID — never by position, since display order and ID are
# deliberately decoupled (see render's re-sort step). Generalized over all
# three prefixes (CQ/SQ/UQ) since they share one file and one --resolve
# sweep; a stray heading with some other two-letter prefix never matches.

split_pq_blocks() {
  # Same technique as split_question_blocks, keyed on "### PQ-NNN" headings
  # in .specclaw/analysis/pending-questions.md — a flat list of blocks with
  # no "## " sub-sectioning to worry about (unlike clarifications.md).
  local file="$1" outdir="$2"
  [ -f "$file" ] || return 0
  awk -v dir="$outdir" '
    /^### PQ-[0-9]+/ {
      match($0, /PQ-[0-9]+/)
      id = substr($0, RSTART, RLENGTH)
      outfile = dir "/" id ".md"
    }
    id != "" { print $0 >> outfile }
  ' "$file"
}

# Surgical single-line edit: rewrite exactly one PQ block's Status line in
# place, leaving every other byte of the file — every other entry, blank
# lines, ordering — untouched. This is pending-questions.md's ONE
# permitted in-place edit; everything else about that file is append-only.
promote_pq_status() {
  local pq_file="$1" pq_id="$2" cq_id="$3"
  local tmp; tmp="$(mktemp)"
  awk -v pq="$pq_id" -v cq="$cq_id" '
    BEGIN { in_target = 0 }
    /^### PQ-[0-9]+/ {
      if ($0 ~ ("^### " pq "([[:space:]]|$)")) { in_target = 1 } else { in_target = 0 }
    }
    in_target && /^- \*\*Status:\*\* OPEN[[:space:]]*$/ {
      print "- **Status:** PROMOTED → " cq
      next
    }
    { print }
  ' "$pq_file" > "$tmp"
  mv "$tmp" "$pq_file"
}

split_question_blocks() {
  # A block runs from its "### <PFX>-NNN" heading up to (not including) the
  # next such heading OR any "## " section heading, whichever comes first.
  # Without the second stop condition, the LAST block before a section
  # boundary (e.g. "## Not Applicable" after the final Extracted-questions
  # block) silently swallows everything after it, up to the next matching
  # "### " heading — this file has multiple "## " sections per render
  # (Standard/Custom/Extracted/Not Applicable), unlike a single flat list.
  local file="$1" outdir="$2"
  [ -f "$file" ] || return 0
  awk -v dir="$outdir" '
    /^### (CQ|SQ|UQ)-[0-9]+/ {
      match($0, /(CQ|SQ|UQ)-[0-9]+/)
      id = substr($0, RSTART, RLENGTH)
      outfile = dir "/" id ".md"
    }
    /^## / && $0 !~ /^### / { id = "" }
    id != "" { print $0 >> outfile }
  ' "$file"
}

block_id() {
  basename "$1" .md
}

block_title() {
  # NB: the separator alternation must NOT be a bracket expression ([—-]) —
  # under a byte-oriented locale/sed build (observed on this toolchain even
  # with LC_CTYPE=C.UTF-8), a POSIX bracket class treats a multi-byte UTF-8
  # character as its individual raw bytes, silently eating only the first
  # byte of the em dash and corrupting every title that follows it.
  head -1 "$1" | sed -E 's/^### (CQ|SQ|UQ)-[0-9]+[[:space:]]*(—|-)[[:space:]]*//'
}

# Extract a single-line "- **<Label>:** value" field. Used for Type, Source,
# Blocking (raw text), Decided by, Date — every field except Answer, which
# may span multiple lines.
block_single_field() {
  # `|| true` on the grep is required, not cosmetic: with `set -o pipefail`
  # (in effect for this whole script), a `grep -m1` that finds no match
  # exits 1, and that 1 propagates through the pipe to sed's otherwise-
  # successful exit — under `set -e`, `local x="$(...)"` then aborts the
  # entire script on the very first field a block happens not to have.
  # Every well-formed block always includes every label line (blank value,
  # never an omitted line — see templates/clarifications.md), but this
  # stays defensive against a malformed one instead of hard-failing.
  local file="$1" label="$2"
  { grep -m1 -- "^- \*\*${label}:\*\*" "$file" 2>/dev/null || true; } \
    | sed -E "s/^- \*\*${label}:\*\* *//" | sed -E 's/[[:space:]]+$//'
}

block_field_blocking_bool() {
  local line
  line="$(block_single_field "$1" "Blocking")"
  case "$line" in
    [Yy][Ee][Ss]*) echo "yes" ;;
    *) echo "no" ;;
  esac
}

# Answer text may span multiple lines, from right after "**Answer:**" up to
# (not including) the "**Decided by:**" line. Avoids a spurious leading
# blank line when the answer starts on the line after the tag rather than
# inline.
block_answer_text() {
  awk '
    /^- \*\*Answer:\*\*/ {
      sub(/^- \*\*Answer:\*\* */, "")
      if (length($0) > 0) { buf = $0; started = 1 } else { started = 0 }
      capturing = 1
      next
    }
    /^- \*\*Decided by:\*\*/ { capturing = 0 }
    capturing {
      if (started) { buf = buf "\n" $0 } else { buf = $0; started = 1 }
      next
    }
    END { print buf }
  ' "$1"
}

block_is_answered() {
  local txt
  txt="$(block_answer_text "$1" | tr -d '[:space:]')"
  [ -n "$txt" ]
}

# Family for an ID prefix — used by --resolve's decision tagging.
id_family() {
  case "$1" in
    SQ-*) echo "Standard bank" ;;
    UQ-*) echo "Custom (per-repo)" ;;
    *) echo "Extracted" ;;
  esac
}

# Taxonomy display order (Output ordering rule). Unknown/mistyped types
# sort last rather than being silently dropped or guessed into a bucket.
type_rank() {
  case "$1" in
    DECISION) echo 1 ;;
    DATA) echo 2 ;;
    SCOPE) echo 3 ;;
    DEFECT) echo 4 ;;
    MECHANICAL) echo 5 ;;
    TARGET-GAP) echo 6 ;;
    CONFLICT) echo 7 ;;
    *) echo 99 ;;
  esac
}

# ─── Bank-entry parsing (references/clarify-standard-questions.md) ─────────
# A bank entry is one `## SQ-NNN ...` section — double-hash, distinct from
# clarifications.md's `### CQ|SQ|UQ-NNN` triple-hash, so the two file types
# are never confused even though both mention SQ-NNN.

BANK_FILE="$SCRIPT_DIR/../references/clarify-standard-questions.md"
CUSTOM_QUESTIONS_TEMPLATE="$SCRIPT_DIR/../templates/custom-questions.md"

# The bank's own declared version, read from the file rather than hardcoded.
# A rendered question records which bank version it came from in its Source
# field; hardcoding that string meant every question minted after the bank grew
# still claimed to come from v1, which is precisely the kind of quietly-wrong
# provenance a Source field exists to prevent.
bank_version() {
  local v=""
  [ -f "$BANK_FILE" ] && v="$({ grep -m1 -- '^\*\*Bank version:\*\*' "$BANK_FILE" \
    | sed -E 's/^\*\*Bank version:\*\* *//' | sed -E 's/[[:space:]]+$//'; } || true)"
  printf '%s' "${v:-unknown}"
}

split_bank_entries() {
  local file="$1" outdir="$2"
  [ -f "$file" ] || return 0
  awk -v dir="$outdir" '
    /^## SQ-[0-9]+/ {
      match($0, /SQ-[0-9]+/)
      id = substr($0, RSTART, RLENGTH)
      outfile = dir "/" id ".md"
    }
    id != "" { print $0 >> outfile }
  ' "$file"
}

# Extract a possibly-multi-line "- **<Label>:** ..." field: from the label
# line (prefix stripped) up to (not including) the next "- **" field or the
# next "## " heading. Used for Question/Options/Proposed default/
# Applicability in a bank entry.
bank_field_multiline() {
  # Same "started" flag technique as block_answer_text — a field whose
  # content starts on the line AFTER its label (e.g. "- **Options:**"
  # followed by a numbered list on the next line, rather than inline text)
  # must not get a spurious leading blank line in the captured output.
  local file="$1" label="$2"
  awk -v label="$label" '
    BEGIN { pat = "^- \\*\\*" label ":\\*\\*" }
    $0 ~ pat {
      sub(pat " *", "")
      if (length($0) > 0) { buf = $0; started = 1 } else { started = 0 }
      capturing = 1
      next
    }
    capturing && /^- \*\*/ { capturing = 0 }
    capturing && /^## / { capturing = 0 }
    capturing {
      if (started) { buf = buf "\n" $0 } else { buf = $0; started = 1 }
      next
    }
    END { print buf }
  ' "$file"
}

# ─── Known analysis documents clarify sweeps ─────────────────────────────────

DOC_NAMES=(codebase-report.md architecture.md domain-model.md functional-spec.md rebuild-backlog.md)

# ─── Subcommand: collect (extract mode, pre-agent) ───────────────────────────

cmd_collect() {
  local specclaw_dir="$1" bank_only_flag="${2:-}"
  local bank_only=false
  [ "$bank_only_flag" = "--bank-only" ] && bank_only=true

  [ -d "$specclaw_dir" ] || die "specclaw directory not found: $specclaw_dir"

  local specclaw_dir_abs project_root analysis_dir
  specclaw_dir_abs="$(cd "$specclaw_dir" && pwd)"
  project_root="$(cd "$specclaw_dir_abs/.." && pwd)"
  analysis_dir="$specclaw_dir_abs/analysis"

  local -a docs_present=() docs_missing=()
  local d
  for d in "${DOC_NAMES[@]}"; do
    if [ -f "$analysis_dir/$d" ]; then
      docs_present+=("$d")
    else
      docs_missing+=("$d")
    fi
  done

  # Extraction needs at least one analysis document; the bank/custom layer
  # needs none of them (it may run right after /specclaw:bf-analyze, before
  # /specclaw:bf-architecture or /specclaw:bf-domain have ever run).
  if ! $bank_only && [ "${#docs_present[@]}" -eq 0 ]; then
    die "No analysis documents found in .specclaw/analysis/ — run /specclaw:bf-analyze, /specclaw:bf-architecture, and/or /specclaw:bf-domain first (rebuild-backlog.md from /specclaw:bf-rebuild-plan is swept too, if present). Use --bank-only to ask the standard/custom questions without any analysis documents."
  fi

  local docs_present_json docs_missing_json
  docs_present_json="$(printf '%s\n' "${docs_present[@]}" | json_array_from_lines)"
  docs_missing_json="$(printf '%s\n' "${docs_missing[@]}" | json_array_from_lines)"

  local clar_file="$analysis_dir/clarifications.md"
  local clar_exists=false
  local next_num=1
  local existing_json="" first=true

  # Known SQ ids: rendered as a question OR listed in Not applicable —
  # either way, never re-evaluated by the agent again.
  local -A known_sq=()
  local known_sq_json="" ksfirst=true

  if [ -f "$clar_file" ]; then
    clar_exists=true
    local workdir; workdir="$(mktemp -d)"
    split_question_blocks "$clar_file" "$workdir"
    local f id title source num
    for f in "$workdir"/CQ-*.md; do
      [ -f "$f" ] || continue
      id="$(block_id "$f")"
      num="${id#CQ-}"
      num=$((10#$num))
      [ "$num" -ge "$next_num" ] && next_num=$((num + 1))
      title="$(block_title "$f")"
      source="$(block_single_field "$f" "Source")"
      if $first; then first=false; else existing_json="${existing_json},"; fi
      existing_json="${existing_json}
    {\"id\": \"$(json_escape "$id")\", \"title\": \"$(json_escape "$title")\", \"source\": \"$(json_escape "$source")\"}"
    done
    for f in "$workdir"/SQ-*.md; do
      [ -f "$f" ] || continue
      known_sq["$(block_id "$f")"]=1
    done
    rm -rf "$workdir"
    # Not-applicable SQ ids are also "known" — one-liners keyed "- **SQ-NNN**".
    local naid
    while IFS= read -r naid; do
      [ -z "$naid" ] && continue
      known_sq["$naid"]=1
    done < <(grep -oE '^- \*\*SQ-[0-9]+\*\*' "$clar_file" 2>/dev/null | grep -oE 'SQ-[0-9]+' || true)
  fi

  local next_id
  next_id="$(printf 'CQ-%03d' "$next_num")"

  # ── Pending-questions.md OPEN entries — the ingestion agent's own input,
  # and the offset the extraction agent's own next_id must start after (the
  # two agents share the CQ-NNN namespace; ingestion always claims ids
  # first — see skills/bf-clarify/SKILL.md's Mode A step order). ───────────
  local pq_file="$analysis_dir/pending-questions.md"
  local pq_present=false
  local pq_open_json="" pqfirst=true pq_open_count=0
  if [ -f "$pq_file" ]; then
    pq_present=true
    local pqworkdir; pqworkdir="$(mktemp -d)"
    split_pq_blocks "$pq_file" "$pqworkdir"
    local pf pqid pqtitle pqstatus pqsource pqtrigger pqblocks pqevidence pqcnd pqcand pqdefault
    for pf in "$pqworkdir"/PQ-*.md; do
      [ -f "$pf" ] || continue
      pqstatus="$(block_single_field "$pf" "Status")"
      case "$pqstatus" in
        OPEN) ;;
        *) continue ;;
      esac
      pqid="$(block_id "$pf")"
      pqtitle="$(block_title "$pf")"
      pqsource="$(bank_field_multiline "$pf" "Source")"
      pqtrigger="$(bank_field_multiline "$pf" "Trigger")"
      pqblocks="$(bank_field_multiline "$pf" "Blocks")"
      pqevidence="$(bank_field_multiline "$pf" "Evidence found")"
      pqcnd="$(bank_field_multiline "$pf" "Could not determine")"
      pqcand="$(bank_field_multiline "$pf" "Candidates considered")"
      pqdefault="$(bank_field_multiline "$pf" "Proposed default (UNCONFIRMED)")"
      pq_open_count=$((pq_open_count + 1))
      if $pqfirst; then pqfirst=false; else pq_open_json="${pq_open_json},"; fi
      pq_open_json="${pq_open_json}
    {
      \"pq_id\": \"$(json_escape "$pqid")\",
      \"title\": \"$(json_escape "$pqtitle")\",
      \"source\": \"$(json_escape "$pqsource")\",
      \"trigger\": \"$(json_escape "$pqtrigger")\",
      \"blocks\": \"$(json_escape "$pqblocks")\",
      \"evidence_found\": \"$(json_escape "$pqevidence")\",
      \"could_not_determine\": \"$(json_escape "$pqcnd")\",
      \"candidates_considered\": \"$(json_escape "$pqcand")\",
      \"proposed_default\": \"$(json_escape "$pqdefault")\"
    }"
    done
    rm -rf "$pqworkdir"
  fi
  local next_id_after_ingestion
  next_id_after_ingestion="$(printf 'CQ-%03d' "$((next_num + pq_open_count))")"

  # Bank roster diff: every SQ-NNN currently defined in the bank file,
  # minus whatever this project already knows about.
  local bank_path_abs="" new_sq_json="" nsfirst=true
  if [ -f "$BANK_FILE" ]; then
    bank_path_abs="$(cd "$(dirname "$BANK_FILE")" && pwd)/$(basename "$BANK_FILE")"
    local bid
    while IFS= read -r bid; do
      [ -z "$bid" ] && continue
      if [ -z "${known_sq[$bid]:-}" ]; then
        if $nsfirst; then nsfirst=false; else new_sq_json="${new_sq_json}, "; fi
        new_sq_json="${new_sq_json}\"$(json_escape "$bid")\""
      fi
      if $ksfirst; then ksfirst=false; else known_sq_json="${known_sq_json}, "; fi
      known_sq_json="${known_sq_json}\"$(json_escape "$bid")\""
    done < <(grep -oE '^## SQ-[0-9]+' "$BANK_FILE" | grep -oE 'SQ-[0-9]+')
  else
    warn "standard question bank not found at $BANK_FILE — the SQ layer will be skipped this run"
  fi

  local custom_path="$analysis_dir/custom-questions.md"
  local custom_present=false
  [ -f "$custom_path" ] && custom_present=true

  local adr_dir="$specclaw_dir_abs/adr"
  local adr_present=false
  [ -d "$adr_dir" ] && [ -n "$(find "$adr_dir" -maxdepth 1 -name '*.md' 2>/dev/null)" ] && adr_present=true

  local decisions_path="$analysis_dir/decisions.md"
  local decisions_present=false
  [ -f "$decisions_path" ] && decisions_present=true

  local output
  output=$(cat <<ENDJSON
{
  "project_root": "$(json_escape "$project_root")",
  "analysis_dir": ".specclaw/analysis",
  "bank_only": ${bank_only},
  "docs_present": [${docs_present_json}
  ],
  "docs_missing": [${docs_missing_json}
  ],
  "clarifications_exists": ${clar_exists},
  "next_id": "$(json_escape "$next_id")",
  "existing_questions": [${existing_json}
  ],
  "pending_questions": {
    "present": ${pq_present},
    "path": ".specclaw/analysis/pending-questions.md",
    "open_count": ${pq_open_count},
    "open": [${pq_open_json}
    ]
  },
  "next_id_after_ingestion": "$(json_escape "$next_id_after_ingestion")",
  "bank_path": "$(json_escape "$bank_path_abs")",
  "known_sq_ids": [${known_sq_json}],
  "new_sq_ids": [${new_sq_json}],
  "custom_questions": {"present": ${custom_present}, "path": ".specclaw/analysis/custom-questions.md"},
  "adr_dir": {"present": ${adr_present}, "path": ".specclaw/adr"},
  "decisions_md": {"present": ${decisions_present}, "path": ".specclaw/analysis/decisions.md"}
}
ENDJSON
)
  emit_json "$output"
}

# ─── UQ ingestion (custom-questions.md -> UQ-NNN blocks, pure bash) ─────────
# Tolerant of sloppy authoring: a "## " heading starts a question; a
# missing Type/Blocking/Options/Proposed-default line defaults rather than
# errors. De-duplicated against already-ingested questions by exact
# original-heading-text, recorded verbatim in each UQ's Source field —
# editing an already-ingested heading's wording later does NOT retroactively
# rewrite the rendered UQ; it reads as a new question with a new ID.

# Tolerant single-line field lookup: accepts both "Label: value" and
# "- **Label:** value" so a lightly-formatted custom-questions.md still
# parses cleanly.
custom_field() {
  # `|| true` required — see block_single_field's comment; custom-
  # questions.md entries routinely omit Type/Blocking/Proposed default
  # lines entirely (that's the whole point of tolerating sloppy authoring),
  # so a no-match here is the expected common case, not a malformed file.
  local file="$1" label="$2"
  { grep -m1 -iE "^(- )?(\*\*)?${label}:(\*\*)? " "$file" 2>/dev/null || true; } \
    | sed -E "s/^(- )?(\*\*)?${label}:(\*\*)? *//I" | sed -E 's/[[:space:]]+$//'
}

custom_options_block() {
  local file="$1"
  awk '
    /^(- )?(\*\*)?[Oo]ptions:(\*\*)?/ { capturing = 1; next }
    capturing && /^-[[:space:]]/ { print; next }
    capturing { capturing = 0 }
  ' "$file"
}

render_uq_from_custom_questions() {
  # Args: custom_questions_file clar_file(may not exist) -> prints
  # newly-ingested ### UQ-NNN blocks (blank-line separated) to stdout, or
  # nothing if none are new. Numbering continues a project-wide UQ counter
  # (own sequence, independent of CQ/SQ, same permanence rules as CQ).
  local custom_file="$1" clar_file="$2"
  [ -f "$custom_file" ] || return 0

  # Existing UQ ids + their originally-ingested heading text (from Source).
  local -A existing_uq_headings=()
  local next_num=1
  if [ -f "$clar_file" ]; then
    local workdir; workdir="$(mktemp -d)"
    split_question_blocks "$clar_file" "$workdir"
    local f id num src heading
    for f in "$workdir"/UQ-*.md; do
      [ -f "$f" ] || continue
      id="$(block_id "$f")"
      num="${id#UQ-}"; num=$((10#$num))
      [ "$num" -ge "$next_num" ] && next_num=$((num + 1))
      src="$(block_single_field "$f" "Source")"
      heading="$(printf '%s' "$src" | sed -E 's/^.*custom-questions\.md — "(.*)"$/\1/')"
      existing_uq_headings["$heading"]=1
    done
    rm -rf "$workdir"
  fi

  local workdir2; workdir2="$(mktemp -d)"
  awk -v dir="$workdir2" '
    /^## / {
      n++
      outfile = dir "/q" n ".md"
    }
    n > 0 { print $0 >> outfile }
  ' "$custom_file"

  shopt -s nullglob
  local -a qfiles=("$workdir2"/q*.md)
  shopt -u nullglob
  # Stable numeric order (q1, q2, ... q10, not q1, q10, q2).
  mapfile -t qfiles < <(printf '%s\n' "${qfiles[@]}" | sed -E 's/.*\/q([0-9]+)\.md/\1 &/' | sort -n | cut -d' ' -f2-)

  local out="" first=true
  local f heading qtype blocking options default id
  for f in "${qfiles[@]}"; do
    [ -f "$f" ] || continue
    heading="$(head -1 "$f" | sed -E 's/^## *//' | sed -E 's/[[:space:]]+$//')"
    [ -z "$heading" ] && continue
    if [ -n "${existing_uq_headings[$heading]:-}" ]; then
      continue
    fi

    qtype="$(custom_field "$f" "Type")"
    [ -z "$qtype" ] && qtype="DECISION"
    qtype="$(printf '%s' "$qtype" | tr '[:lower:]' '[:upper:]')"

    local blocking_raw
    blocking_raw="$(custom_field "$f" "Blocking")"
    case "$blocking_raw" in
      [Yy][Ee][Ss]*) blocking="yes — author-flagged as blocking" ;;
      *) blocking="no" ;;
    esac

    options="$(custom_options_block "$f")"
    if [ -z "$options" ]; then
      options="  (not specified by the author — describe options when answering)"
    else
      options="$(printf '%s\n' "$options" | sed -E 's/^-[[:space:]]*/  - /')"
    fi

    default="$(custom_field "$f" "Proposed default")"
    [ -z "$default" ] && default="$(custom_field "$f" "Default")"
    [ -z "$default" ] && default="unknown — not specified by the author"

    id="$(printf 'UQ-%03d' "$next_num")"
    next_num=$((next_num + 1))

    local entry
    entry="$(cat <<ENTRY
### ${id} — ${heading}

- **Type:** ${qtype}
- **Blocking:** ${blocking}
- **Source:** .specclaw/analysis/custom-questions.md — "${heading}"
- **Finding:** Author-defined question from custom-questions.md; not derived from analysis-doc extraction.
- **Why it matters:** Not stated by the author — the repo's maintainer flagged this as needing a decision.
- **Options:**
${options}
- **Proposed default:** ${default}
- **Answer:**
- **Decided by:**
- **Date:**
ENTRY
)"
    if $first; then first=false; else out="${out}

"; fi
    out="${out}${entry}"
  done
  rm -rf "$workdir2"

  # `[ -n "$out" ] && printf ...` as the final statement would make this
  # function's own return status the (non-zero) status of a false `[ -n ]`
  # test whenever $out is empty — the common, expected case when nothing is
  # new. Called as `x="$(this_function ...)"` under `set -e`, that non-zero
  # status silently kills the whole script with no error message at all.
  # An explicit `return 0` after the conditional print avoids it.
  [ -n "$out" ] && printf '%s\n' "$out"
  return 0
}

# ─── SQ assembly (bank-fixed fields + agent-drafted Finding/Answer) ─────────

# Assemble one final SQ-NNN block: bank entry (Type/Blocking/Options/
# Proposed default — always bash's) + the agent's draft block for this id
# (Finding/Why it matters/Source/Answer/Decided by/Date), if the agent
# produced one. If the agent didn't (defensive fallback — should not
# normally happen), fall back to the bank's own generic Question text as
# the Finding, flagged as uncontextualized, and leave Answer empty.
assemble_sq_block() {
  local bank_entry_file="$1" agent_block_file="${2:-}"
  local id title
  id="$(block_id "$bank_entry_file")"
  title="$(head -1 "$bank_entry_file" | sed -E 's/^## [A-Z]+-[0-9]+[[:space:]]*(—|-)[[:space:]]*//')"

  local qtype blocking options default
  qtype="$(block_single_field "$bank_entry_file" "Type")"
  blocking="$(block_field_blocking_bool "$bank_entry_file")"
  options="$(bank_field_multiline "$bank_entry_file" "Options")"
  default="$(bank_field_multiline "$bank_entry_file" "Proposed default")"

  local finding why_it_matters source answer decided_by decided_date
  if [ -n "$agent_block_file" ] && [ -f "$agent_block_file" ]; then
    # Finding/Why it matters may wrap onto multiple lines — block_single_field
    # would silently truncate at the first line, so use the multi-line-
    # capable extractor here (it works on any "- **Label:**"-shaped file,
    # not just bank entries).
    finding="$(bank_field_multiline "$agent_block_file" "Finding")"
    why_it_matters="$(bank_field_multiline "$agent_block_file" "Why it matters")"
    source="$(block_single_field "$agent_block_file" "Source")"
    answer="$(block_answer_text "$agent_block_file")"
    decided_by="$(block_single_field "$agent_block_file" "Decided by")"
    decided_date="$(block_single_field "$agent_block_file" "Date")"
  fi
  [ -z "${finding:-}" ] && finding="(agent did not contextualize this question — showing the standard bank's generic wording as a fallback) $(bank_field_multiline "$bank_entry_file" "Question")"
  [ -z "${why_it_matters:-}" ] && why_it_matters="See the standard bank's applicability rationale — this question was judged applicable to this repo."
  [ -z "${source:-}" ] && source="Standard bank v$(bank_version) (references/clarify-standard-questions.md)"

  cat <<BLOCK
### ${id} — ${title}

- **Type:** ${qtype}
- **Blocking:** ${blocking}
- **Source:** ${source}
- **Finding:** ${finding}
- **Why it matters:** ${why_it_matters}
- **Options:**
${options}
- **Proposed default:** ${default}
- **Answer:** ${answer:-}
- **Decided by:** ${decided_by:-}
- **Date:** ${decided_date:-}
BLOCK
}

# ─── Subcommand: render (extract mode, post-agent) ───────────────────────────

cmd_render() {
  local specclaw_dir="$1" cq_draft="$2" bank_draft="$3" ingest_draft="${4:-}"
  [ -d "$specclaw_dir" ] || die "specclaw directory not found: $specclaw_dir"
  [ "$cq_draft" = "-" ] || [ -f "$cq_draft" ] || die "CQ draft file not found: $cq_draft"
  [ "$bank_draft" = "-" ] || [ -f "$bank_draft" ] || die "bank draft file not found: $bank_draft"
  [ -z "$ingest_draft" ] || [ "$ingest_draft" = "-" ] || [ -f "$ingest_draft" ] || die "ingest draft file not found: $ingest_draft"

  local specclaw_dir_abs project_root analysis_dir archive_dir
  specclaw_dir_abs="$(cd "$specclaw_dir" && pwd)"
  project_root="$(cd "$specclaw_dir_abs/.." && pwd)"
  analysis_dir="$specclaw_dir_abs/analysis"
  archive_dir="$analysis_dir/archive"

  local clar_file="$analysis_dir/clarifications.md"
  local custom_file="$analysis_dir/custom-questions.md"
  local pq_file="$analysis_dir/pending-questions.md"

  # ── PQ ingestion directives — parsed BEFORE the CQ block split below, so
  # the PROMOTED: lines never get mistaken for prose inside a block. ──────
  local -a promoted_pq=() promoted_cq=()
  if [ -n "$ingest_draft" ] && [ "$ingest_draft" != "-" ]; then
    local pline ppq pcq
    while IFS= read -r pline; do
      [ -z "$pline" ] && continue
      ppq="$(printf '%s' "$pline" | sed -E 's/^PROMOTED:[[:space:]]*//' | cut -d'|' -f1 | sed -E 's/^[[:space:]]+|[[:space:]]+$//g')"
      pcq="$(printf '%s' "$pline" | cut -d'|' -f2 | sed -E 's/^[[:space:]]+|[[:space:]]+$//g')"
      [ -z "$ppq" ] || [ -z "$pcq" ] && continue
      promoted_pq+=("$ppq")
      promoted_cq+=("$pcq")
    done < <(grep -E '^PROMOTED:' "$ingest_draft" 2>/dev/null || true)
  fi

  local workdir; workdir="$(mktemp -d)"
  mkdir -p "$workdir/existing" "$workdir/new" "$workdir/merged" "$workdir/bank" "$workdir/bank_new"

  [ -f "$clar_file" ] && split_question_blocks "$clar_file" "$workdir/existing"
  [ "$cq_draft" != "-" ] && split_question_blocks "$cq_draft" "$workdir/new"
  # Ingestion's promoted CQ blocks merge through the exact same "new CQ"
  # path as extraction's — same shape (### CQ-NNN — ...), same collision
  # handling, same sort/render treatment. PROMOTED: directive lines above
  # are stripped by construction (split_question_blocks only ever captures
  # lines from a "### CQ-NNN" heading onward, never a bare directive line
  # sitting before the first heading).
  if [ -n "$ingest_draft" ] && [ "$ingest_draft" != "-" ]; then
    split_question_blocks "$ingest_draft" "$workdir/new"
  fi

  # ── CQ + preserved-SQ + preserved-UQ merge (existing behaviour, unchanged
  # for CQ; SQ/UQ blocks already on disk are copied verbatim exactly the
  # same way — they were fully assembled by a prior render, so there is
  # nothing left for this run to recompute) ─────────────────────────────────
  local f
  for f in "$workdir/existing"/*.md; do
    [ -f "$f" ] || continue
    cp "$f" "$workdir/merged/"
  done
  for f in "$workdir/new"/CQ-*.md; do
    [ -f "$f" ] || continue
    local fname; fname="$(basename "$f")"
    if [ -f "$workdir/existing/$fname" ]; then
      warn "draft question $(block_id "$f") collides with an existing ID — keeping the existing block, discarding the draft's duplicate (IDs must never be reused)."
      continue
    fi
    cp "$f" "$workdir/merged/$fname"
  done

  # ── Not-applicable SQ list: preserved verbatim from the existing file,
  # plus any new NOT-APPLICABLE: directives from this run's bank draft. ────
  local not_applicable_body=""
  if [ -f "$clar_file" ]; then
    not_applicable_body="$(awk '/^## Not Applicable/{flag=1;next}/^## /{flag=0}flag' "$clar_file" | sed '/./,$!d' | sed -E '/^See the standard bank/d')"
  fi
  if [ "$bank_draft" != "-" ]; then
    local naline
    while IFS= read -r naline; do
      [ -z "$naline" ] && continue
      local naid nareason
      naid="$(printf '%s' "$naline" | sed -E 's/^NOT-APPLICABLE:[[:space:]]*//' | cut -d'|' -f1 | sed -E 's/^[[:space:]]+|[[:space:]]+$//g')"
      nareason="$(printf '%s' "$naline" | cut -d'|' -f2- | sed -E 's/^[[:space:]]+|[[:space:]]+$//g')"
      [ -z "$naid" ] && continue
      not_applicable_body="${not_applicable_body}
- **${naid}** — ${nareason}"
    done < <(grep -E '^NOT-APPLICABLE:' "$bank_draft" 2>/dev/null || true)
  fi
  not_applicable_body="$(printf '%s' "$not_applicable_body" | sed '/./,$!d')"
  [ -z "$not_applicable_body" ] && not_applicable_body="None."

  # ── New SQ blocks: assemble bank-fixed fields + agent draft, only for
  # ids the bank defines that aren't already known (rendered or N/A'd). ────
  if [ -f "$BANK_FILE" ]; then
    split_bank_entries "$BANK_FILE" "$workdir/bank"
  fi
  [ "$bank_draft" != "-" ] && split_question_blocks "$bank_draft" "$workdir/bank_new"

  local -A already_known_sq=()
  local bf
  for bf in "$workdir/existing"/SQ-*.md; do
    [ -f "$bf" ] || continue
    already_known_sq["$(block_id "$bf")"]=1
  done
  local naid2
  while IFS= read -r naid2; do
    [ -z "$naid2" ] && continue
    already_known_sq["$naid2"]=1
  done < <(printf '%s\n' "$not_applicable_body" | grep -oE 'SQ-[0-9]+' || true)

  for bf in "$workdir/bank"/SQ-*.md; do
    [ -f "$bf" ] || continue
    local bid; bid="$(block_id "$bf")"
    [ -n "${already_known_sq[$bid]:-}" ] && continue
    # This bank id is genuinely new to this project. Did the agent produce
    # a NOT-APPLICABLE directive for it instead of a block? Already handled
    # above via not_applicable_body. Only assemble a block if the agent
    # actually drafted one (or fall back gracefully if it drafted neither —
    # defensive, should not happen if the agent followed its instructions).
    if printf '%s' "$not_applicable_body" | grep -q "$bid"; then
      continue
    fi
    local agent_block="$workdir/bank_new/${bid}.md"
    [ -f "$agent_block" ] || agent_block=""
    assemble_sq_block "$bf" "$agent_block" > "$workdir/merged/${bid}.md"
  done

  # ── Scaffold custom-questions.md on first run only ───────────────────────
  # Verbatim copy of the template, and ONLY if nothing exists at that path
  # yet. Once anything exists there — even empty, even malformed — it is
  # user-authored from that point on: never overwritten, re-rendered, or
  # otherwise touched again, no matter how it got there. Scaffolding and
  # ingestion (below) are independent steps — a freshly-scaffolded file's
  # own example questions are ingested the same as any other content.
  local custom_scaffolded=false
  if [ ! -f "$custom_file" ] && [ -f "$CUSTOM_QUESTIONS_TEMPLATE" ]; then
    cp "$CUSTOM_QUESTIONS_TEMPLATE" "$custom_file"
    custom_scaffolded=true
  fi

  # ── New UQ blocks: pure bash ingestion, no agent involved ────────────────
  # NB: split_question_blocks gates on `[ -f "$file" ]` — a process
  # substitution `<(...)` is a named pipe, not a regular file, so it fails
  # that test and the function silently no-ops. Write to a real temp file.
  local uq_new
  uq_new="$(render_uq_from_custom_questions "$custom_file" "$clar_file")"
  if [ -n "$uq_new" ]; then
    local uq_tmp; uq_tmp="$(mktemp)"
    printf '%s\n' "$uq_new" > "$uq_tmp"
    split_question_blocks "$uq_tmp" "$workdir/merged"
    rm -f "$uq_tmp"
  fi

  shopt -s nullglob
  local -a merged_files=("$workdir/merged"/*.md)
  shopt -u nullglob

  if [ "${#merged_files[@]}" -eq 0 ] && [ "$not_applicable_body" = "None." ]; then
    rm -rf "$workdir"
    die "no question blocks to render (no drafts, no prior clarifications.md, and nothing in custom-questions.md)."
  fi

  # Archive prior file now that its content is safely preserved in
  # $workdir/existing / $workdir/merged.
  if [ -f "$clar_file" ]; then
    mkdir -p "$archive_dir"
    mv "$clar_file" "$archive_dir/$(date +%Y-%m-%d-%H%M%S)-clarifications.md"
  fi

  # ── Sort each family independently (blocking-first, then type-rank, then
  # ID) and compute the combined summary. ─────────────────────────────────
  local sortlist; sortlist="$(mktemp)"
  local total=0 blocking_count=0 unanswered_count=0
  local cq_total=0 sq_total=0 uq_total=0
  declare -A type_counts=(
    [DECISION]=0 [DATA]=0 [SCOPE]=0 [DEFECT]=0 [MECHANICAL]=0 [TARGET-GAP]=0 [CONFLICT]=0
  )

  local id
  for f in "${merged_files[@]}"; do
    id="$(block_id "$f")"
    local qtype blocking sortkey trank brank family
    qtype="$(block_single_field "$f" "Type")"
    blocking="$(block_field_blocking_bool "$f")"
    family="$(id_family "$id")"

    if [[ -v type_counts[$qtype] ]]; then
      type_counts[$qtype]=$((type_counts[$qtype] + 1))
    else
      warn "unknown Type '$qtype' in question $id — expected one of: DECISION, DATA, SCOPE, DEFECT, MECHANICAL, TARGET-GAP, CONFLICT"
    fi
    trank="$(type_rank "$qtype")"

    total=$((total + 1))
    case "$id" in
      CQ-*) cq_total=$((cq_total + 1)) ;;
      SQ-*) sq_total=$((sq_total + 1)) ;;
      UQ-*) uq_total=$((uq_total + 1)) ;;
    esac
    if [ "$blocking" = "yes" ]; then
      blocking_count=$((blocking_count + 1))
      brank=0
    else
      brank=1
    fi
    block_is_answered "$f" || unanswered_count=$((unanswered_count + 1))

    # Family rank keeps SQ/UQ/CQ from interleaving even at the same
    # blocking/type rank — each family renders as its own section, but one
    # sortlist keeps the code path uniform.
    local frank
    case "$id" in SQ-*) frank=0 ;; UQ-*) frank=1 ;; *) frank=2 ;; esac

    sortkey="$(printf '%d-%d-%02d-%s' "$frank" "$brank" "$trank" "$id")"
    printf '%s\t%s\n' "$sortkey" "$f" >> "$sortlist"
  done

  render_section() {
    local want_frank="$1"
    local body="" bfirst=true blockfile sortkey frank rest
    while IFS=$'\t' read -r sortkey blockfile; do
      [ -z "$blockfile" ] && continue
      frank="${sortkey%%-*}"
      [ "$frank" != "$want_frank" ] && continue
      if $bfirst; then bfirst=false; else body="${body}

"; fi
      body="${body}$(cat "$blockfile")"
    done < <(sort "$sortlist")
    [ -z "$body" ] && body="None."
    printf '%s' "$body"
  }

  local standard_questions custom_questions extracted_questions
  standard_questions="$(render_section 0)"
  custom_questions="$(render_section 1)"
  extracted_questions="$(render_section 2)"
  rm -f "$sortlist"

  local summary
  summary="$(cat <<EOF
**Total questions:** ${total} (Extracted: ${cq_total}, Standard bank: ${sq_total}, Custom: ${uq_total})
**Blocking:** ${blocking_count}
**Unanswered:** ${unanswered_count}
**By type:** DECISION: ${type_counts[DECISION]}, DATA: ${type_counts[DATA]}, SCOPE: ${type_counts[SCOPE]}, DEFECT: ${type_counts[DEFECT]}, MECHANICAL: ${type_counts[MECHANICAL]}, TARGET-GAP: ${type_counts[TARGET-GAP]}, CONFLICT: ${type_counts[CONFLICT]}
EOF
)"

  # Recompute which of the five known docs are present, for the header —
  # cheap, self-contained, avoids threading collect's output through argv.
  local -a docs_present=()
  for d in "${DOC_NAMES[@]}"; do
    [ -f "$analysis_dir/$d" ] && docs_present+=("$d")
  done
  local docs_swept
  docs_swept="$(IFS=', '; echo "${docs_present[*]}")"
  [ -z "$docs_swept" ] && docs_swept="none (bank/custom-only run)"

  local title date_str template_file doc
  title="$(project_title "$project_root")"
  date_str="$(date +%Y-%m-%d)"
  template_file="$SCRIPT_DIR/../templates/clarifications.md"

  doc="$(cat "$template_file")"
  doc="$(substitute "$doc" '{{title}}' "$title")"
  doc="$(substitute "$doc" '{{date}}' "$date_str")"
  doc="$(substitute "$doc" '{{docs_swept}}' "$docs_swept")"
  doc="$(substitute "$doc" '{{summary}}' "$summary")"
  doc="$(substitute "$doc" '{{standard_questions}}' "$standard_questions")"
  doc="$(substitute "$doc" '{{custom_questions}}' "$custom_questions")"
  doc="$(substitute "$doc" '{{questions}}' "$extracted_questions")"
  doc="$(substitute "$doc" '{{not_applicable}}' "$not_applicable_body")"

  printf '%s\n' "$doc" > "$clar_file"

  # ── Apply PROMOTED: directives to pending-questions.md — one surgical
  # Status-line edit per entry, only now that clarifications.md has
  # actually been written successfully with the corresponding CQ block. ───
  local promoted_count=0
  if [ -f "$pq_file" ] && [ "${#promoted_pq[@]}" -gt 0 ]; then
    local pidx
    for ((pidx = 0; pidx < ${#promoted_pq[@]}; pidx++)); do
      promote_pq_status "$pq_file" "${promoted_pq[$pidx]}" "${promoted_cq[$pidx]}"
      promoted_count=$((promoted_count + 1))
    done
  fi

  [ "$cq_draft" != "-" ] && rm -f "$cq_draft"
  [ "$bank_draft" != "-" ] && rm -f "$bank_draft"
  [ -n "$ingest_draft" ] && [ "$ingest_draft" != "-" ] && rm -f "$ingest_draft"
  rm -rf "$workdir"

  echo "Wrote $clar_file (${total} question(s): ${cq_total} extracted, ${sq_total} standard, ${uq_total} custom; ${unanswered_count} unanswered, ${blocking_count} blocking)" >&2
  if [ "$promoted_count" -gt 0 ]; then
    echo "Promoted ${promoted_count} pending question(s) — pending-questions.md Status line(s) rewritten in place." >&2
  fi
  # `$custom_scaffolded && echo ...` would leak a false's exit 1 out of this
  # function (no `else` branch) as this script's own exit status under
  # `set -e`, since this is the last statement executed — same class of bug
  # flagged on render_uq_from_custom_questions's own final line. `if` avoids
  # it: the statement's exit status is 0 whenever the condition is false.
  if $custom_scaffolded; then
    echo "Scaffolded $custom_file — edit it and re-run to add UQ questions (git add it so context discovery sees it)." >&2
  fi
}

# ─── Subcommand: resolve-collect (resolve mode, pre-agent) ───────────────────

cmd_resolve_collect() {
  local specclaw_dir="$1"
  [ -d "$specclaw_dir" ] || die "specclaw directory not found: $specclaw_dir"

  local specclaw_dir_abs project_root analysis_dir
  specclaw_dir_abs="$(cd "$specclaw_dir" && pwd)"
  project_root="$(cd "$specclaw_dir_abs/.." && pwd)"
  analysis_dir="$specclaw_dir_abs/analysis"
  local clar_file="$analysis_dir/clarifications.md"

  [ -f "$clar_file" ] || die "no .specclaw/analysis/clarifications.md found — run /specclaw:bf-clarify first."

  local workdir; workdir="$(mktemp -d)"
  split_question_blocks "$clar_file" "$workdir"

  local -a answered=() unanswered=()
  local f id
  for f in "$workdir"/*.md; do
    [ -f "$f" ] || continue
    id="$(block_id "$f")"
    if block_is_answered "$f"; then
      answered+=("$id")
    else
      unanswered+=("$id")
    fi
  done
  rm -rf "$workdir"

  if [ "${#answered[@]}" -eq 0 ]; then
    die "no answered questions found in .specclaw/analysis/clarifications.md — fill in at least one **Answer:** field before running --resolve."
  fi

  local answered_json unanswered_json
  answered_json="$(printf '%s\n' "${answered[@]}" | json_array_from_lines)"
  unanswered_json="$(printf '%s\n' "${unanswered[@]}" | json_array_from_lines)"

  local output
  output=$(cat <<ENDJSON
{
  "project_root": "$(json_escape "$project_root")",
  "clarifications_path": ".specclaw/analysis/clarifications.md",
  "total_questions": $(( ${#answered[@]} + ${#unanswered[@]} )),
  "answered_ids": [${answered_json}
  ],
  "unanswered_ids": [${unanswered_json}
  ]
}
ENDJSON
)
  emit_json "$output"
}

# ─── Subcommand: resolve-render (resolve mode, post-agent) ──────────────────

cmd_resolve_render() {
  local specclaw_dir="$1" adr_file="$2"
  [ -d "$specclaw_dir" ] || die "specclaw directory not found: $specclaw_dir"
  [ -f "$adr_file" ] || die "ADR-judgment file not found: $adr_file"

  local specclaw_dir_abs project_root analysis_dir archive_dir
  specclaw_dir_abs="$(cd "$specclaw_dir" && pwd)"
  project_root="$(cd "$specclaw_dir_abs/.." && pwd)"
  analysis_dir="$specclaw_dir_abs/analysis"
  archive_dir="$analysis_dir/archive"

  local clar_file="$analysis_dir/clarifications.md"
  [ -f "$clar_file" ] || die "no .specclaw/analysis/clarifications.md found — run /specclaw:bf-clarify first."

  local workdir; workdir="$(mktemp -d)"
  split_question_blocks "$clar_file" "$workdir"

  shopt -s nullglob
  local -a block_files=("$workdir"/*.md)
  shopt -u nullglob

  local decisions_body="" unanswered_body="" dfirst=true
  local f id title qtype source answer decided_by decided_date blocking_txt entry family

  for f in "${block_files[@]}"; do
    id="$(block_id "$f")"
    title="$(block_title "$f")"
    qtype="$(block_single_field "$f" "Type")"
    family="$(id_family "$id")"

    if block_is_answered "$f"; then
      source="$(block_single_field "$f" "Source")"
      answer="$(block_answer_text "$f")"
      decided_by="$(block_single_field "$f" "Decided by")"
      decided_date="$(block_single_field "$f" "Date")"

      entry="$(cat <<ENTRY
### ${id} — ${title}

- **Type:** ${qtype}
- **Family:** ${family}
- **Decision:** ${answer}
- **Decided by:** ${decided_by:-⚠ not recorded}
- **Date:** ${decided_date:-⚠ not recorded}
- **Source:** ${source}
ENTRY
)"
      if $dfirst; then dfirst=false; else decisions_body="${decisions_body}

"; fi
      decisions_body="${decisions_body}${entry}"
    else
      blocking_txt="$(block_single_field "$f" "Blocking")"
      unanswered_body="${unanswered_body}- **${id}** — ${title} (Type: ${qtype}, Family: ${family}, Blocking: ${blocking_txt})
"
    fi
  done
  rm -rf "$workdir"

  [ -n "$decisions_body" ] || decisions_body="No decisions recorded yet — no answered questions found in clarifications.md."
  [ -n "$unanswered_body" ] || unanswered_body="All questions in clarifications.md have been answered."

  # Splice in the agent's ADR-worthiness judgments.
  local adr_body="" any_promoted=false
  local aid apromote atitle arationale
  while IFS='|' read -r aid apromote atitle arationale; do
    [ -z "$aid" ] && continue
    case "$apromote" in
      [Yy]es|[Yy])
        any_promoted=true
        adr_body="${adr_body}- **${aid}** — ${atitle} — ${arationale}
"
        ;;
    esac
  done < "$adr_file"
  $any_promoted || adr_body="No decisions in this run were judged significant enough to warrant a standalone ADR."

  # Archive prior decisions.md, now that everything it would have held is
  # already re-derived fresh from clarifications.md above.
  local decisions_file="$analysis_dir/decisions.md"
  if [ -f "$decisions_file" ]; then
    mkdir -p "$archive_dir"
    mv "$decisions_file" "$archive_dir/$(date +%Y-%m-%d-%H%M%S)-decisions.md"
  fi

  local title_val date_str template_file doc
  title_val="$(project_title "$project_root")"
  date_str="$(date +%Y-%m-%d)"
  template_file="$SCRIPT_DIR/../templates/decisions.md"

  doc="$(cat "$template_file")"
  doc="$(substitute "$doc" '{{title}}' "$title_val")"
  doc="$(substitute "$doc" '{{date}}' "$date_str")"
  doc="$(substitute "$doc" '{{decisions}}' "$decisions_body")"
  doc="$(substitute "$doc" '{{adr_candidates}}' "$adr_body")"
  doc="$(substitute "$doc" '{{unanswered}}' "$unanswered_body")"

  printf '%s\n' "$doc" > "$decisions_file"

  rm -f "$adr_file"

  echo "Wrote $decisions_file" >&2
}

# ─── Options-pack support (PD-04: bash computes decision status, never an
# agent) ─────────────────────────────────────────────────────────────────────
#
# The options pack is the client-readable face of this command: it packages
# every UNDECIDED BLOCKING question as a decision paper a non-engineer can
# read and sign. It creates no new ID family and no parallel decision
# mechanism — it is keyed by the same CQ-NNN/SQ-NNN/UQ-NNN ids the rest of
# this script owns, and a client's answer travels the existing
# clarifications.md -> --resolve -> decisions.md path, attributed to the
# named human who made it.
#
# EVERYTHING ABOUT *STATUS* IS COMPUTED HERE, IN BASH. The agent is handed a
# resolved verdict per question and never re-derives one by reading the
# markdown itself. Same trust model /specclaw:bf-bootstrap uses for its own
# declaration: the agent says what it wrote, bash says what it means.
#
# NOTHING IN THIS SECTION KNOWS A STACK. There is no list of databases,
# hosts, or frameworks here and there never will be — the candidate options
# a client chooses between are generated by the agent at run time from what
# this repo's own analysis documents actually show. A vendor name in this
# file would be exactly the curated-menu failure the design forbids.

PLUGIN_ROOT="$SCRIPT_DIR/.."
OPTIONS_PACK_TEMPLATE="$SCRIPT_DIR/../templates/options-pack.md"

# The plugin's own declared version, read from plugin.json rather than
# hardcoded — same reasoning as bank_version() above, and the same
# jq-optional tolerance every collect-style script in this plugin applies.
plugin_version_of_this_run() {
  local manifest="$PLUGIN_ROOT/.claude-plugin/plugin.json" v=""
  [ -f "$manifest" ] || { printf 'unknown'; return 0; }
  if command -v jq &>/dev/null; then
    v="$(jq -r '.version // empty' "$manifest" 2>/dev/null || true)"
  fi
  if [ -z "$v" ]; then
    v="$({ grep -m1 -E '"version"[[:space:]]*:' "$manifest" 2>/dev/null \
      | sed -E 's/.*"version"[[:space:]]*:[[:space:]]*"([^"]*)".*/\1/'; } || true)"
  fi
  printf '%s' "${v:-unknown}"
}

# JSON array body from positional args — the `${arr[@]+"${arr[@]}"}` form is
# the only expansion of a possibly-empty array that is safe under `set -u` on
# every bash this plugin supports.
ids_json_args() {
  local out="" first=true id
  for id in "$@"; do
    [ -z "$id" ] && continue
    if $first; then first=false; else out="${out}, "; fi
    out="${out}\"$(json_escape "$id")\""
  done
  printf '%s' "$out"
}

# Heading-anchored decision lookup, copied in behaviour from
# specclaw-bf-bootstrap's decision_text_of (no shared lib, per repo
# convention). A `### SQ-0NN —` heading only ever appears under decisions.md's
# `## Decisions` section, never under `## Outstanding Questions` (which lists
# unanswered ids as plain bullets) — so this cannot mistake an open question
# for a decided one, which a whole-file grep for the id absolutely would.
op_decision_text_of() {
  local decisions_file="$1" id="$2"
  [ -f "$decisions_file" ] || { printf ''; return 0; }
  local block
  block="$(awk -v id="$id" '
    $0 ~ ("^### " id "([^0-9]|$)") { cap=1; next }
    cap && /^### / { cap=0 }
    cap { print }
  ' "$decisions_file" 2>/dev/null || true)"
  [ -n "$block" ] || { printf ''; return 0; }
  local decision
  decision="$(printf '%s\n' "$block" \
    | { grep -m1 -- '^- \*\*Decision:\*\*' || true; } \
    | sed -E 's/^- \*\*Decision:\*\* *//' | sed -E 's/[[:space:]]+$//')"
  # A heading with an empty Decision line is NOT an answer. Reading it as one
  # would let an id that was transcribed but never decided read as decided.
  case "$decision" in
    ''|TBD|tbd) printf '' ;;
    *'not recorded'*) printf '' ;;
    *) printf '%s' "$decision" ;;
  esac
}

# One non-Decision field out of a decisions.md entry (Decided by / Date).
# Values pass through VERBATIM, including resolve-render's own
# "not recorded" flag — that flag exists precisely to be visible, and
# normalising it away here would hide a decision nobody signed.
op_decision_field_of() {
  local decisions_file="$1" id="$2" label="$3"
  [ -f "$decisions_file" ] || { printf ''; return 0; }
  awk -v id="$id" '
    $0 ~ ("^### " id "([^0-9]|$)") { cap=1; next }
    cap && /^### / { cap=0 }
    cap { print }
  ' "$decisions_file" 2>/dev/null \
    | { grep -m1 -- "^- \*\*${label}:\*\*" || true; } \
    | sed -E "s/^- \*\*${label}:\*\* *//" | sed -E 's/[[:space:]]+$//'
}

# A bank entry's own Blocking flag / title, for an SQ listed under
# `## Not Applicable` (which carries no Type or Blocking line of its own — it
# is a one-line tombstone, not a rendered block). A CQ/UQ has no bank entry,
# so it reads "no": an extracted or custom question that was never rendered
# cannot be shown to be blocking, and guessing that it is would put something
# nobody can characterise in front of a client.
op_bank_blocking_of() {
  local id="$1"
  [ -f "$BANK_FILE" ] || { printf 'no'; return 0; }
  local line
  line="$(awk -v id="$id" '
    $0 ~ ("^## " id "([^0-9]|$)") { cap=1; next }
    cap && /^## / { cap=0 }
    cap && /^- \*\*Blocking:\*\*/ { print; exit }
  ' "$BANK_FILE" 2>/dev/null || true)"
  case "$line" in *[Yy][Ee][Ss]*) printf 'yes' ;; *) printf 'no' ;; esac
}

op_bank_title_of() {
  local id="$1"
  [ -f "$BANK_FILE" ] || { printf ''; return 0; }
  # NB: the separator alternation is deliberately NOT a bracket expression —
  # see block_title's comment; a POSIX bracket class byte-splits the em dash
  # on this toolchain and corrupts every title after it.
  { awk -v id="$id" '$0 ~ ("^## " id "([^0-9]|$)") { print; exit }' "$BANK_FILE" 2>/dev/null || true; } \
    | sed -E 's/^## (CQ|SQ|UQ)-[0-9]+[[:space:]]*(—|-)[[:space:]]*//'
}

# The scan's field separator is US (0x1f), NOT a tab. A tab is an IFS
# *whitespace* character, so `IFS=$'\t' read` silently collapses a run of them
# into a single delimiter, and every field after the first EMPTY one shifts
# left by a column — which is exactly what the empty Type field on a
# `## Not Applicable` entry produces. A non-whitespace separator preserves
# empty fields, and no markdown field parsed here can contain a control
# character.
OP_FS=$'\037'

op_row() {
  local out="$1"; shift
  local v
  for v in "$@"; do out="${out}${OP_FS}${v}"; done
  printf '%s\n' "$out"
}

# THE ONE STATUS COMPUTATION. Both options-pack subcommands consume this and
# neither recomputes it, so `collect` and `render` can never disagree about
# whether a question is decided.
#
# Emits one TSV row per question, in this fixed column order:
#   1 id  2 family  3 type  4 blocking(yes|no)  5 status  6 title
#   7 answer  8 decided_by  9 date  10 na_reason  11 status_source
#
# Status rule:
#   DECIDED         decisions.md carries a `### <id> —` heading whose
#                   `- **Decision:**` line is non-empty (the authoritative
#                   record) — OR the clarifications.md block's own
#                   **Answer:** field is filled in. Both count, because a
#                   human can answer in clarifications.md before anyone runs
#                   --resolve, and reporting that as UNDECIDED would make the
#                   pack lie to the client who just answered it. decisions.md
#                   wins for attribution when both exist. Column 11 records
#                   WHICH file proved it, so every verdict is checkable.
#   NOT-APPLICABLE  the id is listed in clarifications.md's own
#                   `## Not Applicable` section — the single place that
#                   verdict is ever declared.
#   UNDECIDED       everything else.
#
# Free-text columns are flattened to one line (tabs and newlines become
# spaces): this is a status table, not a content carrier. Multi-line prose is
# read separately by `collect`, straight from the block.
op_scan_questions() {
  local clar_file="$1" decisions_file="$2"
  local clar_rel=".specclaw/analysis/clarifications.md"
  local decisions_rel=".specclaw/analysis/decisions.md"

  local workdir; workdir="$(mktemp -d)"
  split_question_blocks "$clar_file" "$workdir"
  shopt -s nullglob
  local -a block_files=("$workdir"/*.md)
  shopt -u nullglob

  local f id title qtype family blocking status ssource ans dby ddate dtext
  for f in ${block_files[@]+"${block_files[@]}"}; do
    id="$(block_id "$f")"
    title="$(block_title "$f")"
    qtype="$(block_single_field "$f" "Type")"
    family="$(id_family "$id")"
    blocking="$(block_field_blocking_bool "$f")"
    ans="$(block_answer_text "$f" | tr '\n\t' '  ' | sed -E 's/[[:space:]]+/ /g; s/^ //; s/ $//')"
    dtext="$(op_decision_text_of "$decisions_file" "$id")"
    if [ -n "$dtext" ]; then
      status="DECIDED"; ssource="$decisions_rel"; ans="$dtext"
      dby="$(op_decision_field_of "$decisions_file" "$id" "Decided by")"
      ddate="$(op_decision_field_of "$decisions_file" "$id" "Date")"
    elif [ -n "$ans" ]; then
      status="DECIDED"; ssource="$clar_rel"
      dby="$(block_single_field "$f" "Decided by")"
      ddate="$(block_single_field "$f" "Date")"
    else
      status="UNDECIDED"; ssource=""; ans=""; dby=""; ddate=""
    fi
    op_row "$id" "$family" "$qtype" "$blocking" "$status" "$title" \
      "$ans" "$dby" "$ddate" "" "$ssource"
  done
  rm -rf "$workdir"

  # `## Not Applicable` entries carry no block of their own — one line each,
  # keyed `- **SQ-NNN** — <reason>`, written by render from the bank agent's
  # own NOT-APPLICABLE directive.
  local naline naid nareason
  while IFS= read -r naline; do
    [ -z "$naline" ] && continue
    naid="$(printf '%s' "$naline" | { grep -oE '(CQ|SQ|UQ)-[0-9]+' | head -1; } || true)"
    [ -n "$naid" ] || continue
    nareason="$(printf '%s' "$naline" \
      | sed -E 's/^- \*\*(CQ|SQ|UQ)-[0-9]+\*\*[[:space:]]*(—|-)?[[:space:]]*//' \
      | tr '\n\t' '  ' | sed -E 's/[[:space:]]+/ /g; s/^ //; s/ $//')"
    op_row "$naid" "$(id_family "$naid")" "" "$(op_bank_blocking_of "$naid")" \
      "NOT-APPLICABLE" "$(op_bank_title_of "$naid")" "" "" "" "$nareason" \
      "$clar_rel section Not Applicable"
  done < <(awk '/^## Not Applicable/{flag=1;next} /^## /{flag=0} flag' "$clar_file" 2>/dev/null \
             | { grep -E '^- \*\*(CQ|SQ|UQ)-[0-9]+\*\*' || true; })
}

# Display order for the pending section: taxonomy rank, then id. Deliberately
# not "the order they happen to appear in clarifications.md" — a client reads
# DECISION questions first, because those are the ones only they can answer.
op_sort_ids_by_type() {
  local scan="$1"; shift
  local id row rank
  for id in "$@"; do
    [ -z "$id" ] && continue
    row="$(printf '%s\n' "$scan" | awk -F"$OP_FS" -v i="$id" '$1==i {print; exit}')"
    rank="$(type_rank "$(printf '%s' "$row" | cut -d"$OP_FS" -f3)")"
    printf '%s\t%s\n' "$rank" "$id"
  done | sort -k1,1n -k2,2 | cut -f2
}

# ─── Subcommand: options-pack-collect (options-pack mode, pre-agent) ─────────

cmd_options_pack_collect() {
  local specclaw_dir="$1"
  [ -d "$specclaw_dir" ] || die "specclaw directory not found: $specclaw_dir"

  local specclaw_dir_abs project_root analysis_dir
  specclaw_dir_abs="$(cd "$specclaw_dir" && pwd)"
  project_root="$(cd "$specclaw_dir_abs/.." && pwd)"
  analysis_dir="$specclaw_dir_abs/analysis"

  local clar_file="$analysis_dir/clarifications.md"
  [ -f "$clar_file" ] || die "no .specclaw/analysis/clarifications.md found — run /specclaw:bf-clarify first. The options pack packages questions that command has already drafted; it never invents its own question set."

  local decisions_file="$analysis_dir/decisions.md"
  local decisions_present=false
  [ -f "$decisions_file" ] && decisions_present=true

  local scan; scan="$(op_scan_questions "$clar_file" "$decisions_file")"

  local -a und_b=() dec_b=() na_b=()
  local bu=0 bd=0 bn=0 nu=0 nd=0 nn=0 total=0
  local id blocking status
  while IFS="$OP_FS" read -r id _ _ blocking status _ _ _ _ _ _; do
    [ -z "$id" ] && continue
    total=$((total + 1))
    if [ "$blocking" = "yes" ]; then
      case "$status" in
        UNDECIDED)      bu=$((bu + 1)); und_b+=("$id") ;;
        DECIDED)        bd=$((bd + 1)); dec_b+=("$id") ;;
        NOT-APPLICABLE) bn=$((bn + 1)); na_b+=("$id") ;;
      esac
    else
      case "$status" in
        UNDECIDED)      nu=$((nu + 1)) ;;
        DECIDED)        nd=$((nd + 1)) ;;
        NOT-APPLICABLE) nn=$((nn + 1)) ;;
      esac
    fi
  done <<< "$scan"

  # Undecided blocking ids in the order the pack will render them, so the
  # agent drafts in reading order rather than in glob order.
  local -a und_sorted=()
  if [ "${#und_b[@]}" -gt 0 ]; then
    while IFS= read -r id; do
      [ -n "$id" ] && und_sorted+=("$id")
    done < <(op_sort_ids_by_type "$scan" ${und_b[@]+"${und_b[@]}"})
  fi

  # Per-question detail. Every field is a transcription of a parsed line —
  # nothing here is generated prose, and nothing here is a judgement.
  local workdir; workdir="$(mktemp -d)"
  split_question_blocks "$clar_file" "$workdir"

  local questions_json="" qfirst=true
  local family qtype title source finding why options propdef ans dby ddate nareason ssource f blocking_json na_json ss_json
  while IFS="$OP_FS" read -r id family qtype blocking status title ans dby ddate nareason ssource; do
    [ -z "$id" ] && continue
    f="$workdir/$id.md"
    source=""; finding=""; why=""; options=""; propdef=""
    if [ -f "$f" ]; then
      source="$(block_single_field "$f" "Source")"
      finding="$(bank_field_multiline "$f" "Finding")"
      why="$(bank_field_multiline "$f" "Why it matters")"
      options="$(bank_field_multiline "$f" "Options")"
      propdef="$(bank_field_multiline "$f" "Proposed default")"
    fi
    blocking_json=false
    [ "$blocking" = "yes" ] && blocking_json=true
    ss_json='null'
    [ -n "$ssource" ] && ss_json="\"$(json_escape "$ssource")\""
    na_json='null'
    [ -n "$nareason" ] && na_json="\"$(json_escape "$nareason")\""
    if $qfirst; then qfirst=false; else questions_json="${questions_json},"; fi
    questions_json="${questions_json}
    {
      \"id\": \"$(json_escape "$id")\",
      \"title\": \"$(json_escape "$title")\",
      \"family\": \"$(json_escape "$family")\",
      \"type\": \"$(json_escape "$qtype")\",
      \"blocking\": ${blocking_json},
      \"status\": \"$(json_escape "$status")\",
      \"status_source\": ${ss_json},
      \"source\": \"$(json_escape "$source")\",
      \"finding\": \"$(json_escape "$finding")\",
      \"why_it_matters\": \"$(json_escape "$why")\",
      \"options\": \"$(json_escape "$options")\",
      \"proposed_default\": \"$(json_escape "$propdef")\",
      \"answer\": \"$(json_escape "$ans")\",
      \"decided_by\": \"$(json_escape "$dby")\",
      \"date\": \"$(json_escape "$ddate")\",
      \"na_reason\": ${na_json}
    }"
  done <<< "$scan"
  rm -rf "$workdir"

  local -a docs_present=() docs_missing=()
  local d
  for d in "${DOC_NAMES[@]}"; do
    if [ -f "$analysis_dir/$d" ]; then docs_present+=("$d"); else docs_missing+=("$d"); fi
  done
  local docs_present_json docs_missing_json
  docs_present_json="$(printf '%s\n' ${docs_present[@]+"${docs_present[@]}"} | json_array_from_lines)"
  docs_missing_json="$(printf '%s\n' ${docs_missing[@]+"${docs_missing[@]}"} | json_array_from_lines)"

  local output
  output=$(cat <<ENDJSON
{
  "project_root": "$(json_escape "$project_root")",
  "project_title": "$(json_escape "$(project_title "$project_root")")",
  "plugin_version": "$(json_escape "$(plugin_version_of_this_run)")",
  "generated": "$(date +%Y-%m-%d)",
  "clarifications_path": ".specclaw/analysis/clarifications.md",
  "decisions_md": {"present": ${decisions_present}, "path": ".specclaw/analysis/decisions.md"},
  "docs_present": [${docs_present_json}
  ],
  "docs_missing": [${docs_missing_json}
  ],
  "counts": {
    "total": ${total},
    "blocking": {"undecided": ${bu}, "decided": ${bd}, "not_applicable": ${bn}},
    "non_blocking": {"undecided": ${nu}, "decided": ${nd}, "not_applicable": ${nn}}
  },
  "undecided_blocking_ids": [$(ids_json_args ${und_sorted[@]+"${und_sorted[@]}"})],
  "decided_blocking_ids": [$(ids_json_args ${dec_b[@]+"${dec_b[@]}"})],
  "not_applicable_blocking_ids": [$(ids_json_args ${na_b[@]+"${na_b[@]}"})],
  "questions": [${questions_json}
  ]
}
ENDJSON
)
  emit_json "$output"
}

# ─── Subcommand: options-pack-render (options-pack mode, post-agent) ────────

cmd_options_pack_render() {
  local specclaw_dir="$1" draft="$2"
  [ -d "$specclaw_dir" ] || die "specclaw directory not found: $specclaw_dir"

  local specclaw_dir_abs project_root analysis_dir archive_dir
  specclaw_dir_abs="$(cd "$specclaw_dir" && pwd)"
  project_root="$(cd "$specclaw_dir_abs/.." && pwd)"
  analysis_dir="$specclaw_dir_abs/analysis"
  archive_dir="$analysis_dir/archive"

  local clar_file="$analysis_dir/clarifications.md"
  [ -f "$clar_file" ] || die "no .specclaw/analysis/clarifications.md found — run /specclaw:bf-clarify first."
  local decisions_file="$analysis_dir/decisions.md"

  [ -f "$OPTIONS_PACK_TEMPLATE" ] || die "options-pack template not found at $OPTIONS_PACK_TEMPLATE"

  # Status is recomputed from scratch here, never read back off the prior
  # pack and never trusted from the draft — the same discipline
  # /specclaw:bf-rebuild-plan applies to Gate/Verification.
  local scan; scan="$(op_scan_questions "$clar_file" "$decisions_file")"

  local -a und_b=() dec_b=() na_b=()
  local bu=0 bd=0 bn=0 nb_total=0
  local id blocking status
  while IFS="$OP_FS" read -r id _ _ blocking status _ _ _ _ _ _; do
    [ -z "$id" ] && continue
    if [ "$blocking" = "yes" ]; then
      case "$status" in
        UNDECIDED)      bu=$((bu + 1)); und_b+=("$id") ;;
        DECIDED)        bd=$((bd + 1)); dec_b+=("$id") ;;
        NOT-APPLICABLE) bn=$((bn + 1)); na_b+=("$id") ;;
      esac
    else
      nb_total=$((nb_total + 1))
    fi
  done <<< "$scan"

  local -a und_sorted=()
  if [ "${#und_b[@]}" -gt 0 ]; then
    while IFS= read -r id; do
      [ -n "$id" ] && und_sorted+=("$id")
    done < <(op_sort_ids_by_type "$scan" ${und_b[@]+"${und_b[@]}"})
  fi

  # ── Draft validation ────────────────────────────────────────────────────
  # Exactly one block per undecided blocking id, and no block for anything
  # else. Same "exactly once — never neither, never both" rule the bank
  # layer enforces on its own agent, and for the same reason: a silently
  # dropped question is a question the client never gets asked.
  local draftdir=""
  if [ "$draft" != "-" ]; then
    [ -f "$draft" ] || die "options-pack draft not found: $draft"
    draftdir="$(mktemp -d)"
    split_question_blocks "$draft" "$draftdir"
    local want got
    for id in ${und_sorted[@]+"${und_sorted[@]}"}; do
      got="$({ grep -cE "^### ${id}([^0-9]|$)" "$draft" || true; })"
      [ "$got" = "1" ] || { rm -rf "$draftdir"; die "options-pack draft must contain exactly one '### ${id}' block (found ${got}). Every undecided blocking question gets asked, exactly once — a dropped one is a question the client never sees."; }
    done
    while IFS= read -r want; do
      [ -z "$want" ] && continue
      case " ${und_sorted[*]-} " in
        *" $want "*) ;;
        *) rm -rf "$draftdir"; die "options-pack draft contains a block for ${want}, which is not an undecided blocking question this run. The pack asks about blocking questions only, and never about one already decided." ;;
      esac
    done < <({ grep -oE '^### (CQ|SQ|UQ)-[0-9]+' "$draft" || true; } | sed -E 's/^### //')
  elif [ "${#und_sorted[@]}" -gt 0 ]; then
    die "there are ${#und_sorted[@]} undecided blocking question(s) (${und_sorted[*]}) but no draft was passed. Pass '-' only when the collector reported zero undecided blocking questions."
  fi

  # ── Pending section ─────────────────────────────────────────────────────
  # The agent supplies the restatement, the options, the trade-offs and the
  # recommendation. Bash supplies the heading trailer and the Client decision
  # line — identical in every section of every project, and never
  # improvised, because it is the one line that tells a reader this document
  # does not record anything.
  local pending_body="" pfirst=true blk row title qtype family
  for id in ${und_sorted[@]+"${und_sorted[@]}"}; do
    row="$(printf '%s\n' "$scan" | awk -F"$OP_FS" -v i="$id" '$1==i {print; exit}')"
    qtype="$(printf '%s' "$row" | cut -d"$OP_FS" -f3)"
    family="$(printf '%s' "$row" | cut -d"$OP_FS" -f2)"
    blk="$(cat "$draftdir/$id.md")"
    # Strip trailing blank lines from the agent's block so the bash-owned
    # trailer always sits directly under it.
    blk="$(printf '%s\n' "$blk" | sed -e :a -e '/^[[:space:]]*$/{$d;N;ba' -e '}')"
    if $pfirst; then pfirst=false; else pending_body="${pending_body}

"; fi
    pending_body="${pending_body}${blk}

- **Type:** ${qtype} · **Family:** ${family} · **Blocking:** yes
- **Client decision:** ⬜ pending — record via bf-clarify answer, attributed by name"
  done
  [ -n "$pending_body" ] || pending_body="**Nothing pending — all blocking decisions recorded.**

Every blocking question this rebuild needs answered has an answer on record.
See **Already Decided** below for what was decided, by whom, and when. No
client action is needed on this document."

  # ── Already-decided section: pure transcription, bash-owned ─────────────
  local decided_body="" ans dby ddate ssource
  local -a dec_sorted=()
  if [ "${#dec_b[@]}" -gt 0 ]; then
    while IFS= read -r id; do
      [ -n "$id" ] && dec_sorted+=("$id")
    done < <(op_sort_ids_by_type "$scan" ${dec_b[@]+"${dec_b[@]}"})
  fi
  for id in ${dec_sorted[@]+"${dec_sorted[@]}"}; do
    row="$(printf '%s\n' "$scan" | awk -F"$OP_FS" -v i="$id" '$1==i {print; exit}')"
    title="$(printf '%s' "$row" | cut -d"$OP_FS" -f6)"
    ans="$(printf '%s' "$row" | cut -d"$OP_FS" -f7)"
    dby="$(printf '%s' "$row" | cut -d"$OP_FS" -f8)"
    ddate="$(printf '%s' "$row" | cut -d"$OP_FS" -f9)"
    ssource="$(printf '%s' "$row" | cut -d"$OP_FS" -f11)"
    decided_body="${decided_body}- **${id}** — ${title}: ${ans} — ${dby:-⚠ decider not recorded}, ${ddate:-⚠ date not recorded} _(source: ${ssource})_
"
  done
  [ -n "$decided_body" ] || decided_body="None yet — no blocking question has a recorded decision."

  # ── Not-applicable section: pure transcription, bash-owned ─────────────
  local na_body="" nareason
  for id in ${na_b[@]+"${na_b[@]}"}; do
    row="$(printf '%s\n' "$scan" | awk -F"$OP_FS" -v i="$id" '$1==i {print; exit}')"
    title="$(printf '%s' "$row" | cut -d"$OP_FS" -f6)"
    nareason="$(printf '%s' "$row" | cut -d"$OP_FS" -f10)"
    na_body="${na_body}- **${id}** — ${title}: ${nareason}
"
  done
  [ -n "$na_body" ] || na_body="None — every blocking question applies to this rebuild."

  local counts_line non_blocking_note
  counts_line="**Blocking questions:** ${bu} undecided · ${bd} decided · ${bn} not applicable"
  if [ "$nb_total" -gt 0 ]; then
    non_blocking_note="_${nb_total} further non-blocking question(s) are open in \`.specclaw/analysis/clarifications.md\` and are deliberately not shown here — they shape the rebuild but do not hold it up._"
  else
    non_blocking_note="_No non-blocking questions were excluded — \`.specclaw/analysis/clarifications.md\` holds nothing beyond what is shown above._"
  fi

  # Archive the prior pack, now that everything it held has been re-derived.
  local pack_file="$analysis_dir/options-pack.md"
  if [ -f "$pack_file" ]; then
    mkdir -p "$archive_dir"
    mv "$pack_file" "$archive_dir/$(date +%Y-%m-%d-%H%M%S)-options-pack.md"
  fi

  local doc
  doc="$(cat "$OPTIONS_PACK_TEMPLATE")"
  doc="$(substitute "$doc" '{{title}}' "$(project_title "$project_root")")"
  doc="$(substitute "$doc" '{{plugin_version}}' "$(plugin_version_of_this_run)")"
  doc="$(substitute "$doc" '{{date}}' "$(date +%Y-%m-%d)")"
  doc="$(substitute "$doc" '{{counts}}' "$counts_line")"
  doc="$(substitute "$doc" '{{pending_decisions}}' "$pending_body")"
  doc="$(substitute "$doc" '{{already_decided}}' "$decided_body")"
  doc="$(substitute "$doc" '{{not_applicable}}' "$na_body")"
  doc="$(substitute "$doc" '{{non_blocking_note}}' "$non_blocking_note")"

  printf '%s\n' "$doc" > "$pack_file"

  [ -n "$draftdir" ] && rm -rf "$draftdir"
  [ "$draft" != "-" ] && rm -f "$draft"

  echo "Wrote $pack_file (${bu} pending, ${bd} decided, ${bn} not applicable)" >&2
}
# ─── Main ─────────────────────────────────────────────────────────────────────

case "${1:-}" in
  collect)
    [ $# -ge 2 ] || die "Usage: specclaw-bf-clarify collect <specclaw_dir> [--bank-only]"
    cmd_collect "$2" "${3:-}"
    ;;
  render)
    [ $# -ge 4 ] || die "Usage: specclaw-bf-clarify render <specclaw_dir> <cq_draft|-> <bank_draft|-> [<ingest_draft|->]"
    cmd_render "$2" "$3" "$4" "${5:-}"
    ;;
  resolve-collect)
    [ $# -ge 2 ] || die "Usage: specclaw-bf-clarify resolve-collect <specclaw_dir>"
    cmd_resolve_collect "$2"
    ;;
  resolve-render)
    [ $# -ge 3 ] || die "Usage: specclaw-bf-clarify resolve-render <specclaw_dir> <adr_file>"
    cmd_resolve_render "$2" "$3"
    ;;
  options-pack-collect)
    [ $# -ge 2 ] || die "Usage: specclaw-bf-clarify options-pack-collect <specclaw_dir>"
    cmd_options_pack_collect "$2"
    ;;
  options-pack-render)
    [ $# -ge 3 ] || die "Usage: specclaw-bf-clarify options-pack-render <specclaw_dir> <draft|->"
    cmd_options_pack_render "$2" "$3"
    ;;
  "")
    usage
    exit 1
    ;;
  *)
    die "Unknown subcommand: $1. Run specclaw-bf-clarify --help for usage."
    ;;
esac
