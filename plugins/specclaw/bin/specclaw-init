#!/usr/bin/env bash
# specclaw init — Initialize SpecClaw in a project directory
# Usage: specclaw-init <project_dir> [project_name] [project_description]

set -euo pipefail

PROJECT_DIR="${1:-.}"
PROJECT_NAME="${2:-$(basename "$(cd "$PROJECT_DIR" && pwd)")}"
PROJECT_DESC="${3:-}"

SPECCLAW_DIR="$PROJECT_DIR/.specclaw"
PLUGIN_ROOT="${CLAUDE_PLUGIN_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"

if [ -d "$SPECCLAW_DIR" ]; then
  echo "ERROR: .specclaw/ already exists in $PROJECT_DIR"
  exit 1
fi

# Create directory structure
mkdir -p "$SPECCLAW_DIR/changes/archive"

# Generate config from template
sed \
  -e "s|^  name: \"\"|  name: \"$PROJECT_NAME\"|" \
  -e "s|^  description: \"\"|  description: \"$PROJECT_DESC\"|" \
  "$PLUGIN_ROOT/templates/config.yaml" > "$SPECCLAW_DIR/config.yaml"

# Create initial STATUS.md
cat > "$SPECCLAW_DIR/STATUS.md" << EOF
# 🦞 SpecClaw Dashboard

**Project:** $PROJECT_NAME
**Last Updated:** $(date -u +"%Y-%m-%d %H:%M UTC")

## Active Changes

_No active changes yet. Run \`specclaw propose "<idea>"\` to start._

## Pending Proposals

_None._

## Recently Completed

_None._

## Stats

- **Total changes:** 0
- **Active:** 0
- **Completed:** 0
EOF

# Ignore the raw timing ledgers (change 028). timeline.md — the rendered view a
# reviewer actually reads — IS committed; the per-span JSONL would churn every
# PR with numbers nobody reads line by line. Idempotent: the block is added once.
GITIGNORE="$PROJECT_DIR/.gitignore"
if ! grep -qF 'timeline.jsonl' "$GITIGNORE" 2>/dev/null; then
  {
    printf '\n# specclaw: raw timing ledgers. timeline.md (the render) is committed.\n'
    printf '.specclaw/changes/*/timeline.jsonl\n'
    printf '.specclaw/changes/archive/*/timeline.jsonl\n'
  } >> "$GITIGNORE" 2>/dev/null || true
fi

# Ignore the bf-* collector handoff directory (change 039). Each file is the
# JSON one bf command wrote for the agent it spawned in that same run —
# regenerated every time, read once, and large (229 KB on this repo). It is a
# handoff, not a record: nothing consults it afterwards, so committing it would
# store a derived fact that only drifts. Idempotent: the block is added once.
if ! grep -qF '.specclaw/analysis/.collect/' "$GITIGNORE" 2>/dev/null; then
  {
    printf '\n# specclaw: bf-* collector handoff files. Regenerated every run.\n'
    printf '.specclaw/analysis/.collect/\n'
  } >> "$GITIGNORE" 2>/dev/null || true
fi

echo "OK: Initialized SpecClaw in $SPECCLAW_DIR"
echo "  config: $SPECCLAW_DIR/config.yaml"
echo "  status: $SPECCLAW_DIR/STATUS.md"
echo "  changes: $SPECCLAW_DIR/changes/"
