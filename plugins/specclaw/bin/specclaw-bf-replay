#!/usr/bin/env bash
# specclaw-bf-replay — golden-master comparison: replays captured legacy fixtures
# against the new app's own behaviour. Bash + coreutils + jq (required — this
# script parses nested JSON in manifest.json/fixtures/compare results, unlike
# sibling bins that only hand-build flat JSON).
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PLUGIN_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# ─── Large-payload transport ─────────────────────────────────────────────────
# A command line is not a data channel. Windows caps one at ~32,767 characters
# and POSIX has its own ARG_MAX, so a jq invocation handed a whole fixture
# selection through --argjson dies with E2BIG (exit 126, "Argument list too
# long") before jq reads a byte: a 48-fixture manifest compacts to ~38 KB, and
# what actually reaches argv is jq's own PRETTY-printed output, three to four
# times that again. So every payload here that grows with fixture count,
# selection size, backlog size, stub-registry size, or one fixture's captured
# output travels by FILE (--slurpfile) or by stdin. Only fixed-size scalars
# still ride argv.
#
# The read side keeps one convention: `--slurpfile <name>_in "$(sc_payload …)"`
# plus a single `($<name>_in[0]) as $<name>` binding at the top of the program.
# Every existing reference inside the jq query therefore stays byte-identical,
# and a transport change cannot quietly become a query change.
#
# SC_TMPDIR is created HERE, eagerly, in the main shell — never lazily inside
# sc_payload. sc_payload is called from inside "$( … )", and a subshell that
# created the directory would also fire the EXIT trap that removes it, deleting
# the payload before jq ever opened it.
SC_TMPDIR="$(mktemp -d)"
trap 'rm -rf "$SC_TMPDIR"' EXIT

# Writes $2 into a slot file under this run's private temp dir and echoes the
# path. One file per slot name, rewritten in place, so a payload recomputed in
# a loop reuses one file instead of leaking one per iteration. Slot names must
# be distinct WITHIN a single jq invocation; across invocations they are free
# to repeat, because bash finishes every substitution before jq is exec'd.
sc_payload() {
  local slot="$1" value="$2"
  printf '%s' "$value" > "${SC_TMPDIR}/${slot}.json"
  printf '%s' "${SC_TMPDIR}/${slot}.json"
}

# ─── Helpers ──────────────────────────────────────────────────────────────────

usage() {
  cat <<'EOF'
Usage: specclaw-bf-replay <subcommand> [options]

Subcommands:
  parse-target  [<change_name>] [--item BL-###] [--module MOD-###] [--all]
                [--keep|--discard|--prune-evidence <n>]
                Validates a raw invocation's selection scope and prints the ONE
                canonical target token every subcommand below takes. The four
                scopes are mutually exclusive: a positional <change_name>
                combines with no flag, and the flags combine with nothing.
                Retention qualifiers are accepted and ignored — they qualify a
                run rather than selecting one. Fails loudly, naming the
                conflict, on any illegal combination.

  resolve       <specclaw_dir> <change_name|BL-###|MOD-###|--all> <out_selection_json>
                BL -> DR -> GM join for a change (via its cited backlog item)
                or a literal BL-### item; MOD-### for one module's fixtures (a
                pure jq join on manifest module_ids, ANY-of, so a cross-module
                fixture is selected by every module it touches); or --all for
                the full manifest. Four selection scopes, smallest to largest:
                item, change, module, corpus.
                The change/item join is on the backlog item's own
                acceptance-basis DR-### citations against each manifest entry's
                business_rules_pinned — the same chain rebuild-backlog.md's own
                "Verification: ... fixtures:" line is computed from, so the two
                are testably equal. verifies_backlog_item is a cross-check only:
                a populated value disagreeing with the join is a WARN naming
                both sets, a placeholder is ignored silently, and neither is
                ever load-bearing for selection.
                A BL-### target needs no change directory. An active item with
                genuinely zero fixtures is a clean 0-fixture selection that
                renders INCOMPLETE (exit 2), never a precondition failure; an
                unknown item and a STRUCK tombstone are both refused.
                A MOD-### target additionally hard-fails on a manifest older
                than the schema that first carried module_ids, or one whose
                fixtures carry none at all — each naming its own fix, rather
                than selecting nothing and reporting a clean INCOMPLETE.
                Verifies manifest/fixtures are present and every selected
                fixture's sha256 matches manifest.json's recorded hash — fails
                loudly on any mismatch, missing manifest, or unresolved BL
                item. Also hard-fails, BEFORE creating anything, on a manifest
                that predates the current schema or whose selected entries
                carry no status/seam_layer — naming
                "re-run /specclaw:bf-baseline --record" as the fix rather
                than assuming VERIFIABLE. Writes the selection JSON and prints
                a one-line summary.

  init-rundir   <specclaw_dir> <run_dir>
                Creates the run directory and writes a run-config.json stub
                ({stack, build_command, test_command, results_dir,
                evidence_exclusions} per CONTRACT.md — all null/empty) for
                the replay-mapper agent to complete. Copies nothing.

  run-tests     <specclaw_dir> <run_dir>
                Reads run-config.json; fails loudly if test_command is still
                null (the replay-mapper agent never completed it). Otherwise
                runs build_command (if non-null) then test_command verbatim,
                from the project root — this stack's own build/test tooling,
                named by the agent, never assumed here. Does not itself
                decide MATCH/DIVERGES — only reports pass-fail and how many
                actual-<GM-ID>.json files were written.

  compare       <specclaw_dir> <run_dir>
                Deterministic field-by-field diff of every REPLAYABLE
                fixture's expected vs. actual output (per mapping.json),
                skipping the fixture's own normalized_fields and comparing
                Exception*Type fields by short name only. Classifies every
                row: "behavioural" (outcome/error_code/threw or any other
                compared field differs), "representation" (only the raw
                exception type/message differs — never FAILs a run), or
                "unmapped-error-code". Re-verifies every mapping entry's
                seam layer against the manifest first and forces a mismatch
                to NOT REPLAYABLE/seam-mismatch whatever the agent claimed.
                Writes compare.json. Never asserted by an agent.

  sanction-check <specclaw_dir> <run_dir>
                Mechanically re-verifies every CQ the replay-auditor agent
                cited in sanction.json actually exists as a decided
                `### CQ-0NN —` heading in decisions.md (never an Outstanding
                Question). Writes sanction-verified.json.

  render        <specclaw_dir> <change_name|MOD-###|--all> <run_dir> [--discard]
                Renders replay-report.md (report-<run_id>.md for --all,
                report-<run_id>-MOD-###.md for a module run)
                from selection/mapping/compare/sanction-verified JSON, plus
                an evidence-package pointer header (pass --discard when the
                caller will discard evidence, so the report says so instead
                of pointing at a folder that won't exist). Archives any
                prior per-change report first. Exits 0/1/2 for
                PASS/FAIL/INCOMPLETE.

  finalize      <specclaw_dir> <change_name|MOD-###|--all> <run_dir> [--keep|--discard]
                Retention is the default: curates the run directory's
                generated tests (source only — excludes whatever
                run-config.json's evidence_exclusions names as this stack's
                own build/dependency output) + actual results + a
                fixture-manifest excerpt + run-metadata.json + the pipeline
                record (run-config/selection/mapping/compare/sanction/
                sanction-verified JSON and the build/test logs)
                into .specclaw/changes/<name>/replay-evidence/run-<id>/ (or
                .specclaw/replay/evidence/run-<id>/ for --all and MOD-###,
                which share the corpus pool and record the module they
                covered in run-metadata.json), regenerates
                evidence-summary.md, warns if .gitignore would swallow the
                evidence path, then removes the working run directory.
                --keep is accepted and silently treated the same as the
                default. --discard skips all of the above and just deletes
                the run directory — no evidence, summary left untouched.

  prune-evidence <specclaw_dir> <change_name|MOD-###|--all> <n>
                Keeps only the newest <n> evidence run folders for that
                change (or the shared pool --all and MOD-### runs use),
                deleting older ones.
                Never runs automatically — explicit-only, standalone from
                any replay run.

Options:
  -h, --help    Show this help message
EOF
}

die() { echo "ERROR: $*" >&2; exit 1; }
warn() { echo "WARN: $*" >&2; }

require_jq() {
  command -v jq >/dev/null 2>&1 \
    || die "jq is required by specclaw-bf-replay (nested manifest/fixture JSON parsing) but was not found on PATH."
}

# The canonical field-path language and the divergence classification are
# defined ONCE, in lib/gm-paths.jq, and prepended to this script's jq programs
# — specclaw-bf-baseline's record loads the exact same file to validate the
# very paths compared here. Two lookalike implementations that disagreed about
# what a path means would let a normalization path validate green at capture
# time and then normalize nothing on every replay, which is exactly the noise
# this pipeline exists to eliminate.
GM_PATHS_JQ=""
load_gm_paths() {
  local lib="$PLUGIN_ROOT/lib/gm-paths.jq"
  [ -f "$lib" ] || die "Shared path-resolution library missing: ${lib}. This ships with the plugin; a missing copy means a broken install, and compare will not fall back to a local reimplementation."
  GM_PATHS_JQ="$(cat "$lib")"
}

# The oldest manifest schema this version can read (CONTRACT.md (c')). An
# older manifest is refused with a fix instruction rather than read under
# assumed defaults — a pre-v0.8 manifest has no per-fixture status at all, and
# defaulting it to VERIFIABLE turns "we never checked" into "we checked and it
# was fine."
MANIFEST_SCHEMA_MIN=2

# The schema that first carried per-fixture `module_ids`. Deliberately a
# SEPARATE, higher floor than MANIFEST_SCHEMA_MIN: a `<change-name>` or `--all`
# run needs nothing from it and keeps working against a schema-2 manifest, so
# adopting this version costs a project that ignores modules exactly nothing.
# Only a `MOD-###` run — which is a join on that field — requires it, and it
# says so with the same fix instruction the older guard uses.
MODULE_SCHEMA_MIN=3

# Four selection scopes, smallest to largest: one backlog item, one change's
# BL item(s), one module, the whole corpus. A module target is the literal
# MOD-### token and an item target the literal BL-### token, so every
# subcommand keeps its existing `<change_name|--all>` argument shape and
# nothing needs a new flag threaded through five call sites.
target_kind() {
  case "$1" in
    --all)          printf 'all' ;;
    MOD-[0-9][0-9][0-9]) printf 'module' ;;
    BL-[0-9][0-9][0-9]) printf 'item' ;;
    *)              printf 'change' ;;
  esac
}

plugin_version_of_this_run() {
  jq -r '.version // "unknown"' "$PLUGIN_ROOT/.claude-plugin/plugin.json" 2>/dev/null || echo "unknown"
}

# JSON-escape a string (used only for hand-built markdown-derived text, never
# for anything already flowing through jq).
json_escape() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\r'/\\r}"
  s="${s//$'\t'/\\t}"
  printf '%s' "$s"
}

# Safe placeholder substitution — never bash's ${var/pat/rep} or sed's s///,
# both of which treat a literal '&' in the replacement as "insert whole
# match" on this toolchain. Split on the literal token and concatenate,
# looping so EVERY occurrence is replaced (a token used more than once in a
# template — e.g. {{overall_verdict}} — must not leave later copies untouched).
fill_placeholder() {
  local content="$1" token="$2" value="$3"
  local result="" remaining="$content"
  while [[ "$remaining" == *"$token"* ]]; do
    result="${result}${remaining%%"$token"*}${value}"
    remaining="${remaining#*"$token"}"
  done
  printf '%s' "${result}${remaining}"
}

# UI fidelity policy — read mechanically from decisions.md's literal
# structure, the same discipline sanction-check uses for a CQ citation.
# Used for ONE thing only: an informational footer line in the rendered
# report. It touches no verdict, no fixture status, no exit code — UI is
# excluded from the golden-master seam taxonomy and nothing here changes
# that. (Copied rather than shared, per repo convention.)
FIDELITY_SQ_ID="SQ-013"

read_fidelity_policy() {
  local decisions_file="$1"
  [ -f "$decisions_file" ] || { printf 'UNDECIDED'; return 0; }
  local block
  block="$(awk -v id="$FIDELITY_SQ_ID" '
    $0 ~ ("^### " id "[[:space:]]") { cap=1; next }
    cap && /^### / { cap=0 }
    cap { print }
  ' "$decisions_file" 2>/dev/null || true)"
  [ -n "$block" ] || { printf 'UNDECIDED'; return 0; }
  local decision
  decision="$(printf '%s\n' "$block" | grep -m1 -- '^- \*\*Decision:\*\*' | sed -E 's/^- \*\*Decision:\*\* *//' || true)"
  [ -n "$decision" ] || { printf 'UNDECIDED'; return 0; }
  case "$decision" in
    *THEME-ONLY*)  printf 'THEME-ONLY' ;;
    *FAITHFUL*)    printf 'FAITHFUL' ;;
    *REINTERPRET*) printf 'REINTERPRET' ;;
    *)             printf 'UNDECIDED' ;;
  esac
}

# ─── The dependency-bypass stub registry (CONTRACT.md (m)) ──────────────────
#
# Reads .specclaw/analysis/module-stubs.md into JSON so `resolve` can join it
# against the selected fixtures. Nothing here computes, judges, or infers
# anything: it is a parse of declared data, exactly like reading seam_layer
# out of the manifest.
#
# ABSENCE IS A NORMAL STATE — most projects never bypass anything. A missing
# registry parses to `[]` and every downstream reader treats the run as
# untainted, silently. No warning, no degradation, no verdict change.
#
# awk emits TSV and jq builds the JSON, rather than awk printing JSON itself:
# hand-escaping arbitrary prose (an entry's Fakes line is free text) inside
# awk is exactly the kind of quoting bug that produces a silently truncated
# field rather than an error.
stubs_json() {
  local stubs_file="$1"
  if [ ! -f "$stubs_file" ]; then printf '[]'; return 0; fi
  awk '
    function val(s) {
      sub(/^- \*\*[^*]+:\*\*[[:space:]]*/, "", s)
      gsub(/\t/, " ", s)
      sub(/[[:space:]]+$/, "", s)
      return s
    }
    function flush() {
      if (id != "")
        printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n",
               id, summary, status, substitutes, strategy, consumed, fakes, seed
      id = ""; summary = ""; status = ""; substitutes = ""
      strategy = ""; consumed = ""; fakes = ""; seed = ""
    }
    /^### ST-[0-9]+/ {
      flush()
      match($0, /ST-[0-9]+/); id = substr($0, RSTART, RLENGTH)
      summary = $0
      sub(/^### ST-[0-9]+[[:space:]]*(—|-)[[:space:]]*/, "", summary)
      gsub(/\t/, " ", summary)
      next
    }
    /^## / { flush(); next }
    id == "" { next }
    /^- \*\*Status:\*\*/       { status      = val($0); next }
    /^- \*\*Substitutes:\*\*/  { substitutes = val($0); next }
    /^- \*\*Strategy:\*\*/     { strategy    = val($0); next }
    /^- \*\*Consumed by:\*\*/  { consumed    = val($0); next }
    /^- \*\*Fakes:\*\*/        { fakes       = val($0); next }
    /^- \*\*Mock seed:\*\*/    { seed        = val($0); next }
    END { flush() }
  ' "$stubs_file" 2>/dev/null \
  | jq -R -s '
      [ split("\n")[] | select(length > 0) | split("\t")
        | { id:          .[0],
            summary:     .[1],
            # Only the FIRST token of Status is the state; the rest is the
            # date and clearing run id. An unrecognized value stays verbatim
            # rather than being coerced — silently reading a typo as ACTIVE
            # (taints everything) or as RETIRED (taints nothing) are both
            # wrong, and the caller can report what it actually saw.
            status:      (.[2] | split(" ")[0] | ascii_upcase),
            status_raw:  .[2],
            substitutes: .[3],
            strategy:    .[4],
            consumed_by: (.[5] | [scan("BL-[0-9]{3}")]),
            fakes:       .[6],
            mock_seed:   .[7] } ]
    ' 2>/dev/null || printf '[]'
}

# ─── The item-split registry (CONTRACT.md (o)) ──────────────────────────────
#
# Read for ONE purpose: to say honestly whether an `--item` run is the item's
# final acceptance, or only a look at the half of it that has been built.
#
# NOTHING HERE TOUCHES A VERDICT. A split fakes nothing, so no fixture's
# standing is in question and no comparison is any less sound — what is in
# question is whether the ITEM IS FINISHED, which is a statement about scope,
# not about correctness. Same shape as stub taint, and for a different reason.
#
# Absence is a normal state: most projects never split an item, and a missing
# registry parses to `[]` with no warning and no degradation.
splits_json() {
  local splits_file="$1"
  if [ ! -f "$splits_file" ]; then printf '[]'; return 0; fi
  awk '
    function val(s) {
      sub(/^- \*\*[^*]+:\*\*[[:space:]]*/, "", s)
      gsub(/\t/, " ", s)
      sub(/[[:space:]]+$/, "", s)
      return s
    }
    function flush() {
      if (id != "")
        printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n",
               id, summary, status, item, deferred, rules_impl, rules_def, blocked, replay_ev
      id = ""; summary = ""; status = ""; item = ""; deferred = ""
      rules_impl = ""; rules_def = ""; blocked = ""; replay_ev = ""
    }
    /^### IS-[0-9]+/ {
      flush()
      match($0, /IS-[0-9]+/); id = substr($0, RSTART, RLENGTH)
      summary = $0
      sub(/^### IS-[0-9]+[[:space:]]*(—|-)[[:space:]]*/, "", summary)
      gsub(/\t/, " ", summary)
      next
    }
    /^## / { flush(); next }
    id == "" { next }
    /^- \*\*Status:\*\*/             { status     = val($0); next }
    /^- \*\*Item:\*\*/               { item       = val($0); next }
    /^- \*\*Deferred:\*\*/           { deferred   = val($0); next }
    /^- \*\*Rules implemented:\*\*/  { rules_impl = val($0); next }
    /^- \*\*Rules deferred:\*\*/     { rules_def  = val($0); next }
    /^- \*\*Blocked until:\*\*/      { blocked    = val($0); next }
    /^- \*\*Replay evidence:\*\*/    { replay_ev  = val($0); next }
    END { flush() }
  ' "$splits_file" 2>/dev/null \
  | jq -R -s '
      [ split("\n")[] | select(length > 0) | split("\t")
        | { id:                .[0],
            summary:           .[1],
            status:            (.[2] | split(" ")[0] | ascii_upcase),
            status_raw:        .[2],
            item:              (.[3] | [scan("BL-[0-9]{3}")] | first),
            deferred:          .[4],
            rules_implemented: (.[5] | [scan("DR-[0-9]{3}")]),
            rules_deferred:    (.[6] | [scan("DR-[0-9]{3}")]),
            blocked_until:     (.[7] | [scan("BL-[0-9]{3}")]),
            replay_evidence:   .[8] } ]
    ' 2>/dev/null || printf '[]'
}

# Extract the markdown block under a "### <heading_id> —" heading, up to (not
# including) the next "### " heading. Used for both decisions.md (CQ-###) and
# rebuild-backlog.md (BL-###) — same heading shape in both real documents.
extract_heading_block() {
  local file="$1" heading_id="$2"
  awk -v id="$heading_id" '
    $0 ~ "^### " id " " {found=1; print; next}
    found && /^### / {exit}
    found {print}
  ' "$file" 2>/dev/null || true
}

# ─── The BL → DR → GM join (CONTRACT.md (b)) ──────────────────────────────────
#
# THE AUTHORITATIVE JOIN for change- and item-scoped selection: a backlog
# item's own acceptance-basis DR-### citations, matched against each manifest
# entry's `business_rules_pinned`. This is deliberately the SAME chain
# /specclaw:bf-rebuild-plan walks to compute each item's
# "**Verification:** VERIFIABLE — fixtures: …" line (see
# specclaw-bf-rebuild-collect's ITEM_RULES ∩ GM_RULES join), which is what
# makes tool-internal consistency testable: `--item BL-020`'s selection must
# equal the backlog's own Verification fixture list for BL-020.
#
# It replaces a join on the manifest's `verifies_backlog_item`, which could
# never work: the pipeline's own order runs /specclaw:bf-baseline (A4) BEFORE
# /specclaw:bf-rebuild-plan (A5), so on a first-recorded manifest that field
# holds the designer's "not yet backlog-linked — rebuild-backlog.md does not
# exist yet" placeholder on EVERY entry, and change- and item-scoped selection
# matched nothing on every correctly-run project. The field is now a
# cross-check only (see cmd_resolve) and is never load-bearing for selection.
#
# DR ids are matched as textual DR-### tokens — the join key the backlog format
# itself guarantees is present (templates/rebuild-backlog.md requires the ID to
# be "textually present, not just implied by the quoted prose"). Never a
# substring or prefix match, so DR-01 can never match DR-010.

# The title text of a "### BL-### — <title>" heading, for the STRUCK check.
backlog_item_title() {
  local backlog_file="$1" bl_id="$2"
  extract_heading_block "$backlog_file" "$bl_id" | head -1 \
    | sed -E "s/^### ${bl_id}[[:space:]]*(—|-)[[:space:]]*//" | tr -d '\r'
}

# Every DR-### token in a backlog item's own body, comma-joined, first-seen
# order. The bash-RECOMPUTED lines are dropped first — Gate/Verification/UI
# fidelity/the deferred marker/the human status-notes tail — mirroring exactly
# what specclaw-bf-rebuild-collect excludes when it reads an item's body for
# ITEM_RULES. Reading them back in would join on ids that document this run's
# own output rather than the item's acceptance basis. (Copied rather than
# shared across the two scripts, per repo convention.)
backlog_item_dr_ids() {
  local backlog_file="$1" bl_id="$2"
  extract_heading_block "$backlog_file" "$bl_id" | tail -n +2 | awk '
      /^\*\*Gate:\*\*/ { skip=1; next }
      /^\*\*Verification:\*\*/ { skip=1; next }
      /^\*\*UI fidelity:\*\*/ { skip=1; next }
      /^\*\*Status:\*\* Deferred/ { skip=1; next }
      /^\*\*Status notes \(human-added\):\*\*/ { intail=1; next }
      intail { next }
      /^\*\*Settled constraints/ { skip=0 }
      skip { next }
      { print }
    ' | { grep -oE 'DR-[0-9]{3}' | awk '!seen[$0]++' | paste -sd, -; } || true
}

# Every active backlog item's DR set, as a JSON object:
#   {"BL-014": ["DR-002"], "BL-020": ["DR-001","DR-002"]}
# The reverse of the selection join, used to attribute each selected fixture to
# the item(s) whose acceptance basis rests on the rules it pins
# (`bl_items_resolved`). A STRUCK tombstone is excluded: it is an id kept
# claimed, not an item anything can verify. An absent backlog is an empty map,
# silently — the same treatment a missing stub registry gets.
backlog_dr_map() {
  local backlog_file="$1"
  [ -f "$backlog_file" ] || { printf '{}'; return 0; }
  local id title drs
  {
    while IFS= read -r id; do
      [ -z "$id" ] && continue
      title="$(backlog_item_title "$backlog_file" "$id")"
      case "$title" in STRUCK*) continue ;; esac
      drs="$(backlog_item_dr_ids "$backlog_file" "$id")"
      [ -n "$drs" ] || continue
      printf '%s\t%s\n' "$id" "$drs"
    done < <({ grep -oE '^### BL-[0-9]{3}' "$backlog_file" 2>/dev/null \
               | grep -oE 'BL-[0-9]{3}' | awk '!seen[$0]++'; } || true)
  } | tr -d '\r' | jq -R -s '
    split("\n") | map(select(length > 0) | split("\t")
                      | {key: .[0], value: (.[1] | [scan("DR-[0-9]{3}")])})
    | from_entries'
}

# ─── Subcommand: resolve ─────────────────────────────────────────────────────
# Resolve a change (or --all) to its selected GM-### fixtures via change -> BL
# -> DR -> GM, verify manifest/fixture integrity, and write selection.json.

resolve_bl_id() {
  local change_dir="$1" backlog_file="$2"
  local proposal="$change_dir/proposal.md" spec="$change_dir/spec.md"
  local f

  # Strips whole "Depends on:"/"Blocks:" bullets — including their wrapped
  # continuation lines — from a file before it's scanned for BL-### tokens.
  # A change's own "## Dependencies" section legitimately cites OTHER items'
  # BL-### numbers (e.g. "Depends on: BL-002 ... transitively BL-004/BL-005"
  # wrapping onto a second line with no "Depends on" text of its own), so a
  # same-line-only filter isn't enough — this drops the entire bullet block.
  strip_dependency_bullets() {
    awk '
      BEGIN { ex = 0 }
      /^[[:space:]]*-[[:space:]]/ {
        if ($0 ~ /\*\*(Depends on|Blocks)/) { ex = 1; next }
        else { ex = 0 }
      }
      /^[[:space:]]*$/ { ex = 0 }
      ex == 1 { next }
      { print }
    ' "$1" 2>/dev/null
  }

  # Pass 1 (tried first): explicit "item N"/"backlog item N" self-citation
  # phrasing, excluding relational lines ("Depends on: ... item 3", "Blocks:
  # item 8") which name OTHER items, not this change's own. Real convention
  # confirmed in task-status-transitions: proposal.md says "Rebuild-backlog
  # item 4 merges..." (self-citation); spec.md's "Depends on"/"Blocks" lines
  # cite unrelated items. This phrasing is a more reliable self-citation
  # signal than a bare literal BL-### match (Pass 2 below), which can't tell
  # a change's own identifier apart from another change's mentioned in
  # passing — so it takes priority whenever both are present.
  local item_num=""
  for f in "$proposal" "$spec"; do
    [ -f "$f" ] || continue
    item_num="$(grep -iE 'rebuild-backlog item|backlog item' "$f" 2>/dev/null \
                | grep -viE 'depends on|blocks' \
                | grep -oiE 'item[[:space:]]+[0-9]+' \
                | grep -oE '[0-9]+' \
                | head -1 || true)"
    [ -n "$item_num" ] && break
  done

  local bl_id=""
  if [ -n "$item_num" ]; then
    bl_id="$(printf 'BL-%03d' "$item_num")"
  else
    # Pass 2 (fallback): a literal BL-### citation, if any change ever writes
    # one directly with no "item N" phrasing anywhere. Dependency bullets are
    # stripped first so citations of OTHER items' numbers in "Depends on"/
    # "Blocks" don't get mistaken for this change's own.
    local direct=""
    for f in "$proposal" "$spec"; do
      [ -f "$f" ] || continue
      direct="${direct}$(strip_dependency_bullets "$f" | grep -oE 'BL-[0-9]{3}' || true) "
    done
    direct="$(printf '%s' "$direct" | tr -s ' ' '\n' | grep -v '^$' | sort -u || true)"
    if [ -n "$direct" ]; then
      local n
      n=$(printf '%s\n' "$direct" | grep -c . || true)
      [ "$n" -gt 1 ] && warn "Change cites multiple BL items directly (${direct//$'\n'/, }) — using the first."
      bl_id="$(printf '%s\n' "$direct" | head -1)"
    fi
  fi

  [ -z "$bl_id" ] && { printf ''; return 0; }

  if [ -f "$backlog_file" ] && ! grep -qE "^### ${bl_id} " "$backlog_file"; then
    local via
    if [ -n "$item_num" ]; then
      via="an 'item $item_num' citation"
    else
      via='a direct citation'
    fi
    warn "Derived ${bl_id} from ${via} but rebuild-backlog.md has no matching '### ${bl_id} —' heading — treating as unresolved."
    printf ''
    return 0
  fi

  # Soft sanity check: does the resolved item's own title share any keyword
  # with the change folder name? A miss is a WARN, not a die — this fallback
  # is best-effort text matching, not proof.
  if [ -f "$backlog_file" ]; then
    local title matched=false word
    title="$(extract_heading_block "$backlog_file" "$bl_id" | head -1 | sed -E "s/^### ${bl_id}[[:space:]]+.—.[[:space:]]*//")"
    local change_base
    change_base="$(basename "$change_dir")"
    IFS='-' read -ra words <<< "$change_base"
    for word in "${words[@]:-}"; do
      [ "${#word}" -lt 4 ] && continue
      if printf '%s' "$title" | grep -qi -- "$word"; then matched=true; break; fi
    done
    $matched || warn "Resolved ${bl_id} ('${title}') shares no obvious keyword with change name '${change_base}' — double-check this is the right backlog item."
  fi

  printf '%s\n' "$bl_id"
}

cmd_resolve() {
  require_jq
  local specclaw_dir="$1" target="$2" out_path="$3"
  local specclaw_dir_abs project_root
  specclaw_dir_abs="$(cd "$specclaw_dir" && pwd)"
  project_root="$(cd "$specclaw_dir_abs/.." && pwd)"

  local manifest="$specclaw_dir_abs/baseline/manifest.json"
  local fixtures_dir="$specclaw_dir_abs/baseline/fixtures"
  local backlog_file="$specclaw_dir_abs/analysis/rebuild-backlog.md"

  [ -f "$manifest" ] || die "manifest.json not found at ${manifest} — run /specclaw:bf-baseline --record first."
  [ -d "$fixtures_dir" ] || die "Fixtures directory not found at ${fixtures_dir}."
  jq -e . "$manifest" >/dev/null 2>&1 || die "manifest.json at ${manifest} is not valid JSON."

  # ── Version & status compatibility guard (CONTRACT.md (c')) ──────────────
  # Runs here, before anything at all is created on disk, so a stale baseline
  # fails with an instruction instead of producing a run directory, a report,
  # and a verdict computed from assumed defaults.
  local manifest_schema manifest_plugin_version
  manifest_schema="$(jq -r '.manifest_schema // empty' "$manifest")"
  manifest_plugin_version="$(jq -r '.plugin_version // empty' "$manifest")"

  if [ -z "$manifest_schema" ]; then
    die "manifest.json at ${manifest} has no \"manifest_schema\" field — it predates the current baseline schema (v${MANIFEST_SCHEMA_MIN}), so it carries no per-fixture status, seam_layer, or semantic error fields. Replaying against it would silently treat every fixture as VERIFIABLE and every seam layer as whatever the mapper chose.
Fix: re-run /specclaw:bf-baseline --record"
  fi
  if ! [[ "$manifest_schema" =~ ^[0-9]+$ ]]; then
    die "manifest.json at ${manifest} has a non-numeric \"manifest_schema\" (${manifest_schema}).
Fix: re-run /specclaw:bf-baseline --record"
  fi
  if [ "$manifest_schema" -lt "$MANIFEST_SCHEMA_MIN" ]; then
    die "manifest.json at ${manifest} is schema v${manifest_schema}; this specclaw requires v${MANIFEST_SCHEMA_MIN} or newer.
Fix: re-run /specclaw:bf-baseline --record"
  fi

  local this_version
  this_version="$(plugin_version_of_this_run)"
  if [ -n "$manifest_plugin_version" ] && [ "$manifest_plugin_version" != "$this_version" ]; then
    warn "Baseline was recorded by specclaw v${manifest_plugin_version}; this replay is running specclaw v${this_version}. Both versions are stamped into the report header and run-metadata.json so the difference is visible on the report's face."
  fi

  local kind bl_id="" module_id=""
  kind="$(target_kind "$target")"
  case "$kind" in
    change)
      local change_dir="$specclaw_dir_abs/changes/${target}"
      [ -d "$change_dir" ] || die "Change '${target}' not found under ${specclaw_dir_abs}/changes/."
      bl_id="$(resolve_bl_id "$change_dir" "$backlog_file")"
      [ -n "$bl_id" ] || die "Change '${target}' cites no backlog (BL-###) item in proposal.md/spec.md — replay only makes sense for backlog-driven changes."
      ;;
    item)
      # An item run needs NO change directory: it is the smallest scope, for
      # accepting one backlog item's behaviour on its own. What it does need is
      # the backlog itself — that document is the join's left-hand side.
      bl_id="$target"
      [ -f "$backlog_file" ] || die "--item ${bl_id} needs .specclaw/analysis/rebuild-backlog.md, which does not exist at ${backlog_file} — there is no backlog item to replay, and nothing to join fixtures against.
Fix: run /specclaw:bf-rebuild-plan first."
      grep -qE "^### ${bl_id}([[:space:]]|$)" "$backlog_file" \
        || die "--item ${bl_id} names no item in ${backlog_file} — it has no '### ${bl_id} —' heading. Items that do exist: $({ grep -oE '^### BL-[0-9]{3}' "$backlog_file" | grep -oE 'BL-[0-9]{3}' | awk '!seen[$0]++' | paste -sd, - | sed 's/,/, /g'; } || echo none)."
      local item_title
      item_title="$(backlog_item_title "$backlog_file" "$bl_id")"
      case "$item_title" in
        STRUCK*)
          die "--item ${bl_id} is a STRUCK tombstone in ${backlog_file} (${item_title}), not an active backlog item. Its id stays claimed forever so nothing reuses it, but there is no behaviour to accept: a struck item was removed from the rebuild deliberately. Nothing was created on disk."
          ;;
      esac
      # ── A quality remediation item is not replayable, and saying so is the
      # whole point of this guard. It cites no DR-### rule and maps to no
      # GM-### fixture, so the DR join below would select nothing and this run
      # would report a confident "NO BASELINE DATA — 0 fixtures mapped" — which
      # reads as "somebody forgot to record a fixture" when the truth is that
      # this kind of item is never accepted by fixture comparison at all. Its
      # acceptance is a MEASUREMENT, and it has its own command.
      if extract_heading_block "$backlog_file" "$bl_id" \
           | grep -qE '^\*\*Item type:\*\* QUALITY-REMEDIATION'; then
        die "--item ${bl_id} is a QUALITY-REMEDIATION item in ${backlog_file} (${item_title}), not a behavioural backlog item. It cites no DR-### rule and maps to no GM-### fixture, so there is nothing for a replay to compare — its **Verification:** line reads QUALITY-MEASURED for exactly that reason. Nothing was created on disk.
Fix: /specclaw:bf-quality --target <the rebuilt tree>, then /specclaw:bf-quality --compare. That writes quality-delta.json, and the item's own **Quality state:** line in rebuild-backlog.md carries the resulting verdict."
      fi
      ;;
    module)
      module_id="$target"
      # ── Module-metadata guards. Both fire here, before anything is created
      # on disk, and both name the fix — the same discipline the schema guard
      # above uses. A --module run is a join on manifest data; without that
      # data it would silently select nothing and report a clean INCOMPLETE,
      # which reads as "this module has no behaviour to check."
      if [ "$manifest_schema" -lt "$MODULE_SCHEMA_MIN" ]; then
        die "manifest.json at ${manifest} is schema v${manifest_schema}; a --module run needs v${MODULE_SCHEMA_MIN} or newer, which is the first schema carrying per-fixture module_ids. A change-scoped or --all run still works against this manifest unchanged.
Fix: re-run /specclaw:bf-baseline --record"
      fi
      local tagged_count
      tagged_count="$(jq '[ .fixtures[] | select(((.module_ids // []) | length) > 0) ] | length' "$manifest")"
      if [ "$tagged_count" -eq 0 ]; then
        die "No fixture in ${manifest} carries any module_ids, so there is nothing for --module ${module_id} to select. The baseline was recorded before its scenarios declared a module.
Fix: re-run /specclaw:bf-baseline (design mode) so each scenario declares the module(s) owning the rules it pins, then /specclaw:bf-baseline --record"
      fi
      ;;
  esac

  # The item→rules map, read once and reused for both the selection join
  # (item/change scopes) and the per-fixture BL attribution (every scope).
  local dr_map item_drs=""
  dr_map="$(backlog_dr_map "$backlog_file")"

  local selected_fixtures
  if [ -n "$bl_id" ]; then
    # ── The authoritative join: BL-### → its acceptance-basis DR-### ids →
    # every manifest entry pinning any of them. ANY-of, exactly like the
    # module_ids join below and for the same reason: a fixture pinning two
    # rules is the record of a flow resting on both, and an item resting on
    # either cannot be accepted without it.
    item_drs="$(backlog_item_dr_ids "$backlog_file" "$bl_id")"
    selected_fixtures="$(jq --arg drs "$item_drs" '
      ($drs | [scan("DR-[0-9]{3}")]) as $want
      | [ .fixtures[]
          | select( ((.business_rules_pinned // "") | [scan("DR-[0-9]{3}")])
                    | any(. as $p | $want | index($p)) ) ]' "$manifest")"
  elif [ -n "$module_id" ]; then
    # Pure jq join on declared manifest data — no agent, no re-derivation from
    # scenarios.md prose. ANY-of semantics: a fixture whose rules span modules
    # carries several module_ids and is selected by EVERY one of them, because
    # it is the record of a flow that crosses those boundaries and neither
    # module can be accepted without it.
    selected_fixtures="$(jq --arg mod "$module_id" '[ .fixtures[] | select((.module_ids // []) | index($mod)) ]' "$manifest")"
  else
    selected_fixtures="$(jq '.fixtures' "$manifest")"
  fi

  # ── verifies_backlog_item: a CROSS-CHECK, never load-bearing ─────────────
  # When the field is populated and disagrees with the DR join, both sets are
  # named: one of the two documents is stale and bash cannot know which. The
  # DR join wins regardless — that is what the report's selection reflects.
  # When it holds the designer's placeholder (the normal state of a
  # first-recorded manifest), it is ignored in silence: there is no
  # disagreement to report, only a field that was written before the backlog
  # it would have referenced existed.
  if [ -n "$bl_id" ]; then
    local field_populated field_set join_set
    field_populated="$(jq '[ .fixtures[] | select((.verifies_backlog_item // "") | test("BL-[0-9]{3}")) ] | length' "$manifest")"
    if [ "$field_populated" -gt 0 ]; then
      field_set="$(jq -r --arg bl "$bl_id" '[ .fixtures[]
                     | select(((.verifies_backlog_item // "") | [scan("BL-[0-9]{3}")]) | index($bl))
                     | .scenario_id ] | sort | join(", ")' "$manifest")"
      join_set="$(jq -r '[ .[].scenario_id ] | sort | join(", ")' <<< "$selected_fixtures")"
      if [ "$field_set" != "$join_set" ]; then
        warn "Manifest metadata disagrees with the acceptance-basis join for ${bl_id}, and the join is what selection used. The join (${bl_id}'s acceptance basis pins ${item_drs:-no DR rule at all} in rebuild-backlog.md → manifest business_rules_pinned) selects: ${join_set:-none}. The manifest's own verifies_backlog_item field names: ${field_set:-none}. One of the two documents is stale — re-run /specclaw:bf-baseline --record to refresh the field, or fix whichever document is wrong. This changed nothing about this run's selection."
      fi
    fi
  fi

  local count
  count="$(jq 'length' <<< "$selected_fixtures")"
  if [ "$count" -eq 0 ]; then
    case "$kind" in
      module)
        die "No fixture in ${manifest} is tagged with module ${module_id}. Modules that do appear: $(jq -r '[ .fixtures[] | (.module_ids // [])[] ] | unique | join(", ")' "$manifest"). Check the id against .specclaw/analysis/module-map.md, or design and record that module's scenarios first."
        ;;
      item)
        # THE EMPTY-SELECTION CONTRACT. A valid, active backlog item with
        # genuinely no fixtures behind it is a clean result, not a broken
        # precondition: the item exists, the join ran, and it found nothing to
        # compare against. It flows through as a 0-fixture selection and
        # renders as INCOMPLETE (exit 2) — never a crash, and never an
        # invented fixture. A malformed manifest still fails loudly above;
        # the placeholder is neither of these.
        :
        ;;
      *)
        die "No fixtures matched selection for '${target}'${bl_id:+ (${bl_id})} in ${manifest}."
        ;;
    esac
  fi

  # Hash-verify every selected fixture against the manifest's recorded hash.
  # Collect ALL problems before failing — never stop at the first.
  local problems=()
  while IFS= read -r fx; do
    local sid fpath chash
    sid="$(jq -r '.scenario_id' <<< "$fx")"
    fpath="$(jq -r '.fixture_path' <<< "$fx")"
    chash="$(jq -r '.content_hash' <<< "$fx")"

    # Per-entry schema completeness — checked per selected fixture, not just
    # once at the top, because a manifest can carry the right schema number and
    # still be missing a field on the one entry this run actually depends on.
    local fstatus flayer
    fstatus="$(jq -r '.status // ""' <<< "$fx")"
    flayer="$(jq -r '.seam_layer // ""' <<< "$fx")"
    [ -n "$fstatus" ] || problems+=("${sid}: manifest entry has no \"status\" field (VERIFIABLE/PROVISIONAL/SUPERSEDED) — re-run /specclaw:bf-baseline --record")
    [ -n "$flayer" ]  || problems+=("${sid}: manifest entry has no \"seam_layer\" field — the replay layer cannot be enforced against a layer that was never recorded. Re-run /specclaw:bf-baseline --record")

    local full="${project_root}/${fpath}"
    if [ ! -f "$full" ]; then
      problems+=("${sid}: fixture file missing at ${fpath}")
      continue
    fi
    local actual_hash
    actual_hash="sha256:$(sha256sum "$full" 2>/dev/null | awk '{print $1}')"
    if [ "$actual_hash" != "$chash" ]; then
      problems+=("${sid}: hash mismatch — manifest=${chash} actual=${actual_hash}")
    fi
  done < <(jq -c '.[]' <<< "$selected_fixtures")

  if [ "${#problems[@]}" -gt 0 ]; then
    local joined
    joined="$(printf '  - %s\n' "${problems[@]}")"
    die "Baseline check failed — refusing to compare against a tampered or incomplete baseline:
${joined}"
  fi

  # ── Per-fixture BL attribution (`bl_items_resolved`) ─────────────────────
  # Which backlog item(s) each selected fixture actually verifies, derived from
  # the same acceptance-basis join as selection — a SET, never a scalar, because
  # two items' acceptance bases legitimately share a rule. This is what stub
  # taint and the evidence metadata join on from here.
  #
  # It replaces reading `verifies_backlog_item`, which on a correctly-run
  # project holds the placeholder and therefore yielded null for every fixture
  # — silently disabling ST-### taint stamping and leaving
  # `bl_items_covered`/`stub_tainted_items` permanently empty, so
  # `module-status` had nothing to read for any item's latest verdict.
  #
  # The DR join wins wherever it speaks; the field's own BL token is the
  # fallback for a fixture the join can say nothing about — no backlog on disk,
  # or a backlog whose items carry no rule citations to join against.
  #
  # THIS IS NOT THE SELECTION RULE, and the asymmetry is deliberate. For
  # selection the query is one item's own known-good DR set, so an empty result
  # is a real answer ("nothing pins these rules") and the empty-selection
  # contract reports it as such. For attribution the query is the whole
  # backlog, and an empty result means that document carries no rule data at
  # all — an absence of information, not a finding that the fixture verifies
  # nothing. Discarding the recorded field there would lose the only signal
  # left and silently disable taint, which is the very failure mode this whole
  # change exists to fix. Attribution feeds taint and coverage reporting only;
  # it can never move a verdict or a selection.
  selected_fixtures="$(jq --slurpfile drmap_in "$(sc_payload drmap "$dr_map")" '
    ($drmap_in[0]) as $drmap
    | [ .[] | . as $fx
      | ((.business_rules_pinned // "") | [scan("DR-[0-9]{3}")]) as $pinned
      | ([ $drmap | to_entries[]
           | select(.value | any(. as $d | $pinned | index($d)))
           | .key ] | unique) as $via_dr
      | (($fx.verifies_backlog_item // "") | [scan("BL-[0-9]{3}")] | unique) as $via_field
      | $fx + { bl_items_resolved:
                  (if ($via_dr | length) > 0 then $via_dr else $via_field end) } ]
  ' <<< "$selected_fixtures")"

  # How many fixtures each module has IN THE WHOLE MANIFEST, not just in this
  # selection. The report needs it to say whether a module's rollup row is a
  # full picture of that module or a partial one — a change-scoped or
  # single-module run pulls other modules in through shared fixtures, and a row
  # showing 1 of that module's 12 fixtures must not read as its verdict.
  local module_totals_json
  module_totals_json="$(jq '[ .fixtures[] | (.module_ids // [])[] ] | group_by(.) | map({key: .[0], value: length}) | from_entries' "$manifest")"

  # ── Stub taint stamping (CONTRACT.md (m.3)) ──────────────────────────────
  # A pure join on declared data, in the same tier as the module_ids join
  # above: a fixture is tainted when the BL item it verifies appears in the
  # `Consumed by` field of an ACTIVE registry entry. Nothing is inferred, and
  # NOTHING HERE TOUCHES A VERDICT — stub_refs rides alongside the fixture,
  # exactly as fixture_status does, and `compare` carries it without reading
  # it. A tainted run reaches the same verdict and the same exit code it
  # would have reached with no registry at all; it just says so.
  local stubs_all stubs_active
  stubs_all="$(stubs_json "$specclaw_dir_abs/analysis/module-stubs.md")"
  stubs_active="$(jq '[ .[] | select(.status == "ACTIVE") ]' <<< "$stubs_all")"

  # Joins on `bl_items_resolved` (above), ANY-of: a fixture verifying either of
  # two items is tainted by a stub either of them consumed.
  selected_fixtures="$(jq --slurpfile stubs_in "$(sc_payload stubs "$stubs_active")" '
    ($stubs_in[0]) as $stubs
    | [ .[] | . as $fx
      | ($fx.bl_items_resolved // []) as $bls
      | $fx + { stub_refs:
          [ $stubs[] | select(.consumed_by | any(. as $c | $bls | index($c))) | .id ] } ]
  ' <<< "$selected_fixtures")"

  # The entries actually hit by THIS run's selection — not the whole registry.
  # A stub faking a module nobody in this selection consumes is irrelevant to
  # this report and naming it would pad the honesty signal into noise.
  local stubs_in_effect retirement_candidates
  stubs_in_effect="$(jq --slurpfile sel_in "$(sc_payload sel "$selected_fixtures")" '
    ($sel_in[0]) as $sel
    | [ .[] as $s
      | ([ $sel[] | select((.stub_refs // []) | index($s.id)) | .scenario_id ]) as $hits
      | select(($hits | length) > 0)
      | {id: $s.id, summary: $s.summary, substitutes: $s.substitutes,
         strategy: $s.strategy, fakes: $s.fakes, fixtures: $hits} ]
  ' <<< "$stubs_active")"

  # RETIRING entries do NOT taint — the stub is genuinely gone. But naming
  # them is what makes a clean run legible as the run that retires one
  # (CONTRACT.md (m.4)), rather than an ordinary PASS someone has to correlate
  # with a registry edit by hand.
  local selected_bls
  selected_bls="$(jq '[ .[] | (.bl_items_resolved // [])[] ] | unique' <<< "$selected_fixtures")"
  retirement_candidates="$(jq -n \
    --slurpfile all_in "$(sc_payload stubs_all "$stubs_all")" \
    --slurpfile bls_in "$(sc_payload bls "$selected_bls")" '
    ($all_in[0]) as $all
    | ($bls_in[0]) as $bls
    | [ $all[] | select(.status == "RETIRING")
      | . as $s | select([ $s.consumed_by[] | select(. as $b | $bls | index($b)) ] | length > 0)
      | {id: $s.id, summary: $s.summary, substitutes: $s.substitutes,
         strategy: $s.strategy,
         consumers_in_run: [ $s.consumed_by[] | select(. as $b | $bls | index($b)) ]} ]
  ')"

  # A declared mock seed is a WARN source, never an assertion (CONTRACT.md
  # (m.5)): nothing observes which data a running application loaded, so this
  # can only say "the file you said you were retiring is still on disk."
  while IFS= read -r seed_line; do
    [ -z "$seed_line" ] && continue
    local seed_id="${seed_line%%$'\t'*}" seed_path="${seed_line#*$'\t'}"
    if [ -n "$seed_path" ] && [ -e "${project_root}/${seed_path}" ]; then
      warn "${seed_id} is ${seed_path:+}no longer ACTIVE but its declared mock seed still exists at ${seed_path}. Nothing here can tell whether it was loaded during this run — this is a prompt to check, not a finding."
    fi
  done < <(jq -r '.[] | select(.status == "RETIRING" or .status == "RETIRED")
                       | select(.strategy == "mock-data")
                       | select((.mock_seed // "") != "")
                       | .id + "\t" + .mock_seed' <<< "$stubs_all")

  # ── Item-split partition (CONTRACT.md (o.4)) ─────────────────────────────
  #
  # Which of this run's selected fixtures cover scope that was DEFERRED, and
  # which cover scope that was actually built. A pure join on the split's own
  # declared `Rules deferred` against each fixture's `business_rules_pinned` —
  # the same tier as the module_ids join, no agent, nothing re-derived, and
  # nothing that touches a verdict.
  #
  # The partition is declared rather than inferred precisely so this join can
  # exist: without `Rules implemented`/`Rules deferred` on the entry, the only
  # way to answer "is this fixture testing something we built?" would be an
  # agent reading prose at run time, which is exactly what this pipeline keeps
  # out of every other verdict-adjacent decision.
  #
  # DELIBERATELY NOT AN EXCLUSION. A fixture pinning a deferred rule still runs
  # and still counts toward the verdict. Dropping it from the exercised set
  # would change what a run FAILs on, which is the one thing a completeness
  # marker must never do — and it would hide a real regression behind a scope
  # note. The report says instead which fixtures those are, so a FAIL among
  # them is explained and a PASS among them is a surprise worth investigating.
  local item_split_json="null"
  if [ -n "$bl_id" ]; then
    local splits_all
    splits_all="$(splits_json "$specclaw_dir_abs/analysis/item-splits.md")"
    item_split_json="$(jq -c --arg bl "$bl_id" \
      --slurpfile sel_in "$(sc_payload item_split_sel "$selected_fixtures")" '
      ($sel_in[0]) as $sel
      | [ .[] | select(.item == $bl)
            | select(.status == "ACTIVE" or .status == "READY-TO-RESUME") ] as $open
      | if ($open | length) == 0 then null
        else ($open[0]) as $s
          | ([ $sel[] | . as $fx
               | select(((($fx.business_rules_pinned // "") | [scan("DR-[0-9]{3}")]))
                        | any(. as $d | $s.rules_deferred | index($d)))
               | $fx.scenario_id ]) as $def
          | { id: $s.id, status: $s.status, summary: $s.summary,
              deferred: $s.deferred,
              rules_deferred: $s.rules_deferred,
              rules_implemented: $s.rules_implemented,
              blocked_until: $s.blocked_until,
              replay_evidence: $s.replay_evidence,
              fixtures_covering_deferred: $def,
              fixtures_covering_built:
                ([ $sel[].scenario_id ] - $def) }
        end' <<< "$splits_all" 2>/dev/null || echo 'null')"
    [ -n "$item_split_json" ] || item_split_json="null"
  fi

  local dr_rules_json legacy_shas_json
  dr_rules_json="$(jq '[ .[].business_rules_pinned ] | join(" ") | [scan("DR-[0-9]{3}")] | unique' <<< "$selected_fixtures")"
  legacy_shas_json="$(jq '[ .[].legacy_commit_sha ] | unique' <<< "$selected_fixtures")"
  local sha_count
  sha_count="$(jq 'length' <<< "$legacy_shas_json")"
  [ "$sha_count" -gt 1 ] && warn "Selected fixtures were captured across multiple legacy commit SHAs: $(jq -r 'join(", ")' <<< "$legacy_shas_json")."

  mkdir -p "$(dirname "$out_path")"
  jq -n \
    --arg target "$target" \
    --arg bl "$bl_id" \
    --arg module "$module_id" \
    --arg kind "$kind" \
    --slurpfile fixtures_in "$(sc_payload fixtures "$selected_fixtures")" \
    --slurpfile dr_rules_in "$(sc_payload dr_rules "$dr_rules_json")" \
    --slurpfile legacy_shas_in "$(sc_payload legacy_shas "$legacy_shas_json")" \
    --slurpfile module_totals_in "$(sc_payload module_totals "$module_totals_json")" \
    --argjson count "$count" \
    --argjson manifest_schema "$manifest_schema" \
    --arg manifest_plugin_version "${manifest_plugin_version:-unknown}" \
    --slurpfile stubs_in_effect_in "$(sc_payload stubs_effect "$stubs_in_effect")" \
    --slurpfile retirement_candidates_in "$(sc_payload retirement "$retirement_candidates")" \
    --slurpfile item_split_in "$(sc_payload item_split "$item_split_json")" \
    '($fixtures_in[0]) as $fixtures
    | ($dr_rules_in[0]) as $dr_rules
    | ($legacy_shas_in[0]) as $legacy_shas
    | ($module_totals_in[0]) as $module_totals
    | ($stubs_in_effect_in[0]) as $stubs_in_effect
    | ($retirement_candidates_in[0]) as $retirement_candidates
    | ($item_split_in[0]) as $item_split
    | {
      target: $target,
      target_kind: $kind,
      bl_item: (if $bl == "" then null else $bl end),
      module: (if $module == "" then null else $module end),
      manifest_schema: $manifest_schema,
      manifest_plugin_version: $manifest_plugin_version,
      selected_count: $count,
      module_totals: $module_totals,
      dr_rules_covered: $dr_rules,
      legacy_commit_shas: $legacy_shas,
      legacy_commit_sha: $legacy_shas[0],
      stubs_in_effect: $stubs_in_effect,
      retirement_candidates: $retirement_candidates,
      item_split: $item_split,
      fixtures: $fixtures
    }' > "$out_path"

  # The empty-selection contract's own summary line. Stated before any of the
  # notes below, none of which can apply to a selection of nothing.
  if [ "$count" -eq 0 ]; then
    echo "NO BASELINE DATA — 0 fixtures mapped to ${bl_id}. The item is active and its acceptance basis pins ${item_drs:-no DR rule at all}, but no recorded fixture pins any of those rules — so there is nothing to compare against. This run will report INCOMPLETE (exit 2) rather than a PASS with nothing behind it."
    return 0
  fi

  local shared_note=""
  if [ -n "$module_id" ]; then
    local shared_n
    shared_n="$(jq --arg mod "$module_id" '[ .[] | select(((.module_ids // []) | length) > 1) ] | length' <<< "$selected_fixtures")"
    shared_note=" ${shared_n} of them also belong to another module (shared cross-module flows, selected by both)."
  fi
  local stub_note=""
  local tainted_n st_ids
  tainted_n="$(jq '[ .[] | select(((.stub_refs // []) | length) > 0) ] | length' <<< "$selected_fixtures")"
  if [ "$tainted_n" -gt 0 ]; then
    st_ids="$(jq -r '[ .[].id ] | join(", ")' <<< "$stubs_in_effect")"
    stub_note=" ${tainted_n} of them verify an item built against an active bypass stub (${st_ids}) and will be reported as stub-tainted."
  fi
  # An item run's target IS its BL id — "for BL-020 (BL-020)" would be noise.
  local bl_note=""
  [ -n "$bl_id" ] && [ "$bl_id" != "$target" ] && bl_note=" (${bl_id})"
  local split_note=""
  if [ "$item_split_json" != "null" ]; then
    local sp_id sp_status sp_def_n
    sp_id="$(jq -r '.id' <<< "$item_split_json" | tr -d '')"
    sp_status="$(jq -r '.status' <<< "$item_split_json" | tr -d '')"
    sp_def_n="$(jq -r '.fixtures_covering_deferred | length' <<< "$item_split_json" | tr -d '')"
    split_note=" ${bl_id} is PARTIALLY BUILT under split ${sp_id} (${sp_status}): ${sp_def_n} of ${count} selected fixture(s) pin rules that split declared deferred, so this run is not ${bl_id}'s final acceptance."
  fi
  echo "Selected ${count} fixture(s) for ${target}${bl_note}.${shared_note}${stub_note}${split_note} DR rules covered: $(jq -r 'join(", ")' <<< "$dr_rules_json"). Legacy commit: $(jq -r '.[0]' <<< "$legacy_shas_json")."
}

# ─── Subcommand: parse-target ────────────────────────────────────────────────
# The four selection scopes are MUTUALLY EXCLUSIVE, and deciding whether an
# invocation is legal is a mechanical job — so it happens here, in bash, rather
# than being left to the skill's prose to remember. Given the raw invocation it
# either prints the ONE canonical target token every other subcommand takes
# (`<change-name>` | `BL-###` | `MOD-###` | `--all`) or fails loudly naming the
# conflict. Retention flags are accepted and ignored: `--keep`/`--discard`/
# `--prune-evidence <n>` qualify a run, they do not select one, and they
# legitimately combine with any scope.

cmd_parse_target() {
  local -a argv=("$@")
  local -a scopes=() scope_flags=()
  local positional="" a v i=0 n="${#argv[@]}"

  while [ "$i" -lt "$n" ]; do
    a="${argv[$i]}"
    case "$a" in
      --all)
        scopes+=("--all"); scope_flags+=("--all")
        ;;
      --item)
        i=$((i + 1))
        [ "$i" -lt "$n" ] || die "--item requires a BL-### backlog item id (e.g. --item BL-020); none was given."
        v="${argv[$i]}"
        [[ "$v" =~ ^BL-[0-9]{3}$ ]] || die "--item expects a BL-### id with exactly three digits; got '${v}'."
        scopes+=("$v"); scope_flags+=("--item ${v}")
        ;;
      --module)
        i=$((i + 1))
        [ "$i" -lt "$n" ] || die "--module requires a MOD-### module id (e.g. --module MOD-001); none was given."
        v="${argv[$i]}"
        [[ "$v" =~ ^MOD-[0-9]{3}$ ]] || die "--module expects a MOD-### id with exactly three digits; got '${v}'."
        scopes+=("$v"); scope_flags+=("--module ${v}")
        ;;
      --keep|--discard) ;;
      --prune-evidence)
        # Consume its count so a bare number is never mistaken for a change
        # name. Its validity is prune-evidence's own business, not this one's.
        i=$((i + 1))
        ;;
      -*)
        die "Unknown option '${a}'. Valid scopes: <change-name> | --item BL-### | --module MOD-### | --all. Valid qualifiers: --keep, --discard, --prune-evidence <n>."
        ;;
      *)
        [ -z "$positional" ] || die "Two positional targets given ('${positional}' and '${a}'), but a run has exactly one scope. Pass a single <change-name>, or one of --item BL-### / --module MOD-### / --all."
        positional="$a"
        ;;
    esac
    i=$((i + 1))
  done

  # Flags combine with nothing — not with each other, and not with a positional.
  if [ "${#scopes[@]}" -gt 1 ]; then
    die "The four selection scopes are mutually exclusive, but ${#scopes[@]} were given: ${scope_flags[*]}. Pick one — <change-name> for a change's own backlog item, --item BL-### for one backlog item, --module MOD-### for one module, --all for the whole corpus."
  fi
  if [ -n "$positional" ] && [ "${#scopes[@]}" -gt 0 ]; then
    die "A positional <change-name> ('${positional}') combines with no scope flag, but ${scope_flags[*]} was also given. A change already names its own backlog item; pass either the change or the flag, never both."
  fi
  if [ -z "$positional" ] && [ "${#scopes[@]}" -eq 0 ]; then
    die "No selection scope given. Pass one of: <change-name> | --item BL-### | --module MOD-### | --all."
  fi

  printf '%s\n' "${positional:-${scopes[0]}}"
}

# ─── Subcommand: init-rundir ─────────────────────────────────────────────────

cmd_init_rundir() {
  local specclaw_dir="$1" run_dir="$2"
  [ -d "$specclaw_dir" ] || die "specclaw directory not found: $specclaw_dir"

  mkdir -p "$run_dir/actual"

  # Stub per CONTRACT.md — the replay-mapper agent identifies the rebuild's
  # own stack and completes every field itself; this script never guesses a
  # build/test command or a project layout for any stack.
  cat > "$run_dir/run-config.json" <<'ENDJSON'
{
  "stack": null,
  "build_command": null,
  "test_command": null,
  "results_dir": "actual",
  "evidence_exclusions": []
}
ENDJSON

  echo "Initialized run directory: ${run_dir}"
  echo "Wrote run-config.json (stub) — the replay-mapper agent must complete stack/build_command/test_command/evidence_exclusions per CONTRACT.md before 'run-tests' can proceed."
}

# ─── Subcommand: run-tests ───────────────────────────────────────────────────

cmd_run_tests() {
  require_jq
  local specclaw_dir="$1" run_dir="$2"
  [ -d "$run_dir" ] || die "Run directory not found: ${run_dir}"

  local project_root
  project_root="$(cd "$specclaw_dir/.." && pwd)"

  local config_file="$run_dir/run-config.json"
  [ -f "$config_file" ] || die "run-config.json not found in ${run_dir} — run 'init-rundir' first."
  jq -e . "$config_file" >/dev/null 2>&1 || die "run-config.json in ${run_dir} is not valid JSON."

  local build_command test_command
  build_command="$(jq -r '.build_command // empty' "$config_file")"
  test_command="$(jq -r '.test_command // empty' "$config_file")"
  [ -n "$test_command" ] || die "run-config.json's test_command is still null — the replay-mapper agent never completed run-config.json."

  local build_log="$run_dir/build.log"
  local test_log="$run_dir/test.log"

  if [ -n "$build_command" ]; then
    echo "Building (${build_command}) ..."
    if ! ( cd "$project_root" && eval "$build_command" ) > "$build_log" 2>&1; then
      tail -100 "$build_log" >&2
      die "Build command failed — see ${build_log}. No fixtures can be replayed until this is fixed."
    fi
  fi

  echo "Running tests (${test_command}) ..."
  local test_rc=0
  ( cd "$project_root" && eval "$test_command" ) > "$test_log" 2>&1 || test_rc=$?

  local total_lines
  total_lines=$(wc -l < "$test_log")
  if [ "$total_lines" -gt 200 ]; then
    tail -200 "$test_log"
    echo "... (truncated, ${total_lines} total lines; full log at ${test_log})"
  else
    cat "$test_log"
  fi

  local results_dir actual_dir actual_count
  results_dir="$(jq -r '.results_dir // "actual"' "$config_file")"
  actual_dir="$run_dir/$results_dir"
  actual_count=$(find "$actual_dir" -name "*.json" 2>/dev/null | wc -l)
  echo "Test command exit code: ${test_rc}. Actual-result files written: ${actual_count}."
}

# ─── Subcommand: compare ─────────────────────────────────────────────────────
# Deterministic field-by-field diff. Never asserted by an agent.

# The field-by-field diff, its per-field classification, and the resolution of
# this fixture's normalized_fields against the ACTUAL output — one jq call over
# the shared library (CONTRACT.md (g), (j.1)). Nothing about the comparison is
# reimplemented here; this function only wires the inputs together.
compute_diffs() {
  local expected_json="$1" actual_json="$2" normalized_json="$3"
  jq -n \
    --slurpfile expected_in "$(sc_payload expected "$expected_json")" \
    --slurpfile actual_in "$(sc_payload actual "$actual_json")" \
    --argjson normalized "$normalized_json" \
    "$GM_PATHS_JQ"'
      ($expected_in[0]) as $expected
      | ($actual_in[0]) as $actual
      | gm_diffs($expected; $actual; $normalized) as $d
      | { diffs: $d,
          divergence_class: gm_divergence_class($d),
          normalization_warnings:
            [ gm_resolution_report($normalized; $actual)[]
              | select(.matches == 0)
              | {path: .path, matched: 0, suggestions: .suggestions, against: "actual"} ] }
    '
}

cmd_compare() {
  require_jq
  load_gm_paths
  local specclaw_dir="$1" run_dir="$2"
  local project_root
  project_root="$(cd "$specclaw_dir/.." && pwd)"

  local selection="$run_dir/selection.json" mapping="$run_dir/mapping.json"
  [ -f "$selection" ] || die "selection.json not found in ${run_dir} — run 'resolve' first."
  [ -f "$mapping" ] || die "mapping.json not found in ${run_dir} — the replay-mapper agent must run first."
  jq -e . "$mapping" >/dev/null 2>&1 || die "mapping.json in ${run_dir} is not valid JSON."

  local results="[]"
  while IFS= read -r entry; do
    local sid verdict
    sid="$(jq -r '.scenario_id' <<< "$entry")"
    verdict="$(jq -r '.verdict' <<< "$entry")"

    # Carried from selection.json, never computed here and never read by any
    # verdict expression below — the same treatment fixture_status gets. It
    # is attached to EVERY row, including NOT REPLAYABLE ones: a fixture
    # verifying a stub-backed item is stub-backed whether or not this run
    # managed to exercise it. `render` is what filters to exercised rows.
    local stub_refs
    stub_refs="$(jq -c --arg sid "$sid" '(.fixtures[] | select(.scenario_id==$sid) | .stub_refs) // []' "$selection" 2>/dev/null || echo '[]')"
    [ -n "$stub_refs" ] || stub_refs='[]'

    if [ "$verdict" != "REPLAYABLE" ]; then
      results="$(jq --argjson e "$entry" --argjson st "$stub_refs" '. + [{
        scenario_id: $e.scenario_id, verdict: "NOT REPLAYABLE",
        reason: ($e.reason // "no reason recorded"),
        category: ($e.category // "other"),
        remediation: ($e.remediation // null),
        stub_refs: $st
      }]' <<< "$results")"
      continue
    fi

    local fixture_path normalized_fields fixture_status legacy_layer
    fixture_path="$(jq -r --arg sid "$sid" '.fixtures[] | select(.scenario_id==$sid) | .fixture_path' "$selection")"
    normalized_fields="$(jq -c --arg sid "$sid" '.fixtures[] | select(.scenario_id==$sid) | .normalized_fields' "$selection")"
    # Per templates/CONTRACT.md (c'): flows through from manifest.json's own
    # fixture-entry status/seam_layer fields, via selection.json, untouched by
    # resolve. `resolve` has already refused to run if either is absent, so
    # there is deliberately no default applied here.
    fixture_status="$(jq -r --arg sid "$sid" '.fixtures[] | select(.scenario_id==$sid) | .status' "$selection")"
    legacy_layer="$(jq -r --arg sid "$sid" '.fixtures[] | select(.scenario_id==$sid) | .seam_layer' "$selection")"

    # ── Seam-layer re-verification (CONTRACT.md (i)) ─────────────────────
    # Same trust model as sanction-check re-verifying the auditor: the
    # authoritative legacy layer is the manifest's, read here from
    # selection.json — never the copy the agent put in mapping.json, which is
    # checked against it rather than believed. A layer mismatch is forced to
    # NOT REPLAYABLE regardless of the agent's REPLAYABLE claim, because a
    # fixture replayed at another layer measures transport and middleware
    # instead of the business rule it pins.
    local claimed_legacy replay_layer seam_problem=""
    claimed_legacy="$(jq -r '.legacy_seam_layer // ""' <<< "$entry")"
    replay_layer="$(jq -r '.replay_seam_layer // ""' <<< "$entry")"

    if [ -z "$legacy_layer" ] || [ "$legacy_layer" = "null" ]; then
      seam_problem="mapping.json claims this fixture is replayable, but it is not in this run's selection at all — there is no captured seam layer to replay against."
    elif [ -z "$replay_layer" ]; then
      seam_problem="mapping.json declares no replay_seam_layer for this fixture, so the layer the generated test targets is unknown. The fixture was captured at '${legacy_layer}'."
    elif [ -n "$claimed_legacy" ] && [ "$claimed_legacy" != "$legacy_layer" ]; then
      seam_problem="mapping.json records legacy_seam_layer '${claimed_legacy}', but the manifest recorded this fixture at '${legacy_layer}'. The legacy layer is copied, never re-derived."
    elif [ "$replay_layer" != "$legacy_layer" ]; then
      seam_problem="captured at '${legacy_layer}', replayed at '${replay_layer}'."
    fi

    if [ -n "$seam_problem" ]; then
      results="$(jq \
        --arg sid "$sid" --arg status "$fixture_status" \
        --arg legacy "$legacy_layer" --arg replay "$replay_layer" \
        --argjson st "$stub_refs" \
        --arg reason "$seam_problem" '. + [{
          scenario_id: $sid, verdict: "NOT REPLAYABLE", category: "seam-mismatch",
          fixture_status: $status, stub_refs: $st,
          legacy_seam_layer: $legacy,
          replay_seam_layer: (if $replay == "" then null else $replay end),
          reason: ("Seam-layer mismatch — " + $reason),
          remediation: ("Generate the replay test against the rebuild'"'"'s " + $legacy + " layer. If no equivalent " + $legacy + " seam exists in the rebuild, that is the finding to report — replaying through whichever layer happens to be reachable measures something else.")
        }]' <<< "$results")"
      continue
    fi

    local full_fixture="${project_root}/${fixture_path}"
    local actual_file="${run_dir}/actual/${sid}.json"

    if [ ! -f "$actual_file" ]; then
      results="$(jq --arg sid "$sid" --arg status "$fixture_status" --argjson st "$stub_refs" '. + [{scenario_id: $sid, verdict: "ERROR", detail: "No actual-result file written — the generated test crashed or did not run to completion.", fixture_status: $status, stub_refs: $st}]' <<< "$results")"
      continue
    fi
    if ! jq -e . "$actual_file" >/dev/null 2>&1; then
      results="$(jq --arg sid "$sid" --arg status "$fixture_status" --argjson st "$stub_refs" '. + [{scenario_id: $sid, verdict: "ERROR", detail: "actual-result file is not valid JSON.", fixture_status: $status, stub_refs: $st}]' <<< "$results")"
      continue
    fi

    local expected_output actual_output analysis
    expected_output="$(jq -c '.output' "$full_fixture")"
    actual_output="$(jq -c '.output' "$actual_file")"
    analysis="$(compute_diffs "$expected_output" "$actual_output" "$normalized_fields")"

    results="$(jq \
      --arg sid "$sid" --arg status "$fixture_status" --arg layer "$legacy_layer" \
      --argjson st "$stub_refs" \
      --slurpfile a_in "$(sc_payload analysis "$analysis")" '
      ($a_in[0]) as $a
      | . + [
        (if ($a.diffs | length) == 0
         then {scenario_id: $sid, verdict: "MATCH", fixture_status: $status, stub_refs: $st, seam_layer: $layer}
         else {scenario_id: $sid, verdict: "DIVERGES", fixture_status: $status, stub_refs: $st, seam_layer: $layer,
               divergence_class: $a.divergence_class, diffs: $a.diffs}
         end)
        + (if ($a.normalization_warnings | length) > 0
           then {normalization_warnings: $a.normalization_warnings} else {} end)
      ]' <<< "$results")"
  done < <(jq -c '.[]' "$mapping")

  local this_version
  this_version="$(plugin_version_of_this_run)"

  jq -n --slurpfile results_in "$(sc_payload results "$results")" --arg pv "$this_version" '
    ($results_in[0]) as $results
    | {
      compare_schema: 2,
      plugin_version: $pv,
      results: $results,
      summary: {
        match:               ([$results[] | select(.verdict=="MATCH")] | length),
        behavioural:         ([$results[] | select(.divergence_class=="behavioural")] | length),
        representation:      ([$results[] | select(.divergence_class=="representation")] | length),
        unmapped_error_code: ([$results[] | select(.divergence_class=="unmapped-error-code")] | length),
        error:               ([$results[] | select(.verdict=="ERROR")] | length),
        seam_mismatch:       ([$results[] | select(.category=="seam-mismatch")] | length),
        not_replayable_other:([$results[] | select(.verdict=="NOT REPLAYABLE" and .category!="seam-mismatch")] | length),
        normalization_warnings: ([$results[] | (.normalization_warnings // [])[]] | length),
        stub_tainted: ([$results[] | select(((.stub_refs // []) | length) > 0)] | length)
      }
    }' > "$run_dir/compare.json"

  local s
  s="$(jq -r '.summary | "MATCH=\(.match) BEHAVIOURAL=\(.behavioural) REPRESENTATION=\(.representation) UNMAPPED_ERROR_CODE=\(.unmapped_error_code) ERROR=\(.error) SEAM_MISMATCH=\(.seam_mismatch) NOT_REPLAYABLE=\(.not_replayable_other)"' "$run_dir/compare.json")"
  local prov_n warn_n
  prov_n=$(jq '[.results[] | select(.fixture_status=="PROVISIONAL")] | length' "$run_dir/compare.json")
  warn_n=$(jq '.summary.normalization_warnings' "$run_dir/compare.json")
  echo "Compare complete: ${s} (${prov_n} exercised fixture(s) PROVISIONAL, ${warn_n} normalization warning(s) — see render's overall verdict)"
}

# ─── Subcommand: sanction-check ──────────────────────────────────────────────

cmd_sanction_check() {
  require_jq
  local specclaw_dir="$1" run_dir="$2"
  local decisions="$specclaw_dir/analysis/decisions.md"
  local compare_file="$run_dir/compare.json"
  local sanction_file="$run_dir/sanction.json"
  [ -f "$compare_file" ] || die "compare.json not found in ${run_dir} — run 'compare' first."

  # Only BEHAVIOURAL divergences are sanctionable (CONTRACT.md (j.2)). A row
  # where only the raw exception type or message differed is the same business
  # decision expressed differently — asking a human to record a product
  # decision about it would be asking the wrong question.
  local diverges_n
  diverges_n=$(jq '[.results[] | select(.divergence_class=="behavioural")] | length' "$compare_file")
  if [ "$diverges_n" = "0" ]; then
    echo '{"sanctions": []}' > "$run_dir/sanction-verified.json"
    echo "No behavioural divergences — nothing to sanction-check."
    return 0
  fi

  [ -f "$sanction_file" ] || die "sanction.json not found in ${run_dir} — the replay-auditor agent must run first (${diverges_n} behavioural divergence(s) to review)."
  jq -e . "$sanction_file" >/dev/null 2>&1 || die "sanction.json in ${run_dir} is not valid JSON."

  local decisions_present=true
  [ -f "$decisions" ] || { decisions_present=false; warn "decisions.md not found at ${decisions} — every DIVERGES is therefore UNSANCTIONED."; }

  local verified="[]"
  while IFS= read -r entry; do
    local sid cq
    sid="$(jq -r '.scenario_id' <<< "$entry")"
    cq="$(jq -r '.cq_id // ""' <<< "$entry")"

    local cq_exists=false note=""
    if $decisions_present && [ -n "$cq" ] && [ "$cq" != "null" ]; then
      if grep -qE "^### ${cq} " "$decisions"; then
        cq_exists=true
      else
        note="Cited ${cq} has no '### ${cq} —' heading under decisions.md — not a decided item; treating as unsanctioned."
      fi
    fi

    local rule_match=false
    if $cq_exists; then
      local dr_rule dr_token block
      dr_rule="$(jq -r --arg sid "$sid" '[.fixtures[]? | select(.scenario_id==$sid) | .business_rules_pinned] | first // ""' "$run_dir/selection.json" 2>/dev/null || true)"
      dr_token="$(printf '%s' "$dr_rule" | grep -oE 'DR-[0-9]{3}' | head -1 || true)"
      if [ -n "$dr_token" ]; then
        block="$(extract_heading_block "$decisions" "$cq")"
        if printf '%s' "$block" | grep -qF "$dr_token"; then
          rule_match=true
        else
          note="${note} ${cq}'s decision block does not mention ${dr_token} — citation accepted but unverified against the specific rule; human review recommended."
        fi
      fi
    fi

    local final_sanctioned=false
    if $cq_exists; then
      final_sanctioned=true
    else
      [ -z "$note" ] && note="Agent did not cite a decided CQ for this divergence — unsanctioned."
    fi

    verified="$(jq \
      --arg sid "$sid" \
      --argjson sanctioned "$final_sanctioned" \
      --arg cq "$cq" \
      --argjson cq_verified "$cq_exists" \
      --argjson rule_match "$rule_match" \
      --arg note "$note" \
      '. + [{
        scenario_id: $sid,
        sanctioned: $sanctioned,
        cq_id: (if $cq == "" then null else $cq end),
        cq_verified: $cq_verified,
        rule_citation_matched: $rule_match,
        note: (if $note == "" then null else $note end)
      }]' <<< "$verified")"
  done < <(jq -c '.[]' "$sanction_file")

  jq -n --slurpfile sanctions_in "$(sc_payload sanctions "$verified")" \
    '($sanctions_in[0]) as $sanctions | {sanctions: $sanctions}' > "$run_dir/sanction-verified.json"

  local sanctioned_n unsanctioned_n
  sanctioned_n=$(jq '[.sanctions[] | select(.sanctioned==true)] | length' "$run_dir/sanction-verified.json")
  unsanctioned_n=$(jq '[.sanctions[] | select(.sanctioned==false)] | length' "$run_dir/sanction-verified.json")
  echo "Sanction check complete: ${sanctioned_n} sanctioned, ${unsanctioned_n} unsanctioned (of ${diverges_n} behavioural divergence(s))."
}

# ─── Evidence retention helpers ──────────────────────────────────────────────
# Retention is the default (see `finalize` below): every run's generated
# tests + results are curated into a durable evidence folder instead of the
# throwaway run directory being deleted. These helpers are shared by
# `render` (which only needs the *path*, to print it in the report, before
# the folder itself necessarily exists) and `finalize`/`prune-evidence`
# (which populate/list/prune it) — kept as pure path/JSON computations, not
# threaded through argv, same convention as this script's other bins'
# "recompute independently, it's cheap" pattern.

run_id_from_dir() {
  local run_dir="$1" run_id
  run_id="$(basename "$run_dir")"
  printf '%s' "${run_id#run-}"
}

# Evidence directory, relative to the project root — for display in the
# report and for the .gitignore check (git check-ignore wants a repo-
# relative path, not an absolute one).
# A MODULE run's evidence shares the corpus-wide pool rather than getting a
# directory of its own, and the module it covered is recorded in that run's
# own run-metadata.json. A module is not a change: it has no
# .specclaw/changes/<name>/ to live under, and giving it a parallel tree would
# fork the evidence layout for a selection dimension — the module is a
# property of the run, not a new place to keep runs.
# An ITEM run shares the corpus-wide pool for exactly the same reason a module
# run does: a backlog item is not a change. It has no
# .specclaw/changes/<name>/ to live under, and giving it a parallel tree would
# fork the evidence layout for a third selection dimension. The item it covered
# is recorded in that run's own run-metadata.json.
evidence_dir_rel() {
  local target="$1" run_id="$2"
  case "$(target_kind "$target")" in
    all|module|item) printf '.specclaw/replay/evidence/run-%s' "$run_id" ;;
    *)               printf '.specclaw/changes/%s/replay-evidence/run-%s' "$target" "$run_id" ;;
  esac
}

evidence_dir_abs() {
  local specclaw_dir_abs="$1" target="$2" run_id="$3"
  case "$(target_kind "$target")" in
    all|module|item) printf '%s/replay/evidence/run-%s' "$specclaw_dir_abs" "$run_id" ;;
    *)               printf '%s/changes/%s/replay-evidence/run-%s' "$specclaw_dir_abs" "$target" "$run_id" ;;
  esac
}

evidence_root_abs() {
  local specclaw_dir_abs="$1" target="$2"
  case "$(target_kind "$target")" in
    all|module|item) printf '%s/replay/evidence' "$specclaw_dir_abs" ;;
    *)               printf '%s/changes/%s/replay-evidence' "$specclaw_dir_abs" "$target" ;;
  esac
}

# The report path for a run. A module or item run gets its own suffixed
# filename in the shared replay directory so several of them coexist without
# one overwriting another, and so the filename itself says what it covers.
report_path_abs() {
  local specclaw_dir_abs="$1" target="$2" run_id="$3"
  case "$(target_kind "$target")" in
    all)         printf '%s/replay/report-%s.md' "$specclaw_dir_abs" "$run_id" ;;
    module|item) printf '%s/replay/report-%s-%s.md' "$specclaw_dir_abs" "$run_id" "$target" ;;
    *)           printf '%s/changes/%s/replay-report.md' "$specclaw_dir_abs" "$target" ;;
  esac
}

# Per-verdict counts + overall PASS/FAIL/INCOMPLETE, independently
# recomputed from compare.json (+ sanction-verified.json, if present) for
# evidence purposes (run-metadata.json, evidence-summary.md). Deliberately
# NOT wired into `cmd_render`'s own (pre-existing, untouched) computation
# of the same numbers — two independent readers of the same source files,
# not a shared refactor, so this addition can never perturb render's
# existing byte-for-byte behaviour.
compute_verdict_summary() {
  local compare_file="$1" sanction_file="$2" selected_count="$3"
  local merged
  if [ ! -f "$compare_file" ]; then
    # A 0-fixture selection never reached `compare`, so there is nothing to
    # read. Same reasoning as cmd_render's own empty-selection branch, reached
    # independently here — these two readers must agree on the verdict without
    # sharing code, which is the whole point of keeping them separate.
    merged='[]'
  elif [ -n "$sanction_file" ] && [ -f "$sanction_file" ]; then
    merged=$(jq --slurpfile s "$sanction_file" '
      (.results) as $r
      | ($s[0].sanctions // []) as $sc
      | [ $r[] | . as $row
          | if $row.divergence_class == "behavioural" then
              ( ($sc[] | select(.scenario_id == $row.scenario_id)) // {sanctioned:false} ) as $m
              | $row + {sanctioned: $m.sanctioned}
            else $row end
        ]
    ' "$compare_file")
  else
    merged=$(jq '[ .results[] | if .divergence_class == "behavioural" then . + {sanctioned:false} else . end ]' "$compare_file")
  fi

  jq -n --slurpfile merged_in "$(sc_payload verdict_merged "$merged")" --argjson selected "$selected_count" '
    ($merged_in[0]) as $merged
    | def exercised: (.verdict=="MATCH" or .verdict=="DIVERGES" or .verdict=="ERROR");
    {
      match: ([$merged[] | select(.verdict=="MATCH")] | length),
      sanctioned: ([$merged[] | select(.divergence_class=="behavioural" and .sanctioned==true)] | length),
      diverged: ([$merged[] | select(.divergence_class=="behavioural" and (.sanctioned!=true))] | length),
      representation: ([$merged[] | select(.divergence_class=="representation")] | length),
      unmapped_error_code: ([$merged[] | select(.divergence_class=="unmapped-error-code")] | length),
      error: ([$merged[] | select(.verdict=="ERROR")] | length),
      seam_mismatch: ([$merged[] | select(.category=="seam-mismatch")] | length),
      not_replayable: ([$merged[] | select(.verdict=="NOT REPLAYABLE")] | length),
      provisional_exercised: ([$merged[] | select(exercised and .fixture_status=="PROVISIONAL")] | length),
      superseded_exercised: ([$merged[] | select(exercised and .fixture_status=="SUPERSEDED")] | length),
      # Recorded, never consulted by the verdict expression below — the
      # metadata equivalent of the suffix on the rendered verdict line.
      stub_tainted_exercised: ([$merged[] | select(exercised and (((.stub_refs // []) | length) > 0))] | length)
    }
    # CONTRACT.md (j.3), evaluated strictly in order. FAIL is tested BEFORE the
    # soft-block cases, which is the mechanical guarantee that an unsanctioned
    # behavioural divergence can never be downgraded to PASS-PENDING-DECISIONS
    # by a provisional, superseded, or unmapped state sitting alongside it.
    | . + {
        # `$selected == 0` is INCOMPLETE for the same reason a fully
        # unreplayable selection is: nothing was exercised. Without it the
        # counts are all 0, no rule fires, and the metadata would record PASS
        # for a run that compared nothing — disagreeing with the report the
        # same run wrote.
        overall: (if ($selected == 0 or ($selected > 0 and .not_replayable == $selected)) then "INCOMPLETE"
                  elif (.error > 0 or .diverged > 0) then "FAIL"
                  elif (.provisional_exercised > 0 or .superseded_exercised > 0 or .unmapped_error_code > 0) then "PASS-PENDING-DECISIONS"
                  else "PASS" end)
      }
    | . + { exit_code: (if .overall == "INCOMPLETE" then 2 elif (.overall == "FAIL" or .overall == "PASS-PENDING-DECISIONS") then 1 else 0 end) }
  '
}

# Evidence copy of the generated test project — SOURCE ONLY. Always excludes
# the run's own pipeline-bookkeeping JSON/logs; additionally excludes
# whatever run-config.json's evidence_exclusions names as this stack's own
# build/dependency output (e.g. bin/, obj/ or node_modules/, dist/) — never
# a hardcoded stack assumption, and never left to hoping a clean ran first.
copy_test_source() {
  local run_dir="$1" dest_dir="$2"; shift 2
  local -a exclusions=("$@")
  mkdir -p "$dest_dir"
  local f rel excluded pat
  while IFS= read -r f; do
    rel="${f#"$run_dir"/}"
    case "$rel" in
      actual/*) continue ;;
      run-config.json|selection.json|mapping.json|compare.json|sanction.json|sanction-verified.json) continue ;;
      build.log|test.log) continue ;;
    esac
    excluded=false
    for pat in ${exclusions[@]+"${exclusions[@]}"}; do
      [ -z "$pat" ] && continue
      case "$rel" in
        "${pat}"*|*"/${pat}"*) excluded=true; break ;;
      esac
    done
    $excluded && continue
    mkdir -p "$dest_dir/$(dirname "$rel")"
    cp "$f" "$dest_dir/$rel"
  done < <(find "$run_dir" -type f)
}

# Rebuilds the one mutable file in a change's evidence tree: a plain-
# language table of every run's evidence for this change, newest first.
# Reads ONLY each run's own run-metadata.json — never compare.json/
# sanction-verified.json, which are long gone by the time this is called
# for an old run (finalize deletes the working run directory once its
# useful contents are curated into the evidence tree).
regenerate_evidence_summary() {
  local specclaw_dir_abs="$1" target="$2"
  local evidence_root="${specclaw_dir_abs}/changes/${target}/replay-evidence"
  local summary_file="${evidence_root}/evidence-summary.md"
  mkdir -p "$evidence_root"

  local -a run_dirs=()
  while IFS= read -r d; do
    run_dirs+=("$d")
  done < <(find "$evidence_root" -maxdepth 1 -type d -name 'run-*' 2>/dev/null | sort -r)

  local rows="" row d meta
  for d in "${run_dirs[@]}"; do
    meta="$d/run-metadata.json"
    [ -f "$meta" ] || continue
    # `// 0` on the newer count keys only — a run folder written by an older
    # specclaw stays readable in this table instead of rendering as `null`.
    row="$(jq -r '
      "| " + .date + " | " + (.selected_count|tostring) + " | " +
      (.counts.match|tostring) + " | " + (.counts.sanctioned|tostring) + " | " +
      (.counts.diverged|tostring) + " | " + ((.counts.representation // 0)|tostring) + " | " +
      (((.counts.provisional_exercised // 0) + (.counts.superseded_exercised // 0) + (.counts.unmapped_error_code // 0))|tostring) + " | " +
      (.counts.error|tostring) + " | " +
      (.counts.not_replayable|tostring) + " | " +
      (if ((.stubs_in_effect // []) | length) > 0
       then "⚠ " + ((.stubs_in_effect // []) | join(", ")) else "—" end) + " | " +
      .overall_verdict +
      (if (.stub_tainted // false) then "*" else "" end) + " | `run-" + .run_id + "/` |"
    ' "$meta" 2>/dev/null || true)"
    [ -n "$row" ] && rows="${rows}${row}
"
  done
  rows="$(printf '%s' "$rows" | sed '/./,$!d')"
  [ -z "$rows" ] && rows="_No replay runs recorded yet for this change._"

  local template="$PLUGIN_ROOT/templates/replay-evidence-summary.md"
  local content
  if [ -f "$template" ]; then
    content="$(cat "$template")"
  else
    content="# Replay Evidence: {{target}}

{{table_rows}}"
  fi
  content="$(fill_placeholder "$content" "{{target}}" "$target")"
  content="$(fill_placeholder "$content" "{{table_rows}}" "$rows")"
  printf '%s\n' "$content" > "$summary_file"
}

# ─── Subcommand: render ──────────────────────────────────────────────────────

cmd_render() {
  require_jq
  local specclaw_dir="$1" target="$2" run_dir="$3" discard_flag="${4:-}"
  local specclaw_dir_abs
  specclaw_dir_abs="$(cd "$specclaw_dir" && pwd)"

  local template="$PLUGIN_ROOT/templates/replay-report.md"
  [ -f "$template" ] || die "Report template missing: ${template}"

  local selection="$run_dir/selection.json" compare="$run_dir/compare.json"
  local sanction="$run_dir/sanction-verified.json"
  [ -f "$selection" ] || die "selection.json missing in ${run_dir}."

  # THE EMPTY-SELECTION CONTRACT (resolve's other half). A 0-fixture selection
  # never reached an agent, a test run, or `compare`, so there is no
  # compare.json to require — demanding one would turn the contract's clean
  # result back into the precondition failure it exists to replace. Every count
  # below then computes to 0 over an empty results set, so this stays ONE
  # rendering path rather than a second, separately-drifting one.
  local empty_selection=false
  [ "$(jq -r '.selected_count // 0' "$selection")" -eq 0 ] && empty_selection=true
  if ! $empty_selection; then
    [ -f "$compare" ] || die "compare.json missing in ${run_dir}."
  fi

  local legacy_sha bl_item selected_count manifest_pv manifest_schema this_version
  # `// "—"` covers the empty-selection case only: with no fixtures selected
  # there is no captured commit to name. A non-empty selection always carries
  # one, so this changes nothing for any run that compares anything.
  legacy_sha=$(jq -r '.legacy_commit_sha // "—"' "$selection")
  bl_item=$(jq -r '.bl_item // "—"' "$selection")
  selected_count=$(jq '.selected_count' "$selection")
  manifest_pv=$(jq -r '.manifest_plugin_version // "unknown"' "$selection")
  manifest_schema=$(jq -r '.manifest_schema // "unknown"' "$selection")
  this_version="$(plugin_version_of_this_run)"

  # Only BEHAVIOURAL rows carry a sanction. A representation-only row was the
  # same business decision expressed differently and was never put to the
  # auditor at all (CONTRACT.md (j.2)).
  local merged
  if $empty_selection; then
    merged='[]'
  elif [ -f "$sanction" ]; then
    merged=$(jq --slurpfile s "$sanction" '
      (.results) as $r
      | ($s[0].sanctions // []) as $sc
      | [ $r[] | . as $row
          | if $row.divergence_class == "behavioural" then
              ( ($sc[] | select(.scenario_id == $row.scenario_id)) // {sanctioned:false,cq_id:null,note:"not reviewed"} ) as $m
              | $row + {sanctioned: $m.sanctioned, cq_id: $m.cq_id, sanction_note: $m.note}
            else $row end
        ]
    ' "$compare")
  else
    merged=$(jq '.results' "$compare")
  fi

  local match_n behav_sanctioned_n behav_unsanctioned_n repr_n unmapped_n
  local error_n seam_n nr_other_n nr_total_n
  match_n=$(jq '[.[] | select(.verdict=="MATCH")] | length' <<< "$merged")
  behav_sanctioned_n=$(jq '[.[] | select(.divergence_class=="behavioural" and .sanctioned==true)] | length' <<< "$merged")
  behav_unsanctioned_n=$(jq '[.[] | select(.divergence_class=="behavioural" and (.sanctioned != true))] | length' <<< "$merged")
  repr_n=$(jq '[.[] | select(.divergence_class=="representation")] | length' <<< "$merged")
  unmapped_n=$(jq '[.[] | select(.divergence_class=="unmapped-error-code")] | length' <<< "$merged")
  error_n=$(jq '[.[] | select(.verdict=="ERROR")] | length' <<< "$merged")
  seam_n=$(jq '[.[] | select(.category=="seam-mismatch")] | length' <<< "$merged")
  nr_other_n=$(jq '[.[] | select(.verdict=="NOT REPLAYABLE" and .category!="seam-mismatch")] | length' <<< "$merged")
  nr_total_n=$(jq '[.[] | select(.verdict=="NOT REPLAYABLE")] | length' <<< "$merged")

  # Ask, Don't Guess soft-blocks: any EXERCISED (MATCH/DIVERGES/ERROR — never
  # NOT REPLAYABLE, which was never actually run against the fixture) fixture
  # resting on an open pending question, or whose scenario definition changed
  # after capture, keeps the overall verdict off PASS even when every
  # comparison itself came back clean.
  local exercised_provisional_n exercised_superseded_n
  exercised_provisional_n=$(jq '[.[] | select((.verdict=="MATCH" or .verdict=="DIVERGES" or .verdict=="ERROR") and .fixture_status=="PROVISIONAL")] | length' <<< "$merged")
  exercised_superseded_n=$(jq '[.[] | select((.verdict=="MATCH" or .verdict=="DIVERGES" or .verdict=="ERROR") and .fixture_status=="SUPERSEDED")] | length' <<< "$merged")

  # CONTRACT.md (j.3), strictly in order. FAIL is tested before every
  # soft-block case: an unsanctioned behavioural divergence is always FAIL and
  # is never downgraded by a provisional/superseded/unmapped state beside it.
  local overall exit_code
  if $empty_selection; then
    # Nothing was exercised because there was nothing to exercise. That is the
    # SAME state rule 1 describes — a non-empty selection where nothing ran —
    # and it takes the same verdict and the same exit code. Without this
    # branch the counts would all be 0, no rule would fire, and the run would
    # fall through to PASS/exit 0: a clean pass asserting a comparison that
    # never happened, which is the one outcome this contract must never allow.
    overall="INCOMPLETE"; exit_code=2
  elif [ "$selected_count" -gt 0 ] && [ "$nr_total_n" -eq "$selected_count" ]; then
    overall="INCOMPLETE"; exit_code=2
  elif [ "$error_n" -gt 0 ] || [ "$behav_unsanctioned_n" -gt 0 ]; then
    overall="FAIL"; exit_code=1
  elif [ "$exercised_provisional_n" -gt 0 ] || [ "$exercised_superseded_n" -gt 0 ] || [ "$unmapped_n" -gt 0 ]; then
    overall="PASS-PENDING-DECISIONS"; exit_code=1
  else
    overall="PASS"; exit_code=0
  fi

  # ── Stub taint (CONTRACT.md (m.3)) ───────────────────────────────────────
  # Counted over EXERCISED rows only, the same filter the provisional and
  # superseded soft-blocks use: a fixture that never ran produced no verdict
  # for a stub to have stood behind. Purely a reporting computation — nothing
  # below feeds the verdict block above, which is unchanged byte for byte.
  local stub_tainted_exercised stub_ids_in_run stub_taint_suffix=""
  stub_tainted_exercised=$(jq '[.[] | select((.verdict=="MATCH" or .verdict=="DIVERGES" or .verdict=="ERROR") and (((.stub_refs // []) | length) > 0))] | length' <<< "$merged")
  stub_ids_in_run=$(jq -c '[ .[] | select(.verdict=="MATCH" or .verdict=="DIVERGES" or .verdict=="ERROR") | (.stub_refs // [])[] ] | unique' <<< "$merged")
  if [ "$stub_tainted_exercised" -gt 0 ]; then
    # Appended AFTER the verdict token, never in front of it: "PASS (with
    # active stubs: ST-001)" still reads as PASS to anything that parses the
    # leading word, which is the whole reason the suffix is a separate
    # placeholder rather than a rewritten verdict string.
    stub_taint_suffix=" (with active stubs: $(jq -r 'join(", ")' <<< "$stub_ids_in_run"))"
  fi

  # ── Item-split PARTIAL (CONTRACT.md (o.4)) ───────────────────────────────
  # Exactly the same shape as stub taint, and for a different reason. Taint
  # qualifies a verdict's STANDING ("what it was measured against was not
  # real"); this qualifies its SCOPE ("only half the item exists yet"). Both
  # ride after the verdict token so `PASS` still parses as `PASS`, and neither
  # enters the verdict block above or changes an exit code.
  local item_split split_suffix="" split_section="_None — this run covers a whole backlog item, or no item split applies._"
  item_split="$(jq -c '.item_split // null' "$selection" 2>/dev/null || echo 'null')"
  [ -n "$item_split" ] || item_split="null"
  if [ "$item_split" != "null" ]; then
    local sp_id sp_status sp_deferred sp_def_n sp_blocked sp_prior
    sp_id="$(jq -r '.id' <<< "$item_split" | tr -d '\r')"
    sp_status="$(jq -r '.status' <<< "$item_split" | tr -d '\r')"
    sp_deferred="$(jq -r '.deferred // "not recorded"' <<< "$item_split" | tr -d '\r')"
    sp_blocked="$(jq -r '(.blocked_until // []) | join(", ")' <<< "$item_split" | tr -d '\r')"
    sp_prior="$(jq -r '.replay_evidence // "not yet replayed"' <<< "$item_split" | tr -d '\r')"
    # Count only fixtures this run actually EXERCISED, the same filter taint
    # uses: a deferred-scope fixture that never ran says nothing either way.
    sp_def_n="$(jq --slurpfile sp_in "$(sc_payload render_split "$item_split")" '
      ($sp_in[0]) as $sp
      | [ .[] | select(.verdict=="MATCH" or .verdict=="DIVERGES" or .verdict=="ERROR")
            | select((.scenario_id) as $id | $sp.fixtures_covering_deferred | index($id)) ] | length' <<< "$merged")"
    local sp_exercised
    sp_exercised="$(jq '[ .[] | select(.verdict=="MATCH" or .verdict=="DIVERGES" or .verdict=="ERROR") ] | length' <<< "$merged")"
    split_suffix=" (partial — split ${sp_id}: ${sp_def_n} of ${sp_exercised} exercised fixture(s) pin deferred rules)"

    local sp_def_list sp_built_list
    sp_def_list="$(jq -r '(.fixtures_covering_deferred // []) | if length == 0 then "_none_" else join(", ") end' <<< "$item_split" | tr -d '\r')"
    sp_built_list="$(jq -r '(.fixtures_covering_built // []) | if length == 0 then "_none_" else join(", ") end' <<< "$item_split" | tr -d '\r')"
    split_section="> **This run is NOT ${bl_item:-this item}'s final acceptance.** Split \`${sp_id}\` is \`${sp_status}\`: part of this item was deliberately deferred and has not been built.

| | |
|---|---|
| Split | \`${sp_id}\` — ${sp_status} |
| Still deferred | ${sp_deferred} |
| Blocked until | ${sp_blocked:-not recorded} |
| Fixtures covering **built** scope | ${sp_built_list} |
| Fixtures covering **deferred** scope | ${sp_def_list} |
| Prior slice's replay evidence | ${sp_prior} |

A fixture pinning a deferred rule is still replayed and still counts toward the verdict above — excluding it would change what this run fails on and could hide a real regression behind a scope note. So read the two lists deliberately: a **FAIL** among the deferred-scope fixtures is expected and explained by the split, while a **PASS** among them is a surprise worth investigating — it means either the deferred scope was quietly built after all, or ${sp_id}'s rule partition is wrong.

Only a clean \`--item\` run **after** the deferred scope lands can mark ${sp_id} \`COMPLETE\`:
\`\`\`
specclaw-bf-rebuild-collect split-update .specclaw ${sp_id} \\
  --status \"COMPLETE <date>, cleared by run <run_id>\" \\
  --completion \"<date>, run <run_id>, <what finished it>\"
\`\`\`"
  fi

  local table_rows
  table_rows=$(jq -r '
    def statussuffix:
      if .fixture_status == "PROVISIONAL" then "-PROVISIONAL"
      elif .fixture_status == "SUPERSEDED" then "-SUPERSEDED"
      else "" end;
    def stubcell:
      if ((.stub_refs // []) | length) == 0 then "—"
      else "⚠ " + ((.stub_refs // []) | join(", ")) end;
    .[] |
    (if .verdict == "DIVERGES" then
       "| " + .scenario_id + " | DIVERGES" + statussuffix + " | " +
       (.divergence_class // "unclassified") + " | " +
       (if .divergence_class != "behavioural" then "n/a"
        elif .sanctioned == true then "SANCTIONED (" + (.cq_id // "?") + ")"
        else "UNSANCTIONED" end) + " | " + stubcell + " | " +
       ((.diffs // []) | map(.field_path) | join("; ")) + " |"
     elif .verdict == "ERROR" then
       "| " + .scenario_id + " | ERROR" + statussuffix + " | — | — | " + stubcell + " | " + (.detail // "") + " |"
     elif .verdict == "NOT REPLAYABLE" then
       "| " + .scenario_id + " | NOT REPLAYABLE | " + (.category // "other") + " | — | " + stubcell + " | " + (.reason // "") + " |"
     else
       "| " + .scenario_id + " | MATCH" + statussuffix + " | — | — | " + stubcell + " | — |"
     end)
  ' <<< "$merged")

  # ── Stubs In Effect section ──────────────────────────────────────────────
  # Only the entries this run's selection actually hit (resolve already
  # filtered), plus any RETIRING entry whose consumers are in this run — the
  # latter taints nothing but makes a clean run legible as the run that
  # retires it, rather than an ordinary PASS someone has to correlate with a
  # registry edit by hand (CONTRACT.md (m.4)).
  local stubs_in_effect_section
  stubs_in_effect_section=$(jq -r --argjson ids "$stub_ids_in_run" '
    ([ (.stubs_in_effect // [])[] | select(.id as $i | $ids | index($i))
       | "- **" + .id + "** (`" + .strategy + "`) — substitutes " + .substitutes +
         ". Fakes: " + (if (.fakes // "") == "" or .fakes == "not yet implemented"
                        then "_not yet implemented — this stub has no recorded implementation, so what it fakes is only the propose-time sketch: " + .summary + "_"
                        else .fakes end) +
         "\n  Tainted fixtures in this run: " + (.fixtures | join(", ")) ]) as $active
    | ([ (.retirement_candidates // [])[]
       | "- **" + .id + "** (`" + .strategy + "`) — **RETIRING**, substitutes " + .substitutes +
         ". The stub code is reported removed; this run is its retirement verification for " +
         (.consumers_in_run | join(", ")) +
         ". A clean verdict here is what retires it — flip the entry to RETIRED citing this run id. A FAIL sends it back to ACTIVE." ]) as $retiring
    | if (($active | length) + ($retiring | length)) == 0
      then "_None — no fixture in this run rests on an active bypass stub._"
      else (($active + $retiring) | join("\n")) end
  ' "$selection")

  # ── Behavioural detail: the mechanical fact only — field, legacy value,
  # rebuild value. No agent interpretation is added anywhere in this section;
  # `tojson` is used so null, false, and "false" stay distinguishable. ──────
  local behavioural_detail
  behavioural_detail=$(jq -r '
    [ .[] | select(.divergence_class=="behavioural")
      | "- **" + .scenario_id + "** — " +
        (if .sanctioned == true then "SANCTIONED (" + (.cq_id // "?") + ")" else "**UNSANCTIONED**" end) +
        "\n" +
        ([ (.diffs // [])[] | select(.field_class=="behavioural")
           | "  - `" + .field_path + "` — legacy `" + (.expected|tojson) + "`, rebuild `" + (.actual|tojson) + "`"
         ] | join("\n"))
    ]
    | if length == 0 then "_None — no fixture in this run behaved differently from the legacy application._"
      else join("\n\n") end
  ' <<< "$merged")

  # Representation diffs are collected from EVERY row, not only from rows whose
  # own class is representation — a behavioural row usually carries them too,
  # and they are evidence either way.
  local representation_detail
  representation_detail=$(jq -r '
    [ .[] | . as $row | (.diffs // [])[] | select(.field_class=="representation")
      | "- **" + $row.scenario_id + "** `" + .field_path + "` — legacy `" +
        (.expected|tojson) + "`, rebuild `" + (.actual|tojson) + "`"
    ]
    | if length == 0 then "_None — where the rebuild reported an error, it reported it under the same type name and wording._"
      else join("\n") end
  ' <<< "$merged")

  local seam_mismatch_list
  seam_mismatch_list=$(jq -r '
    [ .[] | select(.category=="seam-mismatch")
      | "- **" + .scenario_id + "** — " + (.reason // "") +
        " Remediation: " + (.remediation // "none recorded") ]
    | if length == 0 then "_None — every replayed fixture was exercised at the layer it was captured at._"
      else join("\n") end
  ' <<< "$merged")

  local normalization_warning_list
  normalization_warning_list=$(jq -r '
    [ .[] | . as $row | (.normalization_warnings // [])[]
      | "- **" + $row.scenario_id + "** — `" + .path +
        "` resolves against the captured fixture but matches nothing in the rebuild'"'"'s actual output" +
        (if (.suggestions | length) > 0
         then " (present instead: " + ([.suggestions[] | "`" + . + "`"] | join(", ")) + ")"
         else "" end) ]
    | if length == 0 then "_None — every normalization path still resolves against the rebuild'"'"'s output._"
      else join("\n") end
  ' <<< "$merged")

  # ── Open decisions blocking PASS — one line per exercised PROVISIONAL
  # fixture, naming the PQ/CQ id(s) that block it (from selection.json's
  # own provisional_ref, propagated from manifest.json — never re-derived
  # here; compare.json only ever carries the boolean-shaped fixture_status,
  # not the specific id, so this reads selection.json directly). ──────────
  # Three distinct soft-blocks, all reported together because they all mean the
  # same thing to a reader: this run is not yet citable as final proof, and a
  # named human (not another run) is what clears it.
  local open_decisions_blocking_pass
  open_decisions_blocking_pass=$(jq -r --slurpfile merged_in "$(sc_payload render_merged "$merged")" '
    ($merged_in[0]) as $merged
    | def exercised: (.verdict=="MATCH" or .verdict=="DIVERGES" or .verdict=="ERROR");
    . as $sel
    | [ ($merged[] | select(exercised and .fixture_status=="PROVISIONAL")
          | . as $row
          | ($sel.fixtures[] | select(.scenario_id == $row.scenario_id) | .provisional_ref // "") as $ref
          | "- **" + $row.scenario_id + "** (" + $row.verdict + "-PROVISIONAL) — blocked by " +
            (if $ref == "" then "an open pending question (see scenarios.md)" else $ref end)),
        ($merged[] | select(exercised and .fixture_status=="SUPERSEDED")
          | "- **" + .scenario_id + "** (" + .verdict + "-SUPERSEDED) — the scenario definition changed after this fixture was captured, so replaying it proves nothing about the scenario as currently written. Recapture it (/specclaw:bf-baseline --harness, run the harness, then --record)."),
        ($merged[] | select(.divergence_class=="unmapped-error-code")
          | "- **" + .scenario_id + "** (unmapped error code) — " +
            ([ (.diffs // [])[] | select(.field_class=="unmapped-error-code")
               | "`" + .field_path + "`: legacy " + (.expected|tojson) + ", rebuild " + (.actual|tojson) ] | join("; ")) +
            " — nobody guessed a code. Map the condition in .specclaw/baseline/error-map.md, or answer the pending question that blocked it.")
      ]
    | if length == 0
      then "_None — no exercised fixture in this run rests on an open pending question, a changed scenario definition, or an unmapped error condition._"
      else join("\n") end
  ' "$selection")

  # Seam mismatches have their own section above; listing them twice would read
  # as twice as many unreplayable fixtures as there are.
  local not_replayable_list
  not_replayable_list=$(jq -r '
    [.[] | select(.verdict=="NOT REPLAYABLE" and .category!="seam-mismatch")] |
    if length == 0 then "_None — every selected fixture was replayable this run (seam-layer mismatches, if any, are listed in their own section above)._"
    else map("- **" + .scenario_id + "** (" + (.category // "other") + "): " +
             (.reason // "no reason recorded") + " — Remediation: " +
             (.remediation // "none recorded")) | join("\n")
    end
  ' <<< "$merged")

  local replayable_sids dr_covered
  replayable_sids=$(jq '[.[] | select(.verdict=="MATCH" or .verdict=="DIVERGES" or .verdict=="ERROR") | .scenario_id]' <<< "$merged")
  dr_covered=$(jq --slurpfile sids_in "$(sc_payload replayable_sids "$replayable_sids")" '
    ($sids_in[0]) as $sids
    | [ .fixtures[] | select(.scenario_id as $s | $sids | index($s)) | .business_rules_pinned ]
    | join(" ") | [scan("DR-[0-9]{3}")] | unique
  ' "$selection")

  local domain_model="${specclaw_dir_abs}/analysis/domain-model.md"
  local dr_uncovered_list
  if [ -f "$domain_model" ]; then
    local all_dr dr_uncovered_lines=()
    all_dr=$(grep -oE 'DR-[0-9]{3}' "$domain_model" | sort -u)
    while IFS= read -r dr; do
      [ -z "$dr" ] && continue
      if ! jq -e --arg dr "$dr" 'index($dr) != null' <<< "$dr_covered" >/dev/null 2>&1; then
        dr_uncovered_lines+=("- ${dr}")
      fi
    done <<< "$all_dr"
    if [ "${#dr_uncovered_lines[@]}" -eq 0 ]; then
      dr_uncovered_list="_None — every documented business rule is covered by at least one replayable fixture in this run._"
    else
      dr_uncovered_list=$(printf '%s\n' "${dr_uncovered_lines[@]}")
    fi
  else
    dr_uncovered_list="_domain-model.md not found — cannot compute uncovered DR rules._"
  fi

  # ── Module rollup ────────────────────────────────────────────────────────
  # Per module: fixture counts by verdict, that module's own verdict computed
  # by the SAME four-step order as the overall one (CONTRACT.md (j.3)) over
  # its own subset, and — mandatory, never omitted — how many of its fixtures
  # are shared with another module.
  #
  # THE CROSS-MODULE HONESTY RULE. A fixture whose rules span modules counts
  # toward EVERY module it touches. A module verdict that quietly excluded the
  # shared flows would be a false verdict: those are precisely the flows that
  # break when one module is rebuilt in isolation. So the Shared column is
  # always present and always states the other modules by name — a reader must
  # never be able to mistake "MOD-002: PASS" for "MOD-002 is done" when three
  # of its fixtures only pass because MOD-005 still behaves as it did.
  #
  # None of this touches the overall verdict or the exit code: it is a
  # reporting view over the same computed rows.
  local module_rollup
  module_rollup=$(jq -r --slurpfile merged_in "$(sc_payload rollup_merged "$merged")" '
    ($merged_in[0]) as $merged
    | def exercised: (.verdict=="MATCH" or .verdict=="DIVERGES" or .verdict=="ERROR");
    ([ .fixtures[] | (.module_ids // [])[] ] | unique) as $mods
    | if ($mods | length) == 0 then
        "_No module metadata in the manifest for this run — per-module rollups are unavailable. Re-run `/specclaw:bf-baseline --record` against scenarios that declare their modules to enable them._"
      else
        (.module_totals // {}) as $totals
        | ([ "| Module | Fixtures in this run | Match | Behav. unsanctioned | Behav. sanctioned | Repr. | Unmapped | Error | Not replayable | Verdict | Shared with other modules |",
           "|---|---|---|---|---|---|---|---|---|---|---|" ]
         + [ $mods[] as $m
             | ([ .fixtures[] | select((.module_ids // []) | index($m)) ]) as $fx
             | ([ $fx[] | .scenario_id ]) as $ids
             | ([ $merged[] | select(.scenario_id as $s | $ids | index($s)) ]) as $rows
             | ($fx | length) as $total
             | ([ $rows[] | select(.verdict=="MATCH") ] | length) as $match
             | ([ $rows[] | select(.divergence_class=="behavioural" and (.sanctioned != true)) ] | length) as $bu
             | ([ $rows[] | select(.divergence_class=="behavioural" and .sanctioned==true) ] | length) as $bs
             | ([ $rows[] | select(.divergence_class=="representation") ] | length) as $rep
             | ([ $rows[] | select(.divergence_class=="unmapped-error-code") ] | length) as $unm
             | ([ $rows[] | select(.verdict=="ERROR") ] | length) as $err
             | ([ $rows[] | select(.verdict=="NOT REPLAYABLE") ] | length) as $nr
             | ([ $rows[] | select(exercised and .fixture_status=="PROVISIONAL") ] | length) as $prov
             | ([ $rows[] | select(exercised and .fixture_status=="SUPERSEDED") ] | length) as $sup
             | (if ($total > 0 and $nr == $total) then "INCOMPLETE"
                elif ($err > 0 or $bu > 0) then "FAIL"
                elif ($prov > 0 or $sup > 0 or $unm > 0) then "PASS-PENDING-DECISIONS"
                else "PASS" end) as $verdict
             | ([ $fx[] | select(((.module_ids // []) | length) > 1) ]) as $shared
             | ([ $shared[] | (.module_ids // [])[] | select(. != $m) ] | unique) as $others
             | ($totals[$m] // $total) as $module_total
             | (if $total < $module_total
                then ($total|tostring) + " of " + ($module_total|tostring) + " — **PARTIAL**"
                else ($total|tostring) + " of " + ($module_total|tostring) end) as $scope
             | "| " + $m + " | " + $scope + " | " + ($match|tostring) + " | " +
               ($bu|tostring) + " | " + ($bs|tostring) + " | " + ($rep|tostring) + " | " +
               ($unm|tostring) + " | " + ($err|tostring) + " | " + ($nr|tostring) + " | **" +
               $verdict + (if $total < $module_total then " (of the selected subset only)" else "" end) + "** | " +
               (if ($shared | length) == 0 then "none — every fixture here belongs to this module only"
                else ($shared | length | tostring) + " of " + ($total|tostring) + " shared with " + ($others | join(", ")) end) + " |"
           ])
        | join("\n")
      end
  ' "$selection")

  local today
  today=$(date +%Y-%m-%d)

  # Identified stack — read unconditionally (run-config.json is present in
  # run_dir regardless of --discard; only finalize's later curation step
  # depends on that flag) so the report header can always state it.
  local stack_r
  stack_r="$(jq -r '.stack // "unknown"' "$run_dir/run-config.json" 2>/dev/null || echo "unknown")"

  # ── Evidence pointer block. Retention is the default — `--discard` opts
  # a single run out of the evidence package, but the report itself is
  # always written either way, so it must say plainly which case this is. ─
  local evidence_run_id evidence_block
  evidence_run_id="$(run_id_from_dir "$run_dir")"
  if [ "$discard_flag" = "--discard" ]; then
    evidence_block="**Evidence package:** discarded (\`--discard\` was passed) — no retained proof package exists for this run; the verdicts above are not independently reviewable evidence."
  else
    local evidence_rel new_repo_sha plugin_version
    evidence_rel="$(evidence_dir_rel "$target" "$evidence_run_id")"
    new_repo_sha="$(git -C "$(cd "${specclaw_dir_abs}/.." && pwd)" rev-parse --short HEAD 2>/dev/null || echo "unknown")"
    plugin_version="$(jq -r '.version // "unknown"' "$PLUGIN_ROOT/.claude-plugin/plugin.json" 2>/dev/null || echo "unknown")"
    evidence_block="**Evidence package:** \`${evidence_rel}/\` (new-repo commit \`${new_repo_sha}\`, stack \`${stack_r}\`, specclaw v${plugin_version})

This package contains the generated tests (source), the actual outputs produced by the rebuilt application, references (fixture IDs + hashes) to the sealed legacy fixtures they were compared against, and the per-fixture verdicts below — together, mechanical proof that the rebuilt application's behaviour was compared against the original application's recorded behaviour."
  fi

  local content
  content="$(cat "$template")"
  content="$(fill_placeholder "$content" "{{target}}" "$target")"
  content="$(fill_placeholder "$content" "{{date}}" "$today")"
  content="$(fill_placeholder "$content" "{{stack}}" "$stack_r")"
  content="$(fill_placeholder "$content" "{{legacy_commit_sha}}" "$legacy_sha")"
  content="$(fill_placeholder "$content" "{{bl_item}}" "$bl_item")"
  content="$(fill_placeholder "$content" "{{selected_count}}" "$selected_count")"
  content="$(fill_placeholder "$content" "{{evidence_block}}" "$evidence_block")"
  # The empty-selection contract's own statement, on the report's face rather
  # than only in resolve's stdout — a retained report has to explain its own
  # INCOMPLETE without the reader going back to a run log that no longer exists.
  local empty_notice=""
  if $empty_selection; then
    empty_notice="
> **NO BASELINE DATA — 0 fixtures mapped to ${bl_item}.** This item is active and
> its acceptance basis is recorded, but no fixture in the baseline manifest pins
> any of the \`DR-###\` rules that basis cites — so there was nothing to compare
> the rebuild against. Nothing failed here and nothing passed: the verdict is
> **INCOMPLETE** (exit code 2). Design and capture scenarios covering this
> item's rules (\`/specclaw:bf-baseline\`), then replay it again.
"
  fi
  content="$(fill_placeholder "$content" "{{empty_selection_notice}}" "$empty_notice")"
  content="$(fill_placeholder "$content" "{{plugin_version}}" "$this_version")"
  content="$(fill_placeholder "$content" "{{manifest_plugin_version}}" "$manifest_pv")"
  content="$(fill_placeholder "$content" "{{manifest_schema}}" "$manifest_schema")"
  content="$(fill_placeholder "$content" "{{match_count}}" "$match_n")"
  content="$(fill_placeholder "$content" "{{behavioural_sanctioned_count}}" "$behav_sanctioned_n")"
  content="$(fill_placeholder "$content" "{{behavioural_unsanctioned_count}}" "$behav_unsanctioned_n")"
  content="$(fill_placeholder "$content" "{{representation_count}}" "$repr_n")"
  content="$(fill_placeholder "$content" "{{unmapped_error_code_count}}" "$unmapped_n")"
  content="$(fill_placeholder "$content" "{{error_count}}" "$error_n")"
  content="$(fill_placeholder "$content" "{{seam_mismatch_count}}" "$seam_n")"
  content="$(fill_placeholder "$content" "{{not_replayable_other_count}}" "$nr_other_n")"
  content="$(fill_placeholder "$content" "{{overall_verdict}}" "$overall")"
  content="$(fill_placeholder "$content" "{{fixture_table_rows}}" "$table_rows")"
  content="$(fill_placeholder "$content" "{{behavioural_divergence_detail}}" "$behavioural_detail")"
  content="$(fill_placeholder "$content" "{{representation_detail}}" "$representation_detail")"
  content="$(fill_placeholder "$content" "{{seam_mismatch_list}}" "$seam_mismatch_list")"
  content="$(fill_placeholder "$content" "{{normalization_warning_list}}" "$normalization_warning_list")"
  content="$(fill_placeholder "$content" "{{not_replayable_list}}" "$not_replayable_list")"
  content="$(fill_placeholder "$content" "{{open_decisions_blocking_pass}}" "$open_decisions_blocking_pass")"
  content="$(fill_placeholder "$content" "{{dr_uncovered_list}}" "$dr_uncovered_list")"
  content="$(fill_placeholder "$content" "{{module_rollup}}" "$module_rollup")"
  content="$(fill_placeholder "$content" "{{stubs_in_effect}}" "$stubs_in_effect_section")"
  # Replaces BOTH occurrences (header line and Verdict section) — fill_placeholder
  # loops, so the two never drift apart into a report whose header admits a stub
  # and whose verdict does not.
  # Order matters on the verdict line: the verdict token first, then taint,
  # then the split's scope qualifier. Anything parsing the leading word still
  # reads PASS/FAIL/INCOMPLETE unchanged.
  content="$(fill_placeholder "$content" "{{stub_taint_suffix}}" "${stub_taint_suffix}${split_suffix}")"
  content="$(fill_placeholder "$content" "{{item_split_section}}" "$split_section")"

  # ── Informational footer only. Purely additive: the verdict above and the
  # exit code below are computed exactly as before, and a project whose UI
  # fidelity policy is REINTERPRET or undecided sees no footer at all. ────
  local ui_policy ui_footer=""
  ui_policy="$(read_fidelity_policy "${specclaw_dir_abs}/analysis/decisions.md")"
  case "$ui_policy" in
    FAITHFUL|THEME-ONLY)
      ui_footer="_UI fidelity is verified by human checklist (\`ui-review.md\`), not by fixture replay. This report's verdict says nothing about the rebuilt interface's appearance — UI fidelity policy is ${ui_policy} (${FIDELITY_SQ_ID}); see \`/specclaw:bf-ui --checklist\`._"
      ;;
  esac
  content="$(fill_placeholder "$content" "{{ui_fidelity_footer}}" "$ui_footer")"

  local out_path
  out_path="$(report_path_abs "$specclaw_dir_abs" "$target" "$evidence_run_id")"
  case "$(target_kind "$target")" in
    all|module|item) mkdir -p "${specclaw_dir_abs}/replay" ;;
  esac
  printf '%s\n' "$content" > "$out_path"

  echo "Replay report written to ${out_path}. Overall verdict: ${overall}${stub_taint_suffix} (MATCH=${match_n} BEHAVIOURAL=${behav_unsanctioned_n} unsanctioned/${behav_sanctioned_n} sanctioned REPRESENTATION=${repr_n} UNMAPPED_ERROR_CODE=${unmapped_n} ERROR=${error_n} SEAM_MISMATCH=${seam_n} NOT_REPLAYABLE=${nr_other_n} STUB_TAINTED=${stub_tainted_exercised})."
  exit "$exit_code"
}

# ─── Subcommand: finalize (retention is the default) ─────────────────────────
# Replaces the old `cleanup` (which deleted the run directory by default,
# keeping it only on --keep). Now the default curates the run directory's
# generated tests + results into a durable, change-scoped evidence folder
# — the proof a client can be shown, not just the verdict. `--keep` is
# accepted and silently treated identically to the default (retention
# already IS keeping everything that matters; there's nothing extra `--keep`
# needs to do). `--discard` is the new opt-out, for a genuinely throwaway
# run (e.g. mid-debugging) — never recommended for an acceptance run.

cmd_finalize() {
  local specclaw_dir="$1" target="$2" run_dir="$3" mode="${4:-}"

  if [ "$mode" = "--discard" ]; then
    if [ -d "$run_dir" ]; then
      rm -rf "$run_dir"
      echo "Discarded run directory (--discard passed): ${run_dir}. No evidence retained for this run; evidence-summary.md left unchanged."
    else
      warn "Run directory already gone: ${run_dir}"
    fi
    return 0
  fi

  require_jq
  [ -d "$run_dir" ] || die "Run directory not found: ${run_dir}"

  local specclaw_dir_abs project_root
  specclaw_dir_abs="$(cd "$specclaw_dir" && pwd)"
  project_root="$(cd "$specclaw_dir_abs/.." && pwd)"

  local run_id evidence_dir
  run_id="$(run_id_from_dir "$run_dir")"
  evidence_dir="$(evidence_dir_abs "$specclaw_dir_abs" "$target" "$run_id")"
  mkdir -p "$evidence_dir/tests" "$evidence_dir/actual-results" "$evidence_dir/expected" "$evidence_dir/pipeline"

  local report_src
  report_src="$(report_path_abs "$specclaw_dir_abs" "$target" "$run_id")"
  [ -f "$report_src" ] || die "Report not found at ${report_src} — run 'render' before 'finalize'."
  cp "$report_src" "$evidence_dir/report.md"

  local -a evidence_exclusions=()
  if [ -f "$run_dir/run-config.json" ]; then
    while IFS= read -r pat; do
      evidence_exclusions+=("$pat")
    done < <(jq -r '.evidence_exclusions[]? // empty' "$run_dir/run-config.json" 2>/dev/null)
  fi
  copy_test_source "$run_dir" "$evidence_dir/tests" ${evidence_exclusions[@]+"${evidence_exclusions[@]}"}

  if [ -d "$run_dir/actual" ]; then
    local af
    while IFS= read -r af; do
      cp "$af" "$evidence_dir/actual-results/"
    done < <(find "$run_dir/actual" -maxdepth 1 -name '*.json' 2>/dev/null)
  fi

  # ── The pipeline record. These are deliberately excluded from tests/ (they
  # are not test source) but they are the audit trail of how the verdict was
  # reached: what the mapper decided and at which seam layer, what compare
  # computed field by field, what the auditor claimed, what sanction-check
  # independently confirmed, and the raw build/test output. Dropping them —
  # as this command used to — left a report asserting a verdict with no way
  # for a reviewer to check the working. ──────────────────────────────────
  local pf
  for pf in run-config.json selection.json mapping.json compare.json \
            sanction.json sanction-verified.json build.log test.log; do
    # An `if`, not `[ ] && cp` — under `set -e` a false test on the LAST
    # iteration makes the whole loop return non-zero and aborts finalize.
    if [ -f "$run_dir/$pf" ]; then cp "$run_dir/$pf" "$evidence_dir/pipeline/$pf"; fi
  done
  # `sanction.json`/`sanction-verified.json` are genuinely absent on a run with
  # no behavioural divergence, and `build.log` on a stack with no build step —
  # so a missing file here is a normal state, not a warning.

  local selection="$run_dir/selection.json"
  if [ -f "$selection" ]; then
    jq '{ fixtures: [ .fixtures[] | {scenario_id, content_hash, fixture_path} ] }' "$selection" \
      > "$evidence_dir/expected/manifest-excerpt.json"
  else
    warn "selection.json not found in ${run_dir} — expected/manifest-excerpt.json will be empty."
    echo '{ "fixtures": [] }' > "$evidence_dir/expected/manifest-excerpt.json"
  fi

  local legacy_sha bl_item module_id selected_count manifest_pv manifest_schema
  legacy_sha=$(jq -r '.legacy_commit_sha // "unknown"' "$selection" 2>/dev/null || echo "unknown")
  bl_item=$(jq -c '.bl_item // null' "$selection" 2>/dev/null || echo null)
  # The module this run covered, recorded IN the run's own metadata rather than
  # in its directory path — which is what lets several modules' evidence share
  # the corpus-wide pool without ambiguity about what each run proved.
  module_id=$(jq -c '.module // null' "$selection" 2>/dev/null || echo null)
  selected_count=$(jq -r '.selected_count // 0' "$selection" 2>/dev/null || echo 0)
  manifest_pv=$(jq -r '.manifest_plugin_version // "unknown"' "$selection" 2>/dev/null || echo "unknown")
  manifest_schema=$(jq -c '.manifest_schema // null' "$selection" 2>/dev/null || echo null)

  local new_repo_sha plugin_version stack
  new_repo_sha="$(git -C "$project_root" rev-parse --short HEAD 2>/dev/null || echo "unknown")"
  plugin_version="$(jq -r '.version // "unknown"' "$PLUGIN_ROOT/.claude-plugin/plugin.json" 2>/dev/null || echo "unknown")"
  stack="$(jq -r '.stack // "unknown"' "$run_dir/run-config.json" 2>/dev/null || echo "unknown")"

  local counts today
  counts="$(compute_verdict_summary "$run_dir/compare.json" "$run_dir/sanction-verified.json" "$selected_count")"
  today="$(date +%Y-%m-%d)"

  # Which bypass stubs this run's verdict rests on, and which backlog items
  # they taint. Recorded IN the evidence package, not merely in the report, so
  # a retained run can never be cited later as clean proof without the
  # qualification travelling with it. `module-status` reads stub_tainted_items
  # across runs to find each item's LATEST verdict.
  # Both read selection.json's `bl_items_resolved` — the acceptance-basis-derived
  # attribution — not the manifest's `verifies_backlog_item`, which on a
  # correctly-run project holds the placeholder and left both of these
  # permanently empty, so `module-status` had no item verdicts to read at all.
  local stubs_effect tainted_items covered_items stub_tainted_flag
  stubs_effect="$(jq -c '[ (.stubs_in_effect // [])[].id ]' "$selection" 2>/dev/null || echo '[]')"
  tainted_items="$(jq -c '[ .fixtures[] | select(((.stub_refs // []) | length) > 0)
                            | (.bl_items_resolved // [])[] ] | unique' "$selection" 2>/dev/null || echo '[]')"
  # Every BL item this run touched, tainted or not. Without it, "this item's
  # LATEST verdict is stub-tainted" is not computable: a later clean run would
  # be invisible, and the item would read as tainted forever.
  #
  # An ITEM-scoped run records EXACTLY the item it was asked about. Its
  # fixtures can legitimately resolve to other items too (two acceptance bases
  # sharing a rule), but this run is a statement about the one item named on the
  # command line — letting a shared fixture silently enter a second item's
  # verdict history would make `--item BL-020` quietly claim something about
  # BL-014. That is exactly the false-verdict problem the module rollup's
  # PARTIAL marking exists to prevent, applied to the item dimension.
  if [ "$(target_kind "$target")" = "item" ]; then
    covered_items="$(jq -nc --arg bl "$target" '[$bl]')"
  else
    covered_items="$(jq -c '[ .fixtures[] | (.bl_items_resolved // [])[] ] | unique' "$selection" 2>/dev/null || echo '[]')"
  fi
  stub_tainted_flag="$(jq -r 'if (.stub_tainted_exercised // 0) > 0 then "true" else "false" end' <<< "$counts")"

  # The split this run's item is carrying, recorded IN the evidence package for
  # the same reason stub taint is: a retained run must never be citable later as
  # this item's acceptance without the qualification travelling with it.
  # `not_final_acceptance` is the machine-readable form of the report's own
  # banner — a reviewer, or a CI job reading only the metadata, still cannot
  # mistake a partial run for a finished item.
  local item_split_meta not_final
  item_split_meta="$(jq -c '.item_split // null' "$selection" 2>/dev/null || echo null)"
  [ -n "$item_split_meta" ] || item_split_meta="null"
  if [ "$item_split_meta" = "null" ]; then not_final="false"; else not_final="true"; fi

  jq -n \
    --arg run_id "$run_id" \
    --arg target "$target" \
    --argjson bl_item "$bl_item" \
    --argjson module "$module_id" \
    --arg date "$today" \
    --arg legacy_sha "$legacy_sha" \
    --arg new_repo_sha "$new_repo_sha" \
    --arg plugin_version "$plugin_version" \
    --arg manifest_pv "$manifest_pv" \
    --argjson manifest_schema "$manifest_schema" \
    --arg stack "$stack" \
    --argjson selected_count "$selected_count" \
    --argjson counts "$counts" \
    --slurpfile stubs_in_effect_in "$(sc_payload fin_stubs "$stubs_effect")" \
    --slurpfile stub_tainted_items_in "$(sc_payload fin_tainted "$tainted_items")" \
    --slurpfile bl_items_covered_in "$(sc_payload fin_covered "$covered_items")" \
    --argjson stub_tainted "$stub_tainted_flag" \
    --slurpfile item_split_in "$(sc_payload fin_split "$item_split_meta")" \
    --argjson not_final_acceptance "$not_final" \
    '($stubs_in_effect_in[0]) as $stubs_in_effect
    | ($stub_tainted_items_in[0]) as $stub_tainted_items
    | ($bl_items_covered_in[0]) as $bl_items_covered
    | ($item_split_in[0]) as $item_split
    | {
      run_id: $run_id,
      target: $target,
      bl_item: $bl_item,
      module: $module,
      date: $date,
      legacy_commit_sha: $legacy_sha,
      new_repo_commit_sha: $new_repo_sha,
      plugin_version: $plugin_version,
      manifest_plugin_version: $manifest_pv,
      manifest_schema: $manifest_schema,
      stack: $stack,
      selected_count: $selected_count,
      counts: ($counts | del(.overall, .exit_code)),
      overall_verdict: $counts.overall,
      stub_tainted: $stub_tainted,
      stubs_in_effect: $stubs_in_effect,
      stub_tainted_items: $stub_tainted_items,
      bl_items_covered: $bl_items_covered,
      item_split: $item_split,
      not_final_acceptance: $not_final_acceptance
    }' > "$evidence_dir/run-metadata.json"

  # Committable-by-design: evidence is meant to travel with the change's PR.
  # If this repo's own .gitignore would swallow it, that's a real problem
  # to surface now, not discover later when the "proof" turns out untracked.
  if command -v git >/dev/null 2>&1 && git -C "$project_root" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    local rel_evidence_dir
    rel_evidence_dir="$(evidence_dir_rel "$target" "$run_id")"
    if git -C "$project_root" check-ignore -q -- "$rel_evidence_dir" 2>/dev/null; then
      warn "Evidence path ${rel_evidence_dir} is matched by this repo's .gitignore — it will NOT be tracked by git unless the ignore rule is adjusted. Evidence is meant to be committed with the change's PR as citable proof."
    fi
  fi

  # evidence-summary.md is change-scoped by design — a module is not a change
  # and has no per-change index to regenerate. A module run's evidence lives in
  # the shared pool, identified by its own run-metadata.json.
  [ "$(target_kind "$target")" = "change" ] && regenerate_evidence_summary "$specclaw_dir_abs" "$target"

  rm -rf "$run_dir"
  echo "Evidence retained at ${evidence_dir} (report.md, run-metadata.json, tests/, actual-results/, expected/, pipeline/). Working run directory removed."
}

# ─── Subcommand: prune-evidence ──────────────────────────────────────────────
# Explicit-only pruning of accumulated evidence runs. Never invoked as part
# of the normal replay pipeline — a human (or the skill, only when asked)
# runs it on its own, separate from any new replay.

cmd_prune_evidence() {
  require_jq
  local specclaw_dir="$1" target="$2" n="$3"
  if ! { [[ "$n" =~ ^[0-9]+$ ]] && [ "$n" -ge 1 ]; }; then
    die "--prune-evidence requires a positive integer (got '${n}')."
  fi

  local specclaw_dir_abs
  specclaw_dir_abs="$(cd "$specclaw_dir" && pwd)"

  if [ "$(target_kind "$target")" = "change" ]; then
    [ -d "${specclaw_dir_abs}/changes/${target}" ] || die "Change '${target}' not found under ${specclaw_dir_abs}/changes/."
  fi

  local evidence_root
  evidence_root="$(evidence_root_abs "$specclaw_dir_abs" "$target")"

  if [ ! -d "$evidence_root" ]; then
    echo "No evidence folder at ${evidence_root} — nothing to prune."
    return 0
  fi

  local -a run_dirs=()
  while IFS= read -r d; do
    run_dirs+=("$d")
  done < <(find "$evidence_root" -maxdepth 1 -type d -name 'run-*' 2>/dev/null | sort -r)

  local total="${#run_dirs[@]}"
  if [ "$total" -le "$n" ]; then
    echo "Only ${total} evidence run(s) present for ${target} (<= requested ${n}) — nothing pruned."
    return 0
  fi

  local i removed=0
  for (( i=n; i<total; i++ )); do
    rm -rf "${run_dirs[$i]}"
    removed=$((removed + 1))
  done

  # evidence-summary.md is change-scoped by design — a module is not a change
  # and has no per-change index to regenerate. A module run's evidence lives in
  # the shared pool, identified by its own run-metadata.json.
  [ "$(target_kind "$target")" = "change" ] && regenerate_evidence_summary "$specclaw_dir_abs" "$target"

  echo "Pruned ${removed} evidence run(s) for ${target}, keeping the newest ${n} (of ${total} total)."
}

# ─── Main ─────────────────────────────────────────────────────────────────────

case "${1:-}" in
  -h|--help)
    usage
    exit 0
    ;;
  parse-target)
    shift
    cmd_parse_target "$@"
    ;;
  resolve)
    [ $# -ge 4 ] || die "Usage: specclaw-bf-replay resolve <specclaw_dir> <change_name|BL-###|MOD-###|--all> <out_selection_json>"
    cmd_resolve "$2" "$3" "$4"
    ;;
  init-rundir)
    [ $# -ge 3 ] || die "Usage: specclaw-bf-replay init-rundir <specclaw_dir> <run_dir>"
    cmd_init_rundir "$2" "$3"
    ;;
  run-tests)
    [ $# -ge 3 ] || die "Usage: specclaw-bf-replay run-tests <specclaw_dir> <run_dir>"
    cmd_run_tests "$2" "$3"
    ;;
  compare)
    [ $# -ge 3 ] || die "Usage: specclaw-bf-replay compare <specclaw_dir> <run_dir>"
    cmd_compare "$2" "$3"
    ;;
  sanction-check)
    [ $# -ge 3 ] || die "Usage: specclaw-bf-replay sanction-check <specclaw_dir> <run_dir>"
    cmd_sanction_check "$2" "$3"
    ;;
  render)
    [ $# -ge 4 ] || die "Usage: specclaw-bf-replay render <specclaw_dir> <change_name|MOD-###|--all> <run_dir> [--discard]"
    cmd_render "$2" "$3" "$4" "${5:-}"
    ;;
  finalize)
    [ $# -ge 4 ] || die "Usage: specclaw-bf-replay finalize <specclaw_dir> <change_name|MOD-###|--all> <run_dir> [--keep|--discard]"
    cmd_finalize "$2" "$3" "$4" "${5:-}"
    ;;
  prune-evidence)
    [ $# -ge 4 ] || die "Usage: specclaw-bf-replay prune-evidence <specclaw_dir> <change_name|MOD-###|--all> <n>"
    cmd_prune_evidence "$2" "$3" "$4"
    ;;
  "")
    usage
    exit 1
    ;;
  *)
    die "Unknown subcommand: $1. Run specclaw-bf-replay --help for usage."
    ;;
esac
