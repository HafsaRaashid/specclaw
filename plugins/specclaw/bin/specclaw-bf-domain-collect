#!/usr/bin/env bash
# specclaw-bf-domain-collect — deterministic UI/domain fact-collection for /specclaw:bf-domain
#
# Delegates to specclaw-bf-analyze-codebase collect for everything that script
# already gathers (path validation, manifests, dependency_graph,
# discovered_docs), merges that JSON's fields (flat, not nested) with new
# domain-specific facts this command needs: .dfm form parsing (first-class),
# .xaml parsing (shallower), other UI-file detection, handler-to-
# implementation resolution, and a best-effort main-form hint.
#
# Fact-only: gathers, does not interpret (interpretation is the
# domain-analyst agent's job, downstream of this script).
#
# Bash + coreutils only (jq optional, used for output validation with a
# best-effort fallback — same tolerant pattern as every sibling script).
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# ─── Helpers ──────────────────────────────────────────────────────────────────

usage() {
  cat <<'EOF'
Usage: specclaw-bf-domain-collect <subcommand> [options]

Subcommands:
  collect       <specclaw_dir> [path]
                Deterministic fact-collection for /specclaw:bf-domain. Delegates
                to `specclaw-bf-analyze-codebase collect` for path validation,
                manifests, dependency_graph, and discovered_docs (merged flat
                into this script's own output), then adds: .dfm form parsing
                (controls, event handlers, at any depth), .xaml element
                parsing (one level of nesting), other UI-file detection
                (.cshtml etc.), handler-to-implementation resolution, and a
                best-effort main-form hint from a .dpr's first
                Application.CreateForm call. Outputs one JSON object to
                stdout.

                Also reports the module map (.specclaw/analysis/
                module-map.md): whether it exists, its Status line, and —
                read BEFORE /specclaw:bf-domain's own archive step — a
                roster of every existing MOD-### module's id, name, owned
                entities, rules, and active/withdrawn status, plus the next
                free MOD id. That roster is what lets the analyst agent
                carry surviving MOD ids forward on a regeneration instead
                of renumbering them; unlike scenarios.md, this document is
                reconciled, not freshly generated. ID-level facts only —
                no prose, no evidence text.

Options:
  -h, --help    Show this help message
EOF
}

die() { echo "ERROR: $*" >&2; exit 1; }
warn() { echo "WARN: $*" >&2; }

# JSON-escape a string: backslashes, quotes, newlines, tabs, carriage returns
# (copied verbatim from specclaw-bf-analyze-codebase — no shared lib, per repo
# convention).
json_escape() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\r'/\\r}"
  s="${s//$'\t'/\\t}"
  printf '%s' "$s"
}

# ─── Module map (.specclaw/analysis/module-map.md) ───────────────────────────
#
# Read here, in collect, for one reason: /specclaw:bf-domain archives the
# prior analysis documents BEFORE spawning the analyst agent, so by the time
# the agent runs, the live module map has already moved into
# .specclaw/analysis/archive/. MOD-### ids are permanent and must survive a
# regeneration (templates/module-map.md's reconciliation rules), which is
# impossible if the only copy of the prior roster is behind a timestamped
# archive filename the agent would have to guess at. So bash reads it while
# it is still at the known path and hands the agent ID-level facts —
# id/name/owned-entities/rules/status — exactly the "bash collects, agent
# interprets" split every sibling collector already follows. No prose and no
# evidence text crosses this boundary.

# One block per "### MOD-NNN" heading, written to <outdir>/MOD-NNN.md. Stops
# capturing at the next "## " section heading, not only at the next MOD
# heading — module-map.md has several "## " sections after "## Modules", and
# without that stop the last module block silently swallows all of them
# (the same trap specclaw-bf-rebuild-collect's split_blocks documents).
split_mod_blocks() {
  local file="$1" outdir="$2"
  [ -f "$file" ] || return 0
  awk -v dir="$outdir" '
    /^### MOD-[0-9]+/ {
      match($0, /MOD-[0-9]+/)
      id = substr($0, RSTART, RLENGTH)
      outfile = dir "/" id ".md"
    }
    /^## / && !/^### MOD-[0-9]+/ { id = "" }
    id != "" { print $0 >> outfile }
  ' "$file"
}

# A "- **Label:**" (or bare "**Label:**") single-line field's value.
#
# Matched with awk's index(), which is LITERAL — never a regex. Two of this
# document's own field labels contain parentheses ("Owns (entities)",
# "References (not owned)"), and under `sed -E` those parse as a capture
# group: the pattern then matches "Owns entities:" instead of the real label,
# the strip silently does nothing, and the field's value reads back with its
# own label still glued to the front. index() has no metacharacters to get
# wrong. Anchored at position 1 (after an optional "- ") so the same text
# appearing inside an Evidence bullet is never mistaken for the field.
mod_block_field() {
  local file="$1" label="$2"
  awk -v lbl="**${label}:**" '
    {
      s = $0
      sub(/^- /, "", s)
      if (index(s, lbl) == 1) {
        v = substr(s, length(lbl) + 1)
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", v)
        print v
        exit
      }
    }
  ' "$file" 2>/dev/null || true
}

# Heading text after the id and its separating em dash / hyphen. The
# separator alternation is deliberately NOT a bracket expression — under a
# byte-oriented sed build a POSIX bracket class eats only the first byte of a
# multi-byte em dash and corrupts every name after it (same guard
# specclaw-bf-rebuild-collect's block_title_after_dash carries).
mod_block_name() {
  head -1 "$1" | sed -E 's/^### MOD-[0-9]+[[:space:]]*(—|-)[[:space:]]*//'
}

# Comma-separated field value -> JSON array body. Each element is trimmed;
# a literal "None"/"none" (the documented empty value) yields no elements, so
# a module that owns nothing reads back as [] rather than as ["None"].
mod_csv_to_json_array() {
  local raw="$1" out="" first=true item
  local -a _items=()
  IFS=',' read -ra _items <<< "$raw"
  for item in ${_items[@]+"${_items[@]}"}; do
    item="${item#"${item%%[![:space:]]*}"}"
    item="${item%"${item##*[![:space:]]}"}"
    [ -z "$item" ] && continue
    case "$item" in None|none|NONE) continue ;; esac
    if $first; then first=false; else out="${out}, "; fi
    out="${out}\"$(json_escape "$item")\""
  done
  printf '%s' "$out"
}

# The map's own Status line: "PROPOSED" (awaiting human confirmation) or
# "CONFIRMED by <name>, <date>". Reported verbatim so downstream commands can
# say plainly which one they grouped by; never normalized or defaulted to the
# more convenient answer.
mod_map_status() {
  local file="$1"
  [ -f "$file" ] || { printf ''; return 0; }
  { grep -m1 -- '^\*\*Status:\*\*' "$file" 2>/dev/null \
    | sed -E 's/^\*\*Status:\*\* *//' | sed -E 's/[[:space:]]+$//'; } || true
}

# ─── .dfm extraction (first-class) — gather_dfm_forms ────────────────────────
#
# Depth-counted scan: an "object"/"inherited" line opens a new object and
# increments depth; a bare "end" line closes it and decrements depth. An
# object's OWN properties are the contiguous lines immediately following its
# opening line, before its first nested child or its own closing "end" —
# Delphi's form designer always serializes an object's own properties before
# its children, so a single "am I still in the properties span of the
# most-recently-opened, not-yet-closed object" flag is enough; no full
# per-object property stack is needed. Binary property blocks
# (`{...}`-delimited hex, e.g. Glyph.Data) match neither the object/end/
# caption/handler patterns below, so they are naturally skipped without
# desyncing the depth counter.

DFM_OBJLINE_RE='^[[:space:]]*(object|inherited)[[:space:]]+([^[:space:]:]+):[[:space:]]*([^[:space:]]+)'
DFM_END_RE='^[[:space:]]*end[[:space:]]*$'
DFM_CAPTION_RE=$'^[[:space:]]*(Caption|Text|Hint)[[:space:]]*=[[:space:]]*\'(.*)\'[[:space:]]*$'
DFM_HANDLER_RE='^[[:space:]]*(On[A-Za-z0-9_]+)[[:space:]]*=[[:space:]]*([A-Za-z_][A-Za-z0-9_]*)[[:space:]]*$'

# Parse one .dfm file into one JSON object (single line, printed to stdout,
# no trailing newline). Best-effort: never aborts the script on a malformed
# or binary file. Appends every handler_name found to $3 (one per line), for
# resolve_handler_implementations to consume later.
parse_one_dfm() {
  local abs_file="$1" rel_file="$2" handler_names_out="$3"

  local first_nonblank
  first_nonblank="$(grep -m1 '[^[:space:]]' "$abs_file" 2>/dev/null || true)"
  first_nonblank="${first_nonblank%$'\r'}"
  first_nonblank="${first_nonblank#$'\xef\xbb\xbf'}"

  if ! [[ "$first_nonblank" =~ ^(object|inherited)([^A-Za-z0-9_]|$) ]]; then
    printf '{"file": "%s", "parseable": false, "reason": "%s"}' \
      "$(json_escape "$rel_file")" "binary DFM format (or unrecognized text structure)"
    return 0
  fi

  local -a stack_name=() stack_class=()
  local root_name="" root_class="" root_caption=""
  local current_control_caption=""
  local controls_json="" first_control=true
  local handlers_json="" first_handler=true
  local capturing=false
  local line_num=0
  local line depth

  while IFS= read -r line || [ -n "$line" ]; do
    line_num=$((line_num + 1))
    line="${line%$'\r'}"
    if [ "$line_num" -eq 1 ]; then
      line="${line#$'\xef\xbb\xbf'}"
    fi

    if [[ "$line" =~ $DFM_OBJLINE_RE ]]; then
      local name="${BASH_REMATCH[2]}" class="${BASH_REMATCH[3]}"
      stack_name+=("$name")
      stack_class+=("$class")
      depth=${#stack_name[@]}
      if [ "$depth" -eq 1 ] && [ -z "$root_name" ]; then
        root_name="$name"
        root_class="$class"
      elif [ "$depth" -eq 2 ]; then
        current_control_caption=""
      fi
      capturing=true
      continue
    fi

    if [[ "$line" =~ $DFM_END_RE ]]; then
      depth=${#stack_name[@]}
      if [ "$depth" -gt 0 ]; then
        if [ "$depth" -eq 2 ]; then
          local cname="${stack_name[1]}" cclass="${stack_class[1]}"
          local ccap_json="null"
          [ -n "$current_control_caption" ] && ccap_json="\"$(json_escape "$current_control_caption")\""
          if $first_control; then first_control=false; else controls_json="${controls_json},"; fi
          controls_json="${controls_json}
      {\"name\": \"$(json_escape "$cname")\", \"class\": \"$(json_escape "$cclass")\", \"caption\": ${ccap_json}}"
        fi
        stack_name=("${stack_name[@]:0:$((depth-1))}")
        stack_class=("${stack_class[@]:0:$((depth-1))}")
      fi
      capturing=false
      continue
    fi

    if $capturing; then
      depth=${#stack_name[@]}
      if [ "$depth" -gt 0 ]; then
        if [[ "$line" =~ $DFM_CAPTION_RE ]]; then
          local capval="${BASH_REMATCH[2]}"
          if [ "$depth" -eq 1 ]; then
            root_caption="$capval"
          elif [ "$depth" -eq 2 ]; then
            current_control_caption="$capval"
          fi
        elif [[ "$line" =~ $DFM_HANDLER_RE ]]; then
          local top=$((depth - 1))
          local oname="${stack_name[$top]}" oclass="${stack_class[$top]}"
          local event="${BASH_REMATCH[1]}" handler="${BASH_REMATCH[2]}"
          printf '%s\n' "$handler" >> "$handler_names_out"
          if $first_handler; then first_handler=false; else handlers_json="${handlers_json},"; fi
          handlers_json="${handlers_json}
      {\"object_name\": \"$(json_escape "$oname")\", \"object_class\": \"$(json_escape "$oclass")\", \"event\": \"$(json_escape "$event")\", \"handler_name\": \"$(json_escape "$handler")\"}"
        fi
      fi
    fi
  done < "$abs_file"

  local root_caption_json="null"
  [ -n "$root_caption" ] && root_caption_json="\"$(json_escape "$root_caption")\""

  printf '{"file": "%s", "parseable": true, "root_name": "%s", "root_class": "%s", "root_caption": %s, "controls": [%s\n    ], "handlers": [%s\n    ]}' \
    "$(json_escape "$rel_file")" "$(json_escape "$root_name")" "$(json_escape "$root_class")" \
    "$root_caption_json" "$controls_json" "$handlers_json"
}

# Usage: gather_dfm_forms <scoped_files_file> <project_root> <handler_names_out>
gather_dfm_forms() {
  local files_file="$1" project_root="$2" handler_names_out="$3"
  local out="" first=true
  local rel entry
  while IFS= read -r rel; do
    [ -z "$rel" ] && continue
    case "$rel" in *.dfm) ;; *) continue ;; esac
    entry="$(parse_one_dfm "$project_root/$rel" "$rel" "$handler_names_out")"
    if $first; then first=false; else out="${out},"; fi
    out="${out}
    ${entry}"
  done < "$files_file"
  printf '%s' "$out"
}

# ─── .xaml extraction (shallower) — gather_xaml_forms ────────────────────────
#
# Plain XML tag/attribute extraction — the same cheap-and-reliable technique
# extract_dotnet_project_refs (in specclaw-bf-analyze-codebase) already uses for
# <ProjectReference> — element name, x:Name, and a Content/Header/Text
# attribute, one level of nesting (direct children of the XAML root element
# only). No binding/trigger/style/layout interpretation. The whole file is
# joined into one blob before tag-scanning (stripping CRLF first) because a
# real-world root element's attributes (xmlns, x:Class, ...) routinely wrap
# across several lines — a strictly per-line tag scan would never see a
# complete opening tag for it and would never reach depth 1.

parse_one_xaml() {
  local abs_file="$1" rel_file="$2"
  local depth=0
  local elements_json="" first_elem=true
  local content tag

  content="$(sed 's/\r$//' "$abs_file" 2>/dev/null | tr '\n' ' ' || true)"

  while IFS= read -r tag; do
    [ -z "$tag" ] && continue

    if [[ "$tag" =~ ^\</ ]]; then
      depth=$((depth - 1))
      continue
    fi

    local selfclosing=false
    [[ "$tag" =~ /\>$ ]] && selfclosing=true
    local parent_depth=$depth
    $selfclosing || depth=$((depth + 1))

    if [ "$parent_depth" -eq 1 ]; then
      local name=""
      [[ "$tag" =~ ^\<([A-Za-z0-9_:.]+) ]] && name="${BASH_REMATCH[1]}"

      local xname="" xcontent=""
      [[ "$tag" =~ x:Name=\"([^\"]*)\" ]] && xname="${BASH_REMATCH[1]}"
      if [[ "$tag" =~ Content=\"([^\"]*)\" ]]; then
        xcontent="${BASH_REMATCH[1]}"
      elif [[ "$tag" =~ Header=\"([^\"]*)\" ]]; then
        xcontent="${BASH_REMATCH[1]}"
      elif [[ "$tag" =~ Text=\"([^\"]*)\" ]]; then
        xcontent="${BASH_REMATCH[1]}"
      fi

      local xname_json="null" content_json="null"
      [ -n "$xname" ] && xname_json="\"$(json_escape "$xname")\""
      [ -n "$xcontent" ] && content_json="\"$(json_escape "$xcontent")\""

      if $first_elem; then first_elem=false; else elements_json="${elements_json},"; fi
      elements_json="${elements_json}
      {\"name\": \"$(json_escape "$name")\", \"x_name\": ${xname_json}, \"content\": ${content_json}}"
    fi
  done < <(grep -oE '<[^!?][^>]*>' <<< "$content" 2>/dev/null || true)

  printf '{"file": "%s", "elements": [%s\n    ]}' "$(json_escape "$rel_file")" "$elements_json"
}

# Usage: gather_xaml_forms <scoped_files_file> <project_root>
gather_xaml_forms() {
  local files_file="$1" project_root="$2"
  local out="" first=true
  local rel entry
  while IFS= read -r rel; do
    [ -z "$rel" ] && continue
    case "$rel" in *.xaml) ;; *) continue ;; esac
    entry="$(parse_one_xaml "$project_root/$rel" "$rel")"
    if $first; then first=false; else out="${out},"; fi
    out="${out}
    ${entry}"
  done < "$files_file"
  printf '%s' "$out"
}

# ─── Other UI formats — detection only — gather_other_ui_files ──────────────
#
# .cshtml and a small set of similarly UI-shaped, non-.dfm/.xaml view formats.
# Never deep-parsed in v1 — path recorded, nothing else.

# Usage: gather_other_ui_files <scoped_files_file>
gather_other_ui_files() {
  local files_file="$1"
  local out="" first=true
  local rel
  while IFS= read -r rel; do
    [ -z "$rel" ] && continue
    case "$rel" in
      *.cshtml|*.razor|*.aspx|*.ascx) ;;
      *) continue ;;
    esac
    if $first; then first=false; else out="${out},"; fi
    out="${out}
    {\"file\": \"$(json_escape "$rel")\", \"parseable\": false, \"reason\": \"not deep-parsed in v1 — detection only\"}"
  done < "$files_file"
  printf '%s' "$out"
}

# ─── Handler-to-implementation resolution ────────────────────────────────────
#
# For every distinct handler_name captured from .dfm forms, grep scoped .pas
# files for a matching `procedure T<Class>.<Handler>(` signature and scoped
# .cs files for an analogous method-name match. Records the first match
# found; a handler with no matching implementation in scope is omitted
# entirely — never guessed.

# Usage: resolve_handler_implementations <unique_handler_names_file> <scoped_files_file> <project_root>
resolve_handler_implementations() {
  local handler_names_file="$1" files_file="$2" project_root="$3"
  local out="" first=true
  local handler_name rel match

  while IFS= read -r handler_name; do
    [ -z "$handler_name" ] && continue
    local found_file="" found_line=""

    while IFS= read -r rel; do
      [ -z "$rel" ] && continue
      case "$rel" in
        *.pas)
          match="$(grep -nE "procedure[[:space:]]+T[A-Za-z0-9_]+\.${handler_name}[[:space:]]*\(" "$project_root/$rel" 2>/dev/null | head -1 || true)"
          ;;
        *.cs)
          match="$(grep -nE "\b${handler_name}[[:space:]]*\(" "$project_root/$rel" 2>/dev/null | head -1 || true)"
          ;;
        *) match="" ;;
      esac
      if [ -n "$match" ]; then
        found_file="$rel"
        found_line="${match%%:*}"
        break
      fi
    done < "$files_file"

    if [ -n "$found_file" ]; then
      if $first; then first=false; else out="${out},"; fi
      out="${out}
    {\"handler_name\": \"$(json_escape "$handler_name")\", \"file\": \"$(json_escape "$found_file")\", \"line\": ${found_line}}"
    fi
  done < "$handler_names_file"

  printf '%s' "$out"
}

# ─── Main-form hint (optional, never required) ───────────────────────────────
#
# If a .dpr file is in scope, parse its first Application.CreateForm(T<X>,
# ...) call for a main_form_hint. Absent (null) if no .dpr is in scope or the
# pattern doesn't match — forms[] is populated regardless either way.

# Usage: detect_main_form <scoped_files_file> <project_root>
detect_main_form() {
  local files_file="$1" project_root="$2"
  local dpr_file
  dpr_file="$(grep -E '\.dpr$' "$files_file" 2>/dev/null | head -1 || true)"
  if [ -z "$dpr_file" ]; then
    printf 'null'
    return 0
  fi

  local call
  call="$(grep -oE 'Application\.CreateForm\([[:space:]]*T[A-Za-z0-9_]+' "$project_root/$dpr_file" 2>/dev/null | head -1 || true)"
  if [ -z "$call" ]; then
    printf 'null'
    return 0
  fi

  local cls
  cls="$(printf '%s' "$call" | grep -oE 'T[A-Za-z0-9_]+$' || true)"
  if [ -z "$cls" ]; then
    printf 'null'
    return 0
  fi

  printf '"%s"' "$(json_escape "$cls")"
}

# ─── Pascal `interface`-section type declarations — gather_type_declarations ─
#
# Bounded-block scan: a line that is exactly `interface` opens the section, a
# line that is exactly `implementation` closes it — same in-section idiom
# `extract_maven_deps` (in specclaw-bf-analyze-codebase) uses for its
# <dependency>...</dependency> block. An enum's identifier list may span
# multiple lines before its closing `);` — accumulated into a buffer the same
# way `extract_uses_clause_units` accumulates a multi-line `uses` clause,
# then split on commas. `record`/`class` declarations are captured
# name/kind/location only — field lists are never parsed here (the agent
# reads the file itself for those).

PAS_INTERFACE_RE='^interface[[:space:]]*$'
PAS_IMPLEMENTATION_RE='^implementation[[:space:]]*$'
PAS_TYPE_ENUM_START_RE='^[[:space:]]*([A-Za-z_][A-Za-z0-9_]*)[[:space:]]*=[[:space:]]*\((.*)$'
PAS_TYPE_RECORD_CLASS_RE='^[[:space:]]*([A-Za-z_][A-Za-z0-9_]*)[[:space:]]*=[[:space:]]*(record|class)([^A-Za-z0-9_]|$)'

# Parse one .pas file's interface-section enum/record/class type
# declarations. Best-effort: never aborts the script on a malformed or
# unreadable file. Emits zero or more JSON entries (each prefixed with its
# own leading newline + indent, matching this script's other gather_*
# accumulation style); prints nothing if the file has no interface section or
# no matching declarations.
parse_one_pas_types() {
  local abs_file="$1" rel_file="$2"
  [ -r "$abs_file" ] || return 0

  local in_interface=false accumulating=false
  local buf="" start_line=0 enum_name=""
  local line line_num=0
  local out="" first=true

  while IFS= read -r line || [ -n "$line" ]; do
    line_num=$((line_num + 1))
    line="${line%$'\r'}"

    if ! $in_interface; then
      [[ "$line" =~ $PAS_INTERFACE_RE ]] && in_interface=true
      continue
    fi
    if [[ "$line" =~ $PAS_IMPLEMENTATION_RE ]]; then
      in_interface=false
      accumulating=false
      continue
    fi

    if $accumulating; then
      buf="${buf} ${line}"
    elif [[ "$line" =~ $PAS_TYPE_ENUM_START_RE ]]; then
      enum_name="${BASH_REMATCH[1]}"
      buf="${BASH_REMATCH[2]}"
      start_line=$line_num
      accumulating=true
    elif [[ "$line" =~ $PAS_TYPE_RECORD_CLASS_RE ]]; then
      local rname="${BASH_REMATCH[1]}" rkind="${BASH_REMATCH[2]}"
      if $first; then first=false; else out="${out},"; fi
      out="${out}
    {\"name\": \"$(json_escape "$rname")\", \"kind\": \"$(json_escape "$rkind")\", \"file\": \"$(json_escape "$rel_file")\", \"line\": ${line_num}}"
      continue
    else
      continue
    fi

    if $accumulating && [[ "$buf" == *\)\;* ]]; then
      local list="${buf%%\)\;*}"
      local -a ids
      IFS=',' read -ra ids <<< "$list"
      local values_json="" first_val=true id
      for id in "${ids[@]}"; do
        id="${id#"${id%%[![:space:]]*}"}"
        id="${id%"${id##*[![:space:]]}"}"
        [ -z "$id" ] && continue
        if $first_val; then first_val=false; else values_json="${values_json}, "; fi
        values_json="${values_json}\"$(json_escape "$id")\""
      done
      if $first; then first=false; else out="${out},"; fi
      out="${out}
    {\"name\": \"$(json_escape "$enum_name")\", \"kind\": \"enum\", \"values\": [${values_json}], \"file\": \"$(json_escape "$rel_file")\", \"line\": ${start_line}}"
      accumulating=false
      buf=""
    fi
  done < "$abs_file"

  printf '%s' "$out"
}

# Usage: gather_type_declarations <scoped_files_file> <project_root>
gather_type_declarations() {
  local files_file="$1" project_root="$2"
  local out="" first=true
  local rel entry
  while IFS= read -r rel; do
    [ -z "$rel" ] && continue
    case "$rel" in *.pas) ;; *) continue ;; esac
    entry="$(parse_one_pas_types "$project_root/$rel" "$rel")"
    [ -z "$entry" ] && continue
    if $first; then first=false; else out="${out},"; fi
    out="${out}${entry}"
  done < "$files_file"
  printf '%s' "$out"
}

# ─── Pascal `interface`-section const declarations — gather_const_declarations
#
# Same `interface`/`implementation` bounded scan as gather_type_declarations,
# plus a nested `const` sub-block: a line matching `^const\b` opens it, the
# next `type`/`var`/`implementation`/`interface` keyword line closes it. Only
# simple scalar values (a bare number or a single-quoted string — not a
# computed expression or a reference to another identifier) are captured;
# the raw text of the value is recorded as-is (quotes included for strings),
# not unescaped/re-typed.

PAS_CONST_START_RE='^const[[:space:]]*$'
PAS_CONST_END_RE='^(type|var|implementation|interface)[[:space:]]*$'
PAS_CONST_LINE_RE="^[[:space:]]*([A-Za-z_][A-Za-z0-9_]*)[[:space:]]*=[[:space:]]*('[^']*'|-?[0-9]+(\.[0-9]+)?)[[:space:]]*;"

# Parse one .pas file's interface-section const declarations. Best-effort:
# never aborts the script on a malformed or unreadable file.
parse_one_pas_consts() {
  local abs_file="$1" rel_file="$2"
  [ -r "$abs_file" ] || return 0

  local in_interface=false in_const=false
  local line line_num=0
  local out="" first=true

  while IFS= read -r line || [ -n "$line" ]; do
    line_num=$((line_num + 1))
    line="${line%$'\r'}"

    if ! $in_interface; then
      [[ "$line" =~ $PAS_INTERFACE_RE ]] && in_interface=true
      continue
    fi
    if [[ "$line" =~ $PAS_IMPLEMENTATION_RE ]]; then
      in_interface=false
      in_const=false
      continue
    fi

    if $in_const; then
      if [[ "$line" =~ $PAS_CONST_END_RE ]]; then
        in_const=false
        continue
      fi
      if [[ "$line" =~ $PAS_CONST_LINE_RE ]]; then
        local cname="${BASH_REMATCH[1]}" cval="${BASH_REMATCH[2]}"
        if $first; then first=false; else out="${out},"; fi
        out="${out}
    {\"name\": \"$(json_escape "$cname")\", \"value\": \"$(json_escape "$cval")\", \"file\": \"$(json_escape "$rel_file")\", \"line\": ${line_num}}"
      fi
      continue
    fi

    [[ "$line" =~ $PAS_CONST_START_RE ]] && in_const=true
  done < "$abs_file"

  printf '%s' "$out"
}

# Usage: gather_const_declarations <scoped_files_file> <project_root>
gather_const_declarations() {
  local files_file="$1" project_root="$2"
  local out="" first=true
  local rel entry
  while IFS= read -r rel; do
    [ -z "$rel" ] && continue
    case "$rel" in *.pas) ;; *) continue ;; esac
    entry="$(parse_one_pas_consts "$project_root/$rel" "$rel")"
    [ -z "$entry" ] && continue
    if $first; then first=false; else out="${out},"; fi
    out="${out}${entry}"
  done < "$files_file"
  printf '%s' "$out"
}

# ─── Business-rule candidate extraction — gather_validation_candidates ──────
#
# Scans every scoped .pas and .cs file for routine signatures whose name
# starts with, case-insensitively, "valid" (covers "validate" too), "check",
# or "can" — false positives like `CanRedo` are expected and accepted (the
# agent decides relevance later, not this bash layer). For each match, the
# full routine body is captured by a depth-counted scan in the grammar of the
# language the signature was found in:
#
#   .pas → capture_pascal_body: the first `begin` line after the signature
#          (skipping any local var declarations in between) opens the body,
#          then `begin`/`end;` (case-insensitive) track depth until it
#          returns to 0 — the matching top-level `end;`.
#   .cs  → capture_csharp_body: the first `{` at or after the signature line
#          opens the body, then `{`/`}` are counted per character until depth
#          returns to 0 — the method's own closing brace. An expression-
#          bodied member (`=> expr;`) is captured through its terminating `;`.
#
# Either way the body is capped at 100 lines, truncation labeled the same way
# `specclaw-verify collect` labels its own 200-line file cap
# ("... (truncated, N total lines)").
#
# Known, accepted limitation (spec FR10): neither depth counter has any
# concept of comments or string literals — a comment or string containing the
# literal word "begin"/"end", or a literal `{`/`}`, can misalign it. Same
# best-effort, no-real-parser tolerance every extractor in this script and its
# sibling specclaw-bf-analyze-codebase already accepts.

VALIDATION_NAME_RE='^(valid|check|can)'
PAS_ROUTINE_SIG_RE='^[[:space:]]*(procedure|function)[[:space:]]+([A-Za-z_][A-Za-z0-9_]*\.)?([A-Za-z_][A-Za-z0-9_]*)[[:space:]]*\('
CS_ROUTINE_SIG_RE='^[[:space:]]*(public|private|protected|internal|static)[[:space:]]+.*[[:space:]]([A-Za-z_][A-Za-z0-9_]*)[[:space:]]*\('
VALIDATION_BEGIN_RE='^[[:space:]]*[Bb][Ee][Gg][Ii][Nn]([^A-Za-z0-9_]|$)'
VALIDATION_END_RE='^[[:space:]]*[Ee][Nn][Dd];[[:space:]]*$'

# Both capture_*_body functions publish their result here rather than trying to
# return an array. Reset by each call.
VALIDATION_BODY_LINES=()

# capture_pascal_body <signature_index>
#
# Reads `lines`, `total` and `sig_re` from its caller (parse_one_validation_file)
# by bash's dynamic scoping. Sets VALIDATION_BODY_LINES to the captured body,
# returns 1 when the routine has no body in this file.
#
# Find the first `begin` after the signature, skipping any local var
# declarations in between. A forward/interface declaration (no body of its own
# — its actual implementation, if any, appears later in the file and is matched
# independently when the outer loop reaches it) is recognized by hitting
# another routine signature or an interface/implementation keyword line before
# any `begin` — bail without emitting rather than misattributing a later
# routine's body.
capture_pascal_body() {
  local i="$1"
  VALIDATION_BODY_LINES=()

  local j=$((i + 1)) found_begin=false
  while [ "$j" -lt "$total" ]; do
    if [[ "${lines[$j]}" =~ $VALIDATION_BEGIN_RE ]]; then
      found_begin=true
      break
    fi
    if [[ "${lines[$j]}" =~ $sig_re ]] || [[ "${lines[$j]}" =~ $PAS_IMPLEMENTATION_RE ]] || [[ "${lines[$j]}" =~ $PAS_INTERFACE_RE ]]; then
      break
    fi
    j=$((j + 1))
  done
  $found_begin || return 1

  local depth=1 k=$((j + 1))
  while [ "$k" -lt "$total" ] && [ "$depth" -gt 0 ]; do
    local bline="${lines[$k]}"
    VALIDATION_BODY_LINES+=("$bline")
    [[ "$bline" =~ $VALIDATION_BEGIN_RE ]] && depth=$((depth + 1))
    [[ "$bline" =~ $VALIDATION_END_RE ]] && depth=$((depth - 1))
    k=$((k + 1))
  done
  return 0
}

# capture_csharp_body <signature_index>
#
# Same contract as capture_pascal_body (dynamic scoping in,
# VALIDATION_BODY_LINES out, 1 = no body here).
#
# Scan forward from the signature line for whichever comes first:
#   `{`  → braced body. Depth-count `{`/`}` per character from that brace;
#          the body ends when depth returns to 0. Capture stops AT that
#          closing brace, so a body never swallows the next method.
#   `=>` → expression-bodied member. Capture through the terminating `;`.
# A signature line that ends in `;` with no `=>` is a declaration only
# (interface member, abstract/partial method) — bail without emitting. So is a
# scan that reaches the next signature before finding either opener; the
# implementation, if there is one, is matched independently by the outer loop.
capture_csharp_body() {
  local i="$1"
  VALIDATION_BODY_LINES=()

  local sig_line="${lines[$i]}"
  local sig_trimmed="${sig_line%"${sig_line##*[![:space:]]}"}"
  if [[ "$sig_line" != *'=>'* && "$sig_trimmed" == *';' ]]; then
    return 1
  fi

  # Locate the opener. `form` is brace|expr, `start_line` the line holding it.
  local n="$i" form="" start_line=-1
  while [ "$n" -lt "$total" ]; do
    local ln="${lines[$n]}"
    # Checked before the opener scan: a `{` on a LATER signature's line
    # belongs to that signature, not this one.
    if [ "$n" -gt "$i" ] && [[ "$ln" =~ $sig_re ]]; then
      break
    fi
    local bpos=-1 apos=-1 pre
    if [[ "$ln" == *'{'* ]]; then pre="${ln%%'{'*}"; bpos=${#pre}; fi
    if [[ "$ln" == *'=>'* ]]; then pre="${ln%%'=>'*}"; apos=${#pre}; fi
    if [ "$bpos" -ge 0 ] && [ "$apos" -ge 0 ]; then
      if [ "$apos" -lt "$bpos" ]; then form="expr"; else form="brace"; fi
      start_line="$n"
      break
    elif [ "$bpos" -ge 0 ]; then
      form="brace"; start_line="$n"; break
    elif [ "$apos" -ge 0 ]; then
      form="expr"; start_line="$n"; break
    fi
    n=$((n + 1))
  done
  [ "$start_line" -ge 0 ] || return 1

  if [ "$form" = "expr" ]; then
    local k="$start_line" seg bline
    while [ "$k" -lt "$total" ]; do
      bline="${lines[$k]}"
      if [ "$k" -eq "$start_line" ]; then
        seg="=>${bline#*'=>'}"
      else
        seg="$bline"
      fi
      if [[ "$seg" == *';'* ]]; then
        VALIDATION_BODY_LINES+=("${seg%%;*};")
        break
      fi
      VALIDATION_BODY_LINES+=("$seg")
      k=$((k + 1))
    done
    return 0
  fi

  local depth=0 k="$start_line" seg bline len p stop ch
  while [ "$k" -lt "$total" ]; do
    bline="${lines[$k]}"
    if [ "$k" -eq "$start_line" ]; then
      # Count from the opening brace onward — text before it is signature.
      seg="{${bline#*'{'}"
    else
      seg="$bline"
    fi
    len=${#seg}; p=0; stop=-1
    while [ "$p" -lt "$len" ]; do
      ch="${seg:$p:1}"
      if [ "$ch" = "{" ]; then
        depth=$((depth + 1))
      elif [ "$ch" = "}" ]; then
        depth=$((depth - 1))
        if [ "$depth" -le 0 ]; then stop="$p"; break; fi
      fi
      p=$((p + 1))
    done
    if [ "$k" -eq "$start_line" ]; then
      # The opening line contributes only what follows its `{` — usually
      # nothing, for `{` on its own line.
      local first_seg="${seg:1}"
      [ "$stop" -ge 0 ] && first_seg="${seg:1:$((stop - 1))}"
      [ -n "${first_seg//[[:space:]]/}" ] && VALIDATION_BODY_LINES+=("$first_seg")
    else
      VALIDATION_BODY_LINES+=("$bline")
    fi
    [ "$stop" -ge 0 ] && break
    k=$((k + 1))
  done
  return 0
}

# Parse one .pas or .cs file for validation-candidate routines. Best-effort:
# never aborts on a malformed or unreadable file. Reads the whole file into
# an array once so the body can be looked ahead for its opening `begin` and
# matching `end;` without re-reading the file per match.
parse_one_validation_file() {
  local abs_file="$1" rel_file="$2" sig_re="$3" name_group="$4" lang="$5"
  [ -r "$abs_file" ] || return 0

  local -a lines=()
  local line
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line%$'\r'}"
    lines+=("$line")
  done < "$abs_file"

  local total=${#lines[@]}
  local out="" first=true
  local i
  for ((i = 0; i < total; i++)); do
    line="${lines[$i]}"
    [[ "$line" =~ $sig_re ]] || continue
    local name="${BASH_REMATCH[$name_group]}"
    local name_lower
    name_lower="$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]')"
    [[ "$name_lower" =~ $VALIDATION_NAME_RE ]] || continue

    local sig_line_num=$((i + 1))

    # ── Body-parser dispatch, keyed on the language of the file the signature
    # was found in (`lang`, mapped from the file extension by
    # gather_validation_candidates below).
    #
    # WHY THIS EXISTS: signature matching has always covered both .pas and
    # .cs, but body capture used to be Pascal-only — one forward search for
    # `begin`. A C# method body opens with `{`, so that search never
    # succeeded and every matched C# method was SILENTLY DROPPED, which could
    # leave validation_routine_candidates[] empty for a C# codebase full of
    # validation methods. This is syntax-driven parsing of a file we already
    # decided to scan, not a per-stack template: bash still only computes
    # facts, the agent still does all interpretation.
    #
    # Neither parser is comment- or string-literal-aware (see the section
    # header's FR10 note) — a `}` inside a string, or the word "end" inside a
    # comment, can misalign the depth count. Deliberate: a real tokenizer is
    # out of proportion to what this layer is for.
    #
    # And what this layer is for is HINTS. validation_routine_candidates[] is
    # a narrow naming heuristic (Valid*/Check*/Can*), never the exhaustive
    # set of a codebase's business rules — bf-domain-analyst is required to
    # read source directly for rules this never surfaces, and to treat an
    # empty array as "the heuristic found nothing", never as "there are no
    # business rules here".
    #
    # Any other extension reaching here keeps the pre-existing Pascal
    # behavior; today gather_validation_candidates admits only .pas and .cs.
    case "$lang" in
      csharp) capture_csharp_body "$i" || continue ;;
      *)      capture_pascal_body "$i" || continue ;;
    esac
    local -a body_lines=()
    [ ${#VALIDATION_BODY_LINES[@]} -gt 0 ] && body_lines=("${VALIDATION_BODY_LINES[@]}")

    local total_body=${#body_lines[@]}
    local -a capped=("${body_lines[@]}")
    [ "$total_body" -gt 100 ] && capped=("${body_lines[@]:0:100}")

    local body="" bl
    for bl in "${capped[@]}"; do
      if [ -z "$body" ]; then body="$bl"; else body="${body}
${bl}"; fi
    done
    if [ "$total_body" -gt 100 ]; then
      body="${body}
... (truncated, ${total_body} total lines)"
    fi

    if $first; then first=false; else out="${out},"; fi
    out="${out}
    {\"name\": \"$(json_escape "$name")\", \"file\": \"$(json_escape "$rel_file")\", \"line\": ${sig_line_num}, \"body\": \"$(json_escape "$body")\"}"
  done

  printf '%s' "$out"
}

# Usage: gather_validation_candidates <scoped_files_file> <project_root>
gather_validation_candidates() {
  local files_file="$1" project_root="$2"
  local out="" first=true
  local rel entry sig_re name_group lang
  while IFS= read -r rel; do
    [ -z "$rel" ] && continue
    # File extension is the dispatch key for both the signature regex and the
    # body parser — see the dispatch comment in parse_one_validation_file.
    case "$rel" in
      *.pas) sig_re="$PAS_ROUTINE_SIG_RE"; name_group=3; lang="pascal" ;;
      *.cs)  sig_re="$CS_ROUTINE_SIG_RE";  name_group=2; lang="csharp" ;;
      *) continue ;;
    esac
    entry="$(parse_one_validation_file "$project_root/$rel" "$rel" "$sig_re" "$name_group" "$lang")"
    [ -z "$entry" ] && continue
    if $first; then first=false; else out="${out},"; fi
    out="${out}${entry}"
  done < "$files_file"
  printf '%s' "$out"
}

# ─── Subcommand: collect ──────────────────────────────────────────────────────

cmd_collect() {
  local specclaw_dir="$1"
  local target_path="${2:-.}"

  local analyze_bin="$SCRIPT_DIR/specclaw-bf-analyze-codebase"
  [ -f "$analyze_bin" ] || die "required sibling script not found: $analyze_bin"

  # Step 1: delegate — reuses path validation, manifests, dependency_graph,
  # discovered_docs. A non-zero exit here (bad [path]) propagates verbatim;
  # its stderr is inherited (not redirected), so the delegated die message
  # already reaches our own stderr unmodified. We do not re-validate the
  # path ourselves.
  local delegated
  delegated="$(bash "$analyze_bin" collect "$specclaw_dir" "$target_path")" || exit $?

  # Step 2: merge, not nest. delegated is known to start with "{" and end
  # with "}" (analyze-codebase's own json_escape() guarantees no unescaped
  # brace at those exact boundary positions) — strip exactly one char off
  # each end to splice its body into our own flat object.
  local delegated_body="${delegated:1:${#delegated}-2}"

  # Step 3: re-enumerate the scoped file list ourselves — the delegated JSON
  # has no field that is itself "every file path in scope," only summaries
  # derived from one. project_root/scope_dir are re-derived mechanically
  # (delegation above already proved them valid) — no validation logic of
  # our own is added here.
  local specclaw_dir_abs project_root scope_dir rel_scope
  specclaw_dir_abs="$(cd "$specclaw_dir" && pwd)"
  project_root="$(cd "$specclaw_dir_abs/.." && pwd)"
  scope_dir="$(cd "$project_root/$target_path" && pwd)"
  rel_scope="${scope_dir#"$project_root"}"
  rel_scope="${rel_scope#/}"

  local tmp_all tmp_scoped
  tmp_all="$(mktemp)"
  tmp_scoped="$(mktemp)"

  # Same git/find fallback specclaw-bf-analyze-codebase's own collect uses.
  if git -C "$project_root" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    git -C "$project_root" ls-files -z 2>/dev/null | tr '\0' '\n' > "$tmp_all"
  else
    (
      cd "$project_root" || exit 0
      find . \( -name .git -o -name node_modules -o -name .specclaw -o -name vendor -o -name dist -o -name build \) -prune \
        -o -type f -print 2>/dev/null | sed 's|^\./||'
    ) > "$tmp_all"
  fi

  # Scope to [path] by prefix, and always exclude .specclaw's own state plus
  # vendored/generated directories — applied uniformly regardless of
  # enumeration method, same as specclaw-bf-analyze-codebase's own post-filter.
  while IFS= read -r f; do
    [ -z "$f" ] && continue
    case "$f" in
      .specclaw|.specclaw/*) continue ;;
      node_modules/*|*/node_modules/*) continue ;;
      vendor/*|*/vendor/*) continue ;;
      dist/*|*/dist/*) continue ;;
      build/*|*/build/*) continue ;;
    esac
    if [ -z "$rel_scope" ]; then
      printf '%s\n' "$f" >> "$tmp_scoped"
    else
      case "$f" in
        "$rel_scope"|"$rel_scope"/*) printf '%s\n' "$f" >> "$tmp_scoped" ;;
      esac
    fi
  done < "$tmp_all"

  # Step 4: new extraction, each independent, each best-effort.
  local handler_names_tmp handler_names_sorted
  handler_names_tmp="$(mktemp)"
  handler_names_sorted="$(mktemp)"

  local forms_json xaml_json other_ui_json handler_impls_json main_form_hint_json
  local type_decls_json const_decls_json validation_cands_json
  forms_json="$(gather_dfm_forms "$tmp_scoped" "$project_root" "$handler_names_tmp")"
  xaml_json="$(gather_xaml_forms "$tmp_scoped" "$project_root")"
  other_ui_json="$(gather_other_ui_files "$tmp_scoped")"

  sort -u "$handler_names_tmp" > "$handler_names_sorted" 2>/dev/null || true
  handler_impls_json="$(resolve_handler_implementations "$handler_names_sorted" "$tmp_scoped" "$project_root")"
  main_form_hint_json="$(detect_main_form "$tmp_scoped" "$project_root")"
  type_decls_json="$(gather_type_declarations "$tmp_scoped" "$project_root")"
  const_decls_json="$(gather_const_declarations "$tmp_scoped" "$project_root")"
  validation_cands_json="$(gather_validation_candidates "$tmp_scoped" "$project_root")"

  rm -f "$tmp_all" "$tmp_scoped" "$handler_names_tmp" "$handler_names_sorted"

  # Step 5: assemble — delegated_body's fields plus the new ones, one flat object.
  local pq_present=false pq_path="" clar_present=false clar_path=""
  if [ -f "$specclaw_dir_abs/analysis/pending-questions.md" ]; then
    pq_present=true; pq_path=".specclaw/analysis/pending-questions.md"
  fi
  if [ -f "$specclaw_dir_abs/analysis/clarifications.md" ]; then
    clar_present=true; clar_path=".specclaw/analysis/clarifications.md"
  fi

  # architecture.md is a soft input reported for one purpose: it is the only
  # document that evidences dependency DIRECTION between modules. When it is
  # absent the agent derives dependencies from entity/service references
  # instead and says so — it never asserts a direction it cannot cite.
  local arch_present=false arch_path=""
  if [ -f "$specclaw_dir_abs/analysis/architecture.md" ]; then
    arch_present=true; arch_path=".specclaw/analysis/architecture.md"
  fi

  # ── Prior module roster, for MOD-### reconciliation ────────────────────
  local map_file="$specclaw_dir_abs/analysis/module-map.md"
  local map_present=false map_status="" modules_json="" next_mod_num=1
  if [ -f "$map_file" ]; then
    map_present=true
    map_status="$(mod_map_status "$map_file")"
    local modworkdir; modworkdir="$(mktemp -d)"
    split_mod_blocks "$map_file" "$modworkdir"
    local mfirst=true mf mid mname mstatus mowned mrules mnum
    for mf in "$modworkdir"/MOD-*.md; do
      [ -f "$mf" ] || continue
      mid="$(basename "$mf" .md)"
      mnum="${mid#MOD-}"; mnum=$((10#$mnum))
      [ "$mnum" -ge "$next_mod_num" ] && next_mod_num=$((mnum + 1))
      mname="$(mod_block_name "$mf")"
      # A withdrawn module is reported, never omitted — its id must stay
      # claimed so it is never reused, and it must never be matched as a
      # reconciliation candidate and silently revived.
      case "$mname" in WITHDRAWN*) mstatus="withdrawn" ;; *) mstatus="active" ;; esac
      mowned="$(mod_csv_to_json_array "$(mod_block_field "$mf" "Owns (entities)")")"
      mrules="$({ grep -oE 'DR-[0-9]{3}' "$mf" 2>/dev/null | awk '!seen[$0]++'; } || true)"
      local mrules_json="" rfirst=true r
      while IFS= read -r r; do
        [ -z "$r" ] && continue
        if $rfirst; then rfirst=false; else mrules_json="${mrules_json}, "; fi
        mrules_json="${mrules_json}\"$(json_escape "$r")\""
      done <<< "$mrules"
      if $mfirst; then mfirst=false; else modules_json="${modules_json},"; fi
      modules_json="${modules_json}
    {\"mod_id\": \"$(json_escape "$mid")\", \"name\": \"$(json_escape "$mname")\", \"status\": \"${mstatus}\", \"owned_entities\": [${mowned}], \"dr_rules\": [${mrules_json}]}"
    done
    rm -rf "$modworkdir"
  fi
  local next_mod_id; next_mod_id="$(printf 'MOD-%03d' "$next_mod_num")"

  local output
  output=$(cat <<ENDJSON
{
  ${delegated_body},
  "pending_questions": {"present": ${pq_present}, "path": "$(json_escape "$pq_path")"},
  "clarifications": {"present": ${clar_present}, "path": "$(json_escape "$clar_path")"},
  "architecture_md": {"present": ${arch_present}, "path": "$(json_escape "$arch_path")"},
  "module_map": {
    "present": ${map_present},
    "path": ".specclaw/analysis/module-map.md",
    "status": "$(json_escape "$map_status")",
    "next_mod_id": "$(json_escape "$next_mod_id")",
    "prior_modules": [${modules_json}
    ]
  },
  "forms": [${forms_json}
  ],
  "xaml_forms": [${xaml_json}
  ],
  "other_ui_files": [${other_ui_json}
  ],
  "handler_implementations": [${handler_impls_json}
  ],
  "main_form_hint": ${main_form_hint_json},
  "type_declarations": [${type_decls_json}
  ],
  "const_declarations": [${const_decls_json}
  ],
  "validation_routine_candidates": [${validation_cands_json}
  ]
}
ENDJSON
)

  if command -v jq &>/dev/null; then
    if printf '%s' "$output" | jq . >/dev/null 2>&1; then
      printf '%s\n' "$output"
    else
      warn "JSON validation failed, outputting best-effort"
      printf '%s\n' "$output"
    fi
  else
    printf '%s\n' "$output"
  fi
}

# ─── Main ─────────────────────────────────────────────────────────────────────

case "${1:-}" in
  -h|--help)
    usage
    exit 0
    ;;
  collect)
    [ $# -ge 2 ] || die "Usage: specclaw-bf-domain-collect collect <specclaw_dir> [path]"
    cmd_collect "$2" "${3:-.}"
    ;;
  "")
    usage
    exit 1
    ;;
  *)
    die "Unknown subcommand: $1. Run specclaw-bf-domain-collect --help for usage."
    ;;
esac
