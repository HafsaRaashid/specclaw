#!/usr/bin/env bash
# specclaw-analyze-codebase — deterministic codebase fact-collection for /specclaw:analyze
#
# Gathers file enumeration, manifest/dependency detection, LOC-per-extension,
# test-location detection, and discovered project docs into one JSON object.
# Fact-only: gathers, does not interpret (interpretation is the codebase-analyst
# agent's job, downstream of this script).
#
# Bash + coreutils only (jq optional, used for output validation with a
# best-effort fallback — same tolerant pattern as specclaw-verify).
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# ─── Helpers ──────────────────────────────────────────────────────────────────

usage() {
  cat <<'EOF'
Usage: specclaw-analyze-codebase <subcommand> [options]

Subcommands:
  collect       <specclaw_dir> [path]
                Deterministic fact-collection for /specclaw:analyze. Scopes to
                [path] (default: repository root, i.e. the parent of
                <specclaw_dir>): enumerates files, detects and best-effort
                parses dependency manifests (package.json, *.csproj/*.sln,
                pom.xml, go.mod, Cargo.toml, requirements.txt/pyproject.toml,
                *.dpr/*.dproj, Makefile), computes LOC per file extension,
                finds test-like directories, and embeds discovered project
                docs (via specclaw-discover-context). Outputs one JSON object
                to stdout.

Options:
  -h, --help    Show this help message
EOF
}

die() { echo "ERROR: $*" >&2; exit 1; }
warn() { echo "WARN: $*" >&2; }

# JSON-escape a string: backslashes, quotes, newlines, tabs, carriage returns
# (copied verbatim from specclaw-verify — no shared lib, per repo convention).
json_escape() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\r'/\\r}"
  s="${s//$'\t'/\\t}"
  printf '%s' "$s"
}

# Read newline-delimited items from stdin, print a compact single-line JSON
# array body (no brackets — caller wraps; no embedded newlines, since manifest
# entries built with this are later re-joined by reading a tmp file line by
# line — a multi-line array would be mistaken for multiple entries there).
# Blank lines are skipped.
json_array_from_lines() {
  local item first=true out=""
  while IFS= read -r item; do
    [ -z "$item" ] && continue
    if $first; then first=false; else out="${out}, "; fi
    out="${out}\"$(json_escape "$item")\""
  done
  printf '%s' "$out"
}

# Read "key<TAB>value" lines from stdin (value must be a bare JSON number),
# print a JSON object body (no braces — caller wraps).
json_object_from_kv_lines() {
  local key value first=true out=""
  while IFS=$'\t' read -r key value; do
    [ -z "$key" ] && continue
    if $first; then first=false; else out="${out},"; fi
    out="${out}
    \"$(json_escape "$key")\": ${value}"
  done
  printf '%s' "$out"
}

# Filter a scoped-files list (one repo-relative path per line, from a file) to
# entries whose basename matches a glob pattern. Usage:
#   match_files_by_name <files_file> <glob_pattern>
match_files_by_name() {
  local files_file="$1" pattern="$2" f
  while IFS= read -r f; do
    [ -z "$f" ] && continue
    case "${f##*/}" in
      $pattern) printf '%s\n' "$f" ;;
    esac
  done < "$files_file"
}

# ─── Per-format best-effort dependency/version extractors ────────────────────
# All grep/sed/awk — no real parser. Every extractor's final statement ends in
# `|| true` so a malformed or unreadable manifest file never aborts the script.

extract_node_deps() {
  local file="$1"
  awk '
    /"dependencies"[[:space:]]*:/ { indep=1; next }
    /"devDependencies"[[:space:]]*:/ { indep=1; next }
    indep && /^[[:space:]]*}/ { indep=0; next }
    indep && match($0, /"[^"]+"/) { print substr($0, RSTART+1, RLENGTH-2) }
  ' "$file" 2>/dev/null || true
}

extract_node_version_signal() {
  local file="$1"
  awk '
    /"engines"[[:space:]]*:/ { ineng=1 }
    ineng && match($0, /"node"[[:space:]]*:[[:space:]]*"[^"]*"/) {
      line = substr($0, RSTART, RLENGTH)
      sub(/^"node"[[:space:]]*:[[:space:]]*"/, "", line)
      sub(/"$/, "", line)
      print line
      exit
    }
    ineng && /^[[:space:]]*}/ { ineng=0 }
  ' "$file" 2>/dev/null || true
}

extract_dotnet_deps() {
  local file="$1"
  grep -oE '<PackageReference[[:space:]]+Include="[^"]+"' "$file" 2>/dev/null \
    | sed -E 's/.*Include="([^"]+)"/\1/' || true
}

extract_dotnet_version_signal() {
  local file="$1"
  grep -oE '<TargetFramework>[^<]+</TargetFramework>' "$file" 2>/dev/null \
    | head -1 | sed -E 's/<[^>]+>//g' || true
}

extract_maven_deps() {
  local file="$1"
  awk '
    /<dependency>/ { indep=1; next }
    /<\/dependency>/ { indep=0; next }
    indep && /<artifactId>/ {
      line=$0
      gsub(/<[^>]*>/, "", line)
      gsub(/^[[:space:]]+/, "", line)
      gsub(/[[:space:]]+$/, "", line)
      print line
    }
  ' "$file" 2>/dev/null || true
}

extract_go_deps() {
  local file="$1"
  awk '
    /^require[[:space:]]*\(/ { inreq=1; next }
    inreq && /^\)/ { inreq=0; next }
    inreq {
      line=$0
      gsub(/^[[:space:]]+/, "", line)
      n=split(line, parts, /[[:space:]]+/)
      if (n >= 1 && parts[1] != "") print parts[1]
      next
    }
    /^require[[:space:]]+[^\(]/ {
      line=$0
      sub(/^require[[:space:]]+/, "", line)
      n=split(line, parts, /[[:space:]]+/)
      if (n >= 1) print parts[1]
    }
  ' "$file" 2>/dev/null || true
}

extract_go_version_signal() {
  local file="$1"
  grep -E '^go[[:space:]]+[0-9]' "$file" 2>/dev/null | head -1 | awk '{print $2}' || true
}

extract_rust_deps() {
  local file="$1"
  awk '
    /^\[dependencies\]/ { indeps=1; next }
    /^\[/ { indeps=0 }
    indeps && /^[A-Za-z0-9_-]+[[:space:]]*=/ {
      line=$0
      sub(/[[:space:]]*=.*/, "", line)
      gsub(/[[:space:]]/, "", line)
      if (line != "") print line
    }
  ' "$file" 2>/dev/null || true
}

extract_rust_version_signal() {
  local file="$1"
  grep -E '^edition[[:space:]]*=' "$file" 2>/dev/null | head -1 \
    | sed -E 's/^edition[[:space:]]*=[[:space:]]*"?([^"]*)"?[[:space:]]*$/\1/' || true
}

extract_requirements_deps() {
  local file="$1"
  grep -vE '^[[:space:]]*(#|$)' "$file" 2>/dev/null || true
}

extract_pyproject_deps() {
  local file="$1"
  # Try Poetry-style [tool.poetry.dependencies] section first.
  local poetry_deps
  poetry_deps="$(awk '
    /^\[tool\.poetry\.dependencies\]/ { indeps=1; next }
    /^\[/ { indeps=0 }
    indeps && /^[A-Za-z0-9_.-]+[[:space:]]*=/ {
      line=$0
      sub(/[[:space:]]*=.*/, "", line)
      gsub(/[[:space:]]/, "", line)
      if (line != "" && line != "python") print line
    }
  ' "$file" 2>/dev/null || true)"

  if [ -n "$poetry_deps" ]; then
    printf '%s\n' "$poetry_deps"
    return 0
  fi

  # Fall back to PEP 621 `dependencies = [...]` array.
  awk '
    /^dependencies[[:space:]]*=[[:space:]]*\[/ { inarr=1 }
    inarr {
      line=$0
      while (match(line, /"[^"]+"/)) {
        print substr(line, RSTART+1, RLENGTH-2)
        line = substr(line, RSTART+RLENGTH)
      }
      if (line ~ /\]/) inarr=0
    }
  ' "$file" 2>/dev/null || true
}

extract_pyproject_version_signal() {
  local file="$1"
  grep -E '^requires-python[[:space:]]*=' "$file" 2>/dev/null | head -1 \
    | sed -E 's/^requires-python[[:space:]]*=[[:space:]]*"?([^"]*)"?[[:space:]]*$/\1/' || true
}

extract_delphi_deps() {
  local file="$1"
  grep -oE '<DCCReference[[:space:]]+Include="[^"]+"' "$file" 2>/dev/null \
    | sed -E 's/.*Include="([^"]+)"/\1/' || true
}

# ─── Manifest entry construction ──────────────────────────────────────────────

# Usage: process_manifest <project_root> <rel_path> <type>
# Prints one JSON manifest object (single line) to stdout.
process_manifest() {
  local project_root="$1" rel="$2" type="$3"
  local full="$project_root/$rel"
  local content=""
  if [ -f "$full" ]; then
    content="$(cat "$full" 2>/dev/null || true)"
  fi

  local deps="" version_signal=""
  case "$type" in
    node)
      deps="$(extract_node_deps "$full")"
      version_signal="$(extract_node_version_signal "$full")"
      ;;
    dotnet)
      deps="$(extract_dotnet_deps "$full")"
      version_signal="$(extract_dotnet_version_signal "$full")"
      ;;
    maven)
      deps="$(extract_maven_deps "$full")"
      ;;
    go)
      deps="$(extract_go_deps "$full")"
      version_signal="$(extract_go_version_signal "$full")"
      ;;
    rust)
      deps="$(extract_rust_deps "$full")"
      version_signal="$(extract_rust_version_signal "$full")"
      ;;
    python)
      case "${rel##*/}" in
        requirements.txt) deps="$(extract_requirements_deps "$full")" ;;
        pyproject.toml)
          deps="$(extract_pyproject_deps "$full")"
          version_signal="$(extract_pyproject_version_signal "$full")"
          ;;
      esac
      ;;
    delphi)
      deps="$(extract_delphi_deps "$full")"
      ;;
    make) ;; # no dependency convention; deps stays empty, version_signal null
  esac

  local deps_json
  deps_json="$(printf '%s\n' "$deps" | json_array_from_lines)"

  local vs_json
  if [ -z "$version_signal" ]; then
    vs_json="null"
  else
    vs_json="\"$(json_escape "$version_signal")\""
  fi

  printf '{"path": "%s", "type": "%s", "content": "%s", "dependencies": [%s], "version_signal": %s}\n' \
    "$(json_escape "$rel")" "$(json_escape "$type")" "$(json_escape "$content")" "$deps_json" "$vs_json"
}

# Find every scoped file matching any of the given glob patterns and append
# one manifest JSON line per match to <out_file>.
# Usage: gather_manifests <out_file> <scoped_files_file> <project_root> <type> <pattern> [pattern...]
gather_manifests() {
  local out_file="$1" files_file="$2" project_root="$3" type="$4"
  shift 4
  local pattern rel
  for pattern in "$@"; do
    while IFS= read -r rel; do
      [ -z "$rel" ] && continue
      process_manifest "$project_root" "$rel" "$type" >> "$out_file"
    done < <(match_files_by_name "$files_file" "$pattern")
  done
}

# ─── Subcommand: collect ──────────────────────────────────────────────────────

cmd_collect() {
  local specclaw_dir="$1"
  local target_path="${2:-.}"

  [ -d "$specclaw_dir" ] || die "specclaw directory not found: $specclaw_dir"

  local specclaw_dir_abs project_root
  specclaw_dir_abs="$(cd "$specclaw_dir" && pwd)"
  project_root="$(cd "$specclaw_dir_abs/.." && pwd)"

  # Resolve [path] relative to PROJECT_ROOT (matches design.md's pseudocode:
  # SCOPE_DIR="$(cd "$PROJECT_ROOT/$TARGET_PATH" && pwd)").
  local scope_dir
  [ -d "$project_root/$target_path" ] || die "path does not exist: $target_path"
  scope_dir="$(cd "$project_root/$target_path" && pwd)"

  # Must resolve under PROJECT_ROOT.
  case "$scope_dir" in
    "$project_root"|"$project_root"/*) ;;
    *) die "path resolves outside the project root: $target_path" ;;
  esac

  # Must not be the specclaw dir itself, nor nested inside it — that's
  # specclaw's own state, not application code.
  case "$scope_dir" in
    "$specclaw_dir_abs") die "path may not be the specclaw directory itself: $target_path" ;;
    "$specclaw_dir_abs"/*) die "path may not be nested inside the specclaw directory: $target_path" ;;
  esac

  local rel_scope="${scope_dir#"$project_root"}"
  rel_scope="${rel_scope#/}"
  local display_path="${rel_scope:-.}"

  local tmp_all tmp_scoped
  tmp_all="$(mktemp)"
  tmp_scoped="$(mktemp)"

  # 1. Enumerate files (mirrors specclaw-discover-context's git/find fallback).
  if git -C "$project_root" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    git -C "$project_root" ls-files -z 2>/dev/null | tr '\0' '\n' > "$tmp_all"
  else
    (
      cd "$project_root" || exit 0
      find . \( -name .git -o -name node_modules -o -name .specclaw -o -name vendor -o -name dist -o -name build \) -prune \
        -o -type f -print 2>/dev/null | sed 's|^\./||'
    ) > "$tmp_all"
  fi

  # Scope to [path] by prefix, and always exclude .specclaw's own state plus
  # vendored/generated directories (node_modules, vendor, dist, build) —
  # applied uniformly regardless of enumeration method. The find fallback
  # prunes these at traversal time, but `git ls-files` does not (a project can
  # legitimately commit a vendor/ or node_modules/ directory), so the same
  # exclusion is re-applied here as a post-filter for both paths — otherwise
  # vendored third-party code would pollute LOC/top-level-dirs/manifests,
  # defeating the point of characterizing the analyzed project's own code.
  while IFS= read -r f; do
    [ -z "$f" ] && continue
    case "$f" in
      .specclaw|.specclaw/*) continue ;;
      node_modules/*|*/node_modules/*) continue ;;
      vendor/*|*/vendor/*) continue ;;
      dist/*|*/dist/*) continue ;;
      build/*|*/build/*) continue ;;
    esac
    if [ -z "$rel_scope" ]; then
      printf '%s\n' "$f" >> "$tmp_scoped"
    else
      case "$f" in
        "$rel_scope"|"$rel_scope"/*) printf '%s\n' "$f" >> "$tmp_scoped" ;;
      esac
    fi
  done < "$tmp_all"

  # 2. Top-two-level directory summary (same transform /specclaw:plan uses).
  local top_level_dirs=""
  if [ -s "$tmp_scoped" ]; then
    top_level_dirs="$(cut -d/ -f1-2 "$tmp_scoped" | sort -u || true)"
  fi
  local top_level_dirs_json
  top_level_dirs_json="$(printf '%s\n' "$top_level_dirs" | json_array_from_lines)"

  # 3. Manifest detection + best-effort dependency/version extraction.
  local manifests_tmp
  manifests_tmp="$(mktemp)"

  gather_manifests "$manifests_tmp" "$tmp_scoped" "$project_root" node "package.json"
  gather_manifests "$manifests_tmp" "$tmp_scoped" "$project_root" dotnet "*.csproj" "*.sln"
  gather_manifests "$manifests_tmp" "$tmp_scoped" "$project_root" maven "pom.xml"
  gather_manifests "$manifests_tmp" "$tmp_scoped" "$project_root" go "go.mod"
  gather_manifests "$manifests_tmp" "$tmp_scoped" "$project_root" rust "Cargo.toml"
  gather_manifests "$manifests_tmp" "$tmp_scoped" "$project_root" python "requirements.txt" "pyproject.toml"
  gather_manifests "$manifests_tmp" "$tmp_scoped" "$project_root" delphi "*.dpr" "*.dproj"
  gather_manifests "$manifests_tmp" "$tmp_scoped" "$project_root" make "Makefile"

  local manifests_json="" first_manifest=true
  if [ -s "$manifests_tmp" ]; then
    while IFS= read -r line; do
      [ -z "$line" ] && continue
      if $first_manifest; then first_manifest=false; else manifests_json="${manifests_json},"; fi
      manifests_json="${manifests_json}
    ${line}"
    done < "$manifests_tmp"
  fi

  # 4. LOC per file extension — one wc -l pass over the scoped file list,
  # grouped by extension.
  local loc_raw="" loc_by_ext=""
  if [ -s "$tmp_scoped" ]; then
    loc_raw="$(
      while IFS= read -r f; do
        printf '%s\0' "$project_root/$f"
      done < "$tmp_scoped" \
        | xargs -0 wc -l 2>/dev/null \
        | grep -v ' total$' || true
    )"
  fi
  if [ -n "$loc_raw" ]; then
    loc_by_ext="$(printf '%s\n' "$loc_raw" | awk '
      {
        count = $1
        $1 = ""
        sub(/^[[:space:]]+/, "")
        path = $0
        n = split(path, parts, "/")
        base = parts[n]
        if (index(base, ".") > 0) {
          m = split(base, bparts, ".")
          ext = bparts[m]
        } else {
          ext = "(none)"
        }
        sum[ext] += count
      }
      END {
        for (e in sum) printf "%s\t%d\n", e, sum[e]
      }
    ' 2>/dev/null | sort || true)"
  fi
  local loc_json
  loc_json="$(printf '%s\n' "$loc_by_ext" | json_object_from_kv_lines)"

  # 5. Test-location detection — deduplicated directories, not individual files.
  local test_locations_tmp
  test_locations_tmp="$(mktemp)"
  while IFS= read -r f; do
    [ -z "$f" ] && continue
    local dirpart="${f%/*}"
    local matched_dir=""
    if [ "$dirpart" != "$f" ]; then
      # Has a directory part — check each ancestor segment (never the
      # filename itself) for a test-convention directory name.
      local remaining="$dirpart" path_acc="" seg
      while [ -n "$remaining" ]; do
        seg="${remaining%%/*}"
        if [ "$seg" = "$remaining" ]; then
          remaining=""
        else
          remaining="${remaining#*/}"
        fi
        if [ -n "$path_acc" ]; then path_acc="$path_acc/$seg"; else path_acc="$seg"; fi
        case "$seg" in
          test|tests|spec|__tests__)
            matched_dir="$path_acc"
            break
            ;;
        esac
      done
    fi
    if [ -n "$matched_dir" ]; then
      printf '%s\n' "$matched_dir" >> "$test_locations_tmp"
      continue
    fi
    local base="${f##*/}"
    case "$base" in
      *_test.*|*.test.*|*.spec.*)
        local dir="$dirpart"
        [ "$dir" = "$f" ] && dir="."
        printf '%s\n' "$dir" >> "$test_locations_tmp"
        ;;
    esac
  done < "$tmp_scoped"
  local test_locations=""
  if [ -s "$test_locations_tmp" ]; then
    test_locations="$(sort -u "$test_locations_tmp")"
  fi
  local test_locations_json
  test_locations_json="$(printf '%s\n' "$test_locations" | json_array_from_lines)"

  # 6. Discovered project docs — shell out exactly as specclaw-build-context does.
  local discovered_docs=""
  if [ -f "$SCRIPT_DIR/specclaw-discover-context" ]; then
    discovered_docs="$(bash "$SCRIPT_DIR/specclaw-discover-context" "$specclaw_dir_abs" emit 2>/dev/null || true)"
  fi

  rm -f "$tmp_all" "$tmp_scoped" "$manifests_tmp" "$test_locations_tmp"

  # 7. Assemble and emit.
  local output
  output=$(cat <<ENDJSON
{
  "path": "$(json_escape "$display_path")",
  "project_root": "$(json_escape "$project_root")",
  "top_level_dirs": [${top_level_dirs_json}
  ],
  "manifests": [${manifests_json}
  ],
  "loc_by_extension": {${loc_json}
  },
  "test_locations": [${test_locations_json}
  ],
  "discovered_docs": "$(json_escape "$discovered_docs")"
}
ENDJSON
)

  if command -v jq &>/dev/null; then
    if printf '%s' "$output" | jq . >/dev/null 2>&1; then
      printf '%s\n' "$output"
    else
      warn "JSON validation failed, outputting best-effort"
      printf '%s\n' "$output"
    fi
  else
    printf '%s\n' "$output"
  fi
}

# ─── Main ─────────────────────────────────────────────────────────────────────

case "${1:-}" in
  -h|--help)
    usage
    exit 0
    ;;
  collect)
    [ $# -ge 2 ] || die "Usage: specclaw-analyze-codebase collect <specclaw_dir> [path]"
    cmd_collect "$2" "${3:-.}"
    ;;
  "")
    usage
    exit 1
    ;;
  *)
    die "Unknown subcommand: $1. Run specclaw-analyze-codebase --help for usage."
    ;;
esac
